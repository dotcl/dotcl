<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AspNetLispDemo</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- project-core: the DotCL.Runtime package's ProjectCore targets walk
         AspNetLispDemo.asd's :depends-on, compile main.lisp into
         AspNetLispDemo.fasl, and write a manifest. The runtime only needs
         DotclHost.Initialize + LoadFromManifest. -->
    <DotclProjectAsd>$(MSBuildProjectDirectory)/AspNetLispDemo.asd</DotclProjectAsd>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="main.lisp" />
    <None Remove="AspNetLispDemo.asd" />
  </ItemGroup>

  <ItemGroup>
    <!-- A published version, deliberately not bumped every release: this sample
         demonstrates the shipping flow (PackageReference + project-core), not
         the latest runtime. It builds against whatever it pins here. -->
    <PackageReference Include="DotCL.Runtime" Version="0.1.26" />
  </ItemGroup>

</Project>
