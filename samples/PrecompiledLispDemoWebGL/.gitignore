# Generated plugins (staged by prepare-plugins.sh)
/Assets/Plugins/DotCL.Runtime.dll
/Assets/Plugins/dotclcore.dll
/Assets/Plugins/appfasl.dll
/Assets/Plugins/*.dll.meta
# Scene generated by the build script
/Assets/DemoScene.unity
/Assets/DemoScene.unity.meta

# Unity build + caches
/Build/
/Library/
/Temp/
/Obj/
/Logs/
/UserSettings/
build.log

# Unity auto-generated project settings (we keep only ProjectVersion.txt +
# the minimal hand-authored set; let the editor regenerate the rest on import)
/ProjectSettings/*
!/ProjectSettings/ProjectVersion.txt
