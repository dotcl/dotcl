<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The point of this sample: the host keeps running while handlers.lisp
         is edited on disk. Every save is re-loaded into the live image, and
         the next call uses the new definition. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\runtime\DotCL.Runtime.csproj" />
  </ItemGroup>

</Project>
