<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PluginHost.Abstractions\PluginHost.Abstractions.csproj" />
    <!-- Built first, not referenced: each is copied to plugins/<Name>/ below. -->
    <Plugin Include="..\CSharpPlugin\CSharpPlugin.csproj;..\LispPlugin\LispPlugin.csproj;..\WordStatsPlugin\WordStatsPlugin.csproj" />
    <ProjectReference Include="@(Plugin)" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="CopyPlugins" AfterTargets="Build">
    <MSBuild Projects="@(Plugin)" Targets="GetTargetPath" RemoveProperties="TargetFramework;RuntimeIdentifier">
      <Output TaskParameter="TargetOutputs" ItemName="_PluginTarget" />
    </MSBuild>
    <ItemGroup>
      <_PluginFile Include="%(_PluginTarget.RootDir)%(_PluginTarget.Directory)*.dll"
                   Plugin="%(_PluginTarget.Filename)" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginFile)" DestinationFolder="$(OutDir)plugins/%(_PluginFile.Plugin)/"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
