<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotcl</ToolCommandName>
    <PackageId>dotcl</PackageId>
    <!-- <Version> comes from runtime/Directory.Build.props (single source of truth). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Description>Common Lisp on .NET — compiles CL to CIL and runs via .NET JIT</Description>
    <Authors>SANO Masatoshi</Authors>
    <Copyright>Copyright © 2026 SANO Masatoshi</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dotcl/dotcl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dotcl/dotcl.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>lisp;common-lisp;repl;programming-language;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64;android-arm64;android-x64;any</RuntimeIdentifiers>
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- No C# debug symbols in Release. The runtime never reads its own pdb at
         run time — dotcl's Lisp-level backtraces and frame source come from the
         .fasl's own PDB, not runtime.pdb / DotCL.Runtime.pdb — so shipping them
         in the distributed tool is ~0.6 MB of dead weight. Scoped to Release so
         Debug builds keep full pdbs and local C# debugging is unaffected; only
         the pack (which builds Release) drops them. DotCL.Runtime.csproj carries
         the matching setting so the referenced library's pdb is dropped too. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <!-- dotcl-app packaging hook: pack this apphost as another app's tool nupkg (e.g.
       roswell) via a few -p:Dotcl* properties, without leaking global properties into
       DotCL.Runtime.csproj (a bare -p:PackageId does, causing "Ambiguous project name").
       Default (all unset) = the plain `dotcl` tool pack, unchanged.
         DotclToolPackageId / DotclToolCommandName — rename the produced tool.
         DotclToolNoAndroid=true — drop the android RIDs. A ;-list RID override cannot be
           passed on the command line (bare ; -> MSB1006; %3B -> NETSDK1083 single-RID),
           so the desktop+any list is written here as a literal, gated by a boolean flag.
           dotcl's own release.yml uses this to keep android deferred. -->
  <PropertyGroup>
    <PackageId Condition="'$(DotclToolPackageId)' != ''">$(DotclToolPackageId)</PackageId>
    <ToolCommandName Condition="'$(DotclToolCommandName)' != ''">$(DotclToolCommandName)</ToolCommandName>
    <RuntimeIdentifiers Condition="'$(DotclToolNoAndroid)' == 'true'">win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64;any</RuntimeIdentifiers>
    <!-- Empty unless DotclAppBundle is set. The item globs below reference THIS, never
         "$(DotclAppBundle)/**" directly: with the bundle unset the latter evaluates to
         the drive-root glob "/**" which MSBuild rejects at load with MSB5029 even under a
         false ItemGroup Condition. Empty here => Include="" => no items, no glob. -->
    <_DotclAppBundleGlob Condition="'$(DotclAppBundle)' != ''">$(DotclAppBundle)/**</_DotclAppBundleGlob>
  </PropertyGroup>

  <!-- dotcl-app bundle: extra files shipped alongside the tool (e.g. roswell's
       quicklisp-client + SharpCompress.dll). Packed into the any/ fallback and copied
       into every per-RID publish with subdirectory structure preserved — replacing the
       old post-pack nupkg unzip/inject surgery. Inert unless DotclAppBundle is set. -->
  <ItemGroup Condition="'$(_DotclAppBundleGlob)' != ''">
    <None Include="$(_DotclAppBundleGlob)" Pack="true" PackagePath="tools/net10.0/any/" />
    <Content Include="$(_DotclAppBundleGlob)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!-- Only the CLI sources — all runtime sources live in DotCL.Runtime.csproj -->
  <ItemGroup>
    <Compile Remove="**/*.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="PackRestamp.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="DotCL.Runtime.csproj" />
  </ItemGroup>

  <!-- Exclude per-RID R2R fasls (*-r2r-<rid>.fasl) from the framework-dependent
       (any-RID) tool package; they belong only in the per-RID tool packages
       (dotcl.<rid>). Empty when a RID is set, so per-RID packs keep their R2R.
       Without this the contrib/** glob bundled all 6 RIDs' R2R fasls (~35MB). -->
  <PropertyGroup>
    <FrameworkContribR2RExclude Condition="'$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'any'">contrib/**/*-r2r-*.fasl</FrameworkContribR2RExclude>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="dotcl.core" Condition="Exists('dotcl.core')">
      <Pack>true</Pack>
      <PackagePath>tools/net10.0/any/</PackagePath>
    </None>
    <!-- Pack=false: these Content items exist to copy core+contrib into the
         build/publish output (so the per-RID tool payload under
         tools/net10.0/<rid>/ carries them, and the dev runner finds them next
         to runtime.dll). They must NOT also be packed as content/ and
         contentFiles/: this is a DotnetTool package (consumed via tools/), the
         SDK/PackageReference payload lives in the separate DotCL.Runtime
         package's dotclassets/, so a content/contentFiles copy here is a third
         redundant portable payload nothing reads (~14 MB each). -->
    <Content Include="dotcl.core" Condition="Exists('dotcl.core')" Pack="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <None Include="contrib/**" Exclude="$(FrameworkContribR2RExclude)" Condition="Exists('contrib')">
      <Pack>true</Pack>
      <PackagePath>tools/net10.0/any/contrib/</PackagePath>
    </None>
    <Content Include="contrib/**" Exclude="$(FrameworkContribR2RExclude)" Condition="Exists('contrib')" Pack="false">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- save-application :executable t hook -->
  <ItemGroup Condition="'$(DotclUserFasl)' != ''">
    <EmbeddedResource Include="$(DotclUserFasl)" LogicalName="dotcl.user.fasl" />
  </ItemGroup>

  <!-- derive InformationalVersion from git describe -->
  <Target Name="SetGitCommitVersion" BeforeTargets="GetAssemblyVersion;BeforeBuild">
    <Exec Command="git describe --tags --long --abbrev=7 --dirty --match v*"
          ConsoleToMsBuild="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDesc" />
    </Exec>
    <Exec Command="git rev-parse --short=7 HEAD"
          ConsoleToMsBuild="true"
          IgnoreExitCode="true"
          Condition="'$(_GitDesc)' == '' Or !$(_GitDesc.StartsWith('v'))">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitFallbackSha" />
    </Exec>
    <PropertyGroup>
      <_GitFallbackSha Condition="'$(_GitFallbackSha)' == ''">unknown</_GitFallbackSha>
      <_GitDesc Condition="'$(_GitDesc)' == '' Or !$(_GitDesc.StartsWith('v'))">v0.0.0-0-g$(_GitFallbackSha)</_GitDesc>
      <_DescNoV>$(_GitDesc.Substring(1))</_DescNoV>
      <_HasDirty Condition="$(_DescNoV.EndsWith('-dirty'))">true</_HasDirty>
      <_HasDirty Condition="!$(_DescNoV.EndsWith('-dirty'))">false</_HasDirty>
      <_DescNoDirty Condition="'$(_HasDirty)' == 'true'">$(_DescNoV.Substring(0, $([MSBuild]::Subtract($(_DescNoV.Length), 6))))</_DescNoDirty>
      <_DescNoDirty Condition="'$(_HasDirty)' == 'false'">$(_DescNoV)</_DescNoDirty>
      <_LastDashG>$(_DescNoDirty.LastIndexOf('-g'))</_LastDashG>
      <_Sha>$(_DescNoDirty.Substring($([MSBuild]::Add($(_LastDashG), 2))))</_Sha>
      <_BeforeSha>$(_DescNoDirty.Substring(0, $(_LastDashG)))</_BeforeSha>
      <_LastDash>$(_BeforeSha.LastIndexOf('-'))</_LastDash>
      <_Count>$(_BeforeSha.Substring($([MSBuild]::Add($(_LastDash), 1))))</_Count>
      <_Tag>$(_BeforeSha.Substring(0, $(_LastDash)))</_Tag>
      <_DirtySuffix Condition="'$(_HasDirty)' == 'true'">.dirty</_DirtySuffix>
      <_DirtySuffix Condition="'$(_HasDirty)' == 'false'"></_DirtySuffix>
      <InformationalVersion Condition="'$(_Count)' == '0' And '$(_HasDirty)' == 'false'">$(_Tag)</InformationalVersion>
      <InformationalVersion Condition="'$(_Count)' != '0' Or '$(_HasDirty)' == 'true'">$(_Tag)+$(_Count).g$(_Sha)$(_DirtySuffix)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <!-- overwrite IL-only FASLs with R2R versions after publish -->
  <Target Name="ReplaceFaslsWithR2R"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != ''">
    <Copy SourceFiles="dotcl-r2r-$(RuntimeIdentifier).core"
          DestinationFiles="$(PublishDir)dotcl.core"
          OverwriteReadOnlyFiles="true"
          Condition="Exists('dotcl-r2r-$(RuntimeIdentifier).core')" />
    <Copy SourceFiles="asdf-r2r-$(RuntimeIdentifier).fasl"
          DestinationFiles="$(PublishDir)contrib/asdf/asdf.fasl"
          OverwriteReadOnlyFiles="true"
          Condition="Exists('asdf-r2r-$(RuntimeIdentifier).fasl')" />
  </Target>

</Project>
