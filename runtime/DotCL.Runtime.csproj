<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- net10.0 = full dev runtime (compiler/emitter). net8.0 = embeddable runtime
         for broader reach incl. AOT (NativeAOT/IL2CPP) and Unity's CoreCLR backend;
         the FASL emitter (PersistedAssemblyBuilder, .NET 9+) is #if'd out there, so
         the net8.0 build runs precompiled .fasl but cannot compile-file. -->
    <!-- netstandard2.0 = emit-free runtime (no System.Reflection.Emit): runs
         precompiled .fasl and (eventually) interprets dynamic code, for the widest
         reach incl. Unity/IL2CPP. The emit/JIT path (Emitter/*, compile-file, eval-
         via-compile, runtime define-class) is gated behind the DOTCL_EMIT constant. -->
    <TargetFrameworks>net10.0;net8.0;netstandard2.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- ns2.0 defaults to C# 7.3; force latest so only real BCL-API gaps surface. -->
    <LangVersion>latest</LangVersion>
    <!-- No debug symbols in Release: this library ships inside the dotcl tool
         packages (via the runtime exe's publish) and the DotCL.Runtime NuGet,
         neither of which needs its C# pdb (dotcl reads the .fasl PDB, not this).
         Scoped to Release so Debug keeps pdbs for local C# debugging. Matches
         runtime.csproj so the referenced pdb is not regenerated during the pack. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <!-- DotclEmit: is the Reflection.Emit-based JIT/compiler available? Decided once
       here; both the DOTCL_EMIT constant below and the emit-only source exclusions
       further down read it, so the two can never disagree.

       Off where the platform forbids generating code at run time:
         - netstandard2.0 — System.Reflection.Emit is not in the API surface
         - browser-wasm   — the API is present but the runtime rejects it
       Keyed off the RID (and a browser TFM) rather than the framework alone,
       because a wasm build is net10.0, not netstandard2.0: gating on the framework
       would have defined DOTCL_EMIT for it and produced a build whose compiler
       cannot run.

       DotclNoEmit=true forces it off for any target. That is how the emit-free
       runtime gets built — and therefore run and tested — on an ordinary desktop
       framework, instead of only as a netstandard2.0 library that also drags in an
       older BCL. It isolates "no emit" from everything else that differs. -->
  <PropertyGroup>
    <DotclEmit>true</DotclEmit>
    <DotclEmit Condition="'$(TargetFramework)' == 'netstandard2.0'
                          Or $(RuntimeIdentifier.StartsWith('browser'))
                          Or $(TargetFramework.Contains('browser'))
                          Or '$(DotclNoEmit)' == 'true'">false</DotclEmit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DotclEmit)' == 'true'">
    <DefineConstants>$(DefineConstants);DOTCL_EMIT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>

    <PackageId>DotCL.Runtime</PackageId>
    <!-- <Version> comes from runtime/Directory.Build.props (single source of truth). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Description>Common Lisp on .NET — embeddable runtime library</Description>
    <Authors>SANO Masatoshi</Authors>
    <Copyright>Copyright © 2026 SANO Masatoshi</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dotcl/dotcl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dotcl/dotcl.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>lisp;common-lisp;dotnet;embeddable</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64;android-arm64;android-x64;any</RuntimeIdentifiers>
    <!-- Building for the browser narrows this to browser-wasm alone. With the wasm
         workload present the SDK resolves a Mono runtime pack for every declared
         RID, and Microsoft.NETCore.App.Runtime.Mono.win-x64 (and the other desktop
         ones) does not exist — restore fails before anything is compiled. The list
         above is what the desktop packages ship; a wasm build needs none of it. -->
    <RuntimeIdentifiers Condition="$(RuntimeIdentifier.StartsWith('browser'))">browser-wasm</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <!-- dotcl.core bundled as a content file so consuming projects get it
         copied to their output directory automatically (FindCore picks it up
         via AppContext.BaseDirectory). Generated by `make compile-core-fasl`
         or `make pack` before dotnet pack is invoked. -->
    <!-- Ship dotcl.core + contrib as plain package assets (under dotclassets/, a
         non-special folder) and inject them into consumer build output via the
         build/buildTransitive targets below. contentFiles+copyToOutput is unreliable
         on plain `dotnet build`, so it's done with explicit copy items.
         *.cs/*.dll excluded so Roslyn-backed contribs don't bloat the embeddable lib. -->
    <!-- One item per file: pack to dotclassets/ AND copy to this project's own build
         output. (A separate Content item for the same file made Pack=false bleed across
         and dropped it from the package.) -->
    <None Include="dotcl.core" Condition="Exists('dotcl.core')" Pack="true" PackagePath="dotclassets/">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- *-r2r-<rid>.fasl are per-RID native precompiled fasls; they belong only in
         the per-RID tool packages (dotcl.<rid>), not in this framework-dependent
         library package. Without this exclude the contrib/** glob bundled all 6 RIDs'
         R2R fasls (~35MB), tripling the package. -->
    <None Include="contrib/**/*" Exclude="contrib/**/*.cs;contrib/**/*.dll;contrib/**/*-r2r-*.fasl"
          Condition="Exists('contrib')" Pack="true" PackagePath="dotclassets/contrib/" />
    <None Include="build/DotCL.Runtime.targets" Pack="true" PackagePath="build/" />
    <None Include="build/DotCL.Runtime.targets" Pack="true" PackagePath="buildTransitive/" />
    <!-- .props, not .targets, because NuGet imports it before the consumer's own
         project body: DotclAssetsDir is there to be used by an ItemGroup they
         write, and a property that only exists at the bottom cannot be. -->
    <None Include="build/DotCL.Runtime.props" Pack="true" PackagePath="build/" />
    <None Include="build/DotCL.Runtime.props" Pack="true" PackagePath="buildTransitive/" />
    <!-- Project-core build: the targets that drive the in-process tasks. The task
         assembly itself (tasks/DotCL.Build.Tasks.dll) is built and added to the
         package by the _PackProjectCoreTask target below, which ERRORS if the build
         didn't produce it — so the package can never silently ship without the task.
         A previous release (0.1.12) shipped without it: the old item was guarded by
         Condition=Exists, so when the task hadn't been built at pack time it was
         dropped silently, and consumers using it as a build task hit MSB4036 (#44). -->
    <None Include="build/DotCL.Runtime.ProjectCore.targets" Pack="true" PackagePath="build/" />
    <None Include="build/DotCL.Runtime.ProjectCore.targets" Pack="true" PackagePath="buildTransitive/" />
    <!-- The task assembly. Unconditional (no Condition=Exists): _PackProjectCoreTask
         below builds it before pack copies files; if that build fails to produce it,
         pack errors on the missing file instead of silently dropping it (#44). -->
    <None Include="build-tasks/bin/$(Configuration)/net10.0/DotCL.Build.Tasks.dll"
          Pack="true" PackagePath="tasks/" />
  </ItemGroup>

  <!-- Build the in-process project-core MSBuild task and pack it under tasks/.
       Runs before pack collects files. The task ProjectReferences this library, so
       it can only be built after this project — hence a pack-time MSBuild call here
       rather than a ProjectReference. Fails loudly if the DLL is missing instead of
       silently shipping a package whose targets reference a non-existent task. -->
  <Target Name="_PackProjectCoreTask" BeforeTargets="GenerateNuspec">
    <MSBuild Projects="$(MSBuildThisFileDirectory)build-tasks/DotCL.Build.Tasks.csproj"
             Properties="Configuration=$(Configuration)" Targets="Restore" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)build-tasks/DotCL.Build.Tasks.csproj"
             Properties="Configuration=$(Configuration)" Targets="Build" />
    <PropertyGroup>
      <_DotclTaskDll>$(MSBuildThisFileDirectory)build-tasks/bin/$(Configuration)/net10.0/DotCL.Build.Tasks.dll</_DotclTaskDll>
    </PropertyGroup>
    <Error Condition="!Exists('$(_DotclTaskDll)')"
           Text="Project-core MSBuild task not found at $(_DotclTaskDll) after building build-tasks. The package would ship without tasks/DotCL.Build.Tasks.dll and break for build-task consumers (#44)." />
  </Target>

  <!-- Exclude Program.cs — entry point lives in the dotcl tool project -->
  <ItemGroup>
    <Compile Remove="Program.cs" />
    <!-- PackRestamp.cs is `dotcl pack` tooling (rewrites nupkgs on the packaging
         host). It belongs to the tool project alongside Program.cs, not in the
         runtime that ships to Unity/IL2CPP/WebGL. -->
    <Compile Remove="PackRestamp.cs" />
    <!-- build-tasks/ is a separate MSBuild-task assembly that lives under
         runtime/; keep its sources out of the runtime library's default glob. -->
    <Compile Remove="build-tasks/**/*.cs" />
    <!-- sdk/ is the DotCL.Sdk MSBuild-SDK packaging project (props/targets only,
         no runtime sources). Keep its obj/ generated .cs out of the default glob. -->
    <Compile Remove="sdk/**/*.cs" />
  </ItemGroup>

  <!-- contrib/ sources are separate assemblies (e.g. dotcl-jitdisasm needs Iced +
       /unsafe) shipped as package CONTENT, not compiled into the runtime. The
       release/pack flow copies contrib/ under runtime/, where the SDK default glob
       would otherwise sweep their .cs into this project and fail the pack
       (CS0246 'Iced' / CS0227 unsafe). Exclude them from Compile. -->
  <ItemGroup>
    <Compile Remove="contrib/**/*.cs" />
  </ItemGroup>

  <!-- Ensure generated file is always in @(Compile) even if it doesn't exist yet at
       item-evaluation time (the GenerateUnicodeCharNames target creates it before CoreCompile).
       Remove first to avoid duplicate with the SDK default glob when the file already exists. -->
  <ItemGroup>
    <Compile Remove="Generated/UnicodeCharNames.g.cs" />
    <Compile Include="Generated/UnicodeCharNames.g.cs" />
  </ItemGroup>

  <!-- DotclSta: can a single-threaded apartment be created? Decided once, like
       DotclEmit above, so the constant and the source exclusion cannot drift apart.
       Gates Runtime.Sta.cs — the STA thread and message loop behind
       dotnet:ui-invoke / ui-post — and, through DOTCL_NO_STA, the registration of
       those two functions in Startup.cs, which would otherwise name a type that is
       no longer compiled.

       Apartments are a COM concept, so this is Windows-only; the dependency is
       Thread.SetApartmentState, not any UI framework. System.Windows.Forms is never
       referenced here — the caller loads it and it is looked up reflectively.

       Off for any non-Windows RID, for a host that is not Windows, and for ns2.0.
       browser is listed explicitly: a wasm build is net10.0 and its RID is neither
       android/linux/osx, so on a Windows host none of the other clauses caught it
       and the STA support was being compiled into a browser build, which has
       neither apartments nor a message loop. -->
  <PropertyGroup>
    <DotclSta>true</DotclSta>
    <DotclSta Condition="$(RuntimeIdentifier.StartsWith('android'))
                              Or $(RuntimeIdentifier.StartsWith('linux'))
                              Or $(RuntimeIdentifier.StartsWith('osx'))
                              Or $(RuntimeIdentifier.StartsWith('browser'))
                              Or $(TargetFramework.Contains('browser'))
                              Or '$(OS)' != 'Windows_NT'
                              Or '$(TargetFramework)' == 'netstandard2.0'
                              Or '$(DotclNoSta)' == 'true'">false</DotclSta>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DotclSta)' != 'true'">
    <DefineConstants>$(DefineConstants);DOTCL_NO_STA</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(DotclSta)' != 'true'">
    <Compile Remove="Runtime.Sta.cs" />
  </ItemGroup>

  <!-- Survive a trimmed consumer. A core / FASL is IL loaded at run time, so the
       trimmer cannot see that it calls into this assembly and removes whatever the
       host does not reach statically. See ILLink.Descriptors.xml. -->
  <PropertyGroup>
    <DotclPreserveForTrimming Condition="'$(DotclPreserveForTrimming)' == ''">true</DotclPreserveForTrimming>
  </PropertyGroup>
  <ItemGroup Condition="'$(DotclPreserveForTrimming)' == 'true'">
    <EmbeddedResource Include="ILLink.Descriptors.xml">
      <LogicalName>ILLink.Descriptors.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Emit-free (netstandard2.0): exclude the purely Reflection.Emit-based sources.
       FaslAssembler (compile-file), CompilerEnv (assembler env), IlDisasm (disasm)
       have no non-emit callers. CilAssembler is split: CilAssembler.cs keeps the
       function registry / constant pool / runtime-codegen guards (used everywhere,
       emit-free) and stays; CilAssembler.Emit.cs holds the ILGenerator body and is
       removed here. compile-file / save-application in Runtime.Misc.cs are gated by
       #if DOTCL_EMIT. -->
  <ItemGroup Condition="'$(DotclEmit)' != 'true'">
    <Compile Remove="Emitter/FaslAssembler.cs" />
    <Compile Remove="Emitter/CompilerEnv.cs" />
    <Compile Remove="Emitter/IlDisasm.cs" />
    <Compile Remove="Emitter/CilAssembler.Emit.cs" />
    <!-- Runtime .NET class generation (AssemblyBuilder/TypeBuilder) — emit-only;
         dotnet:define-class throws on this target (guarded in Runtime.DotNet.cs). -->
    <Compile Remove="Emitter/DynamicClassBuilder.cs" />
    <!-- Dynamic native FFI (DynamicMethod + calli) — emit-only. -->
    <Compile Remove="Runtime.FFI.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../runtime.docgen/runtime.docgen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- DotclNoJson: build a JSON-free runtime — drops dotnet:require (NuGet load)
       and its only dependency, System.Text.Json. Used for targets whose BCL lacks
       System.Text.Json and that can't load NuGet at run time anyway (Unity IL2CPP/
       WebGL): build with -p:DotclNoJson=true. Off by default. -->
  <PropertyGroup Condition="'$(DotclNoJson)' == 'true'">
    <DefineConstants>$(DefineConstants);DOTCL_NO_JSON</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(DotclNoJson)' == 'true'">
    <Compile Remove="Runtime.NuGet.cs" />
  </ItemGroup>

  <!-- System.Text.Json ships in-box on net5.0+, but ns2.0 needs the NuGet package
       (used by Runtime.NuGet.cs for package-manifest parsing). Omitted for the
       JSON-free build. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' And '$(DotclNoJson)' != 'true'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- ns2.0 lacks in-box Span<T> and ValueTask, which the runtime uses directly
       (Stream.cs, Runtime.DotNet.cs). The plain ns2.0 build got them transitively
       via System.Text.Json; the JSON-free build drops that, so reference them
       explicitly for all ns2.0 builds. Both are pure-IL and IL2CPP/WebGL-safe. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
  </ItemGroup>

  <!-- Auto-generate UnicodeCharNames.g.cs if missing.
       Runs only when the output file does not exist (Condition on the target).
       Downloads UnicodeData.txt on first use, then generates the C# source. -->
  <Target Name="GenerateUnicodeCharNames"
          BeforeTargets="BeforeCompile"
          Condition="!Exists('$(MSBuildThisFileDirectory)Generated/UnicodeCharNames.g.cs')">
    <PropertyGroup>
      <_GenUtilsProj>$(MSBuildThisFileDirectory)../scripts/GenUtils/GenUtils.csproj</_GenUtilsProj>
      <_UnicodeDataTxt>$(MSBuildThisFileDirectory)../scripts/UnicodeData.txt</_UnicodeDataTxt>
      <_GenOutPath>$(MSBuildThisFileDirectory)Generated/UnicodeCharNames.g.cs</_GenOutPath>
    </PropertyGroup>
    <MakeDir Directories="$(MSBuildThisFileDirectory)Generated" />
    <Exec Command="dotnet run --project &quot;$(_GenUtilsProj)&quot; -- download https://unicode.org/Public/UCD/latest/ucd/UnicodeData.txt &quot;$(_UnicodeDataTxt)&quot;"
          Condition="!Exists('$(_UnicodeDataTxt)')" />
    <Exec Command="dotnet run --project &quot;$(_GenUtilsProj)&quot; -- char-names &quot;$(_UnicodeDataTxt)&quot; &quot;$(_GenOutPath)&quot;" />
  </Target>

  <Target Name="SetGitCommitVersion" BeforeTargets="GetAssemblyVersion;BeforeBuild">
    <Exec Command="git describe --tags --long --abbrev=7 --dirty --match v*"
          ConsoleToMsBuild="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDesc" />
    </Exec>
    <Exec Command="git rev-parse --short=7 HEAD"
          ConsoleToMsBuild="true"
          IgnoreExitCode="true"
          Condition="'$(_GitDesc)' == '' Or !$(_GitDesc.StartsWith('v'))">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitFallbackSha" />
    </Exec>
    <PropertyGroup>
      <_GitFallbackSha Condition="'$(_GitFallbackSha)' == ''">unknown</_GitFallbackSha>
      <_GitDesc Condition="'$(_GitDesc)' == '' Or !$(_GitDesc.StartsWith('v'))">v0.0.0-0-g$(_GitFallbackSha)</_GitDesc>
      <_DescNoV>$(_GitDesc.Substring(1))</_DescNoV>
      <_HasDirty Condition="$(_DescNoV.EndsWith('-dirty'))">true</_HasDirty>
      <_HasDirty Condition="!$(_DescNoV.EndsWith('-dirty'))">false</_HasDirty>
      <_DescNoDirty Condition="'$(_HasDirty)' == 'true'">$(_DescNoV.Substring(0, $([MSBuild]::Subtract($(_DescNoV.Length), 6))))</_DescNoDirty>
      <_DescNoDirty Condition="'$(_HasDirty)' == 'false'">$(_DescNoV)</_DescNoDirty>
      <_LastDashG>$(_DescNoDirty.LastIndexOf('-g'))</_LastDashG>
      <_Sha>$(_DescNoDirty.Substring($([MSBuild]::Add($(_LastDashG), 2))))</_Sha>
      <_BeforeSha>$(_DescNoDirty.Substring(0, $(_LastDashG)))</_BeforeSha>
      <_LastDash>$(_BeforeSha.LastIndexOf('-'))</_LastDash>
      <_Count>$(_BeforeSha.Substring($([MSBuild]::Add($(_LastDash), 1))))</_Count>
      <_Tag>$(_BeforeSha.Substring(0, $(_LastDash)))</_Tag>
      <_DirtySuffix Condition="'$(_HasDirty)' == 'true'">.dirty</_DirtySuffix>
      <_DirtySuffix Condition="'$(_HasDirty)' == 'false'"></_DirtySuffix>
      <InformationalVersion Condition="'$(_Count)' == '0' And '$(_HasDirty)' == 'false'">$(_Tag)</InformationalVersion>
      <InformationalVersion Condition="'$(_Count)' != '0' Or '$(_HasDirty)' == 'true'">$(_Tag)+$(_Count).g$(_Sha)$(_DirtySuffix)</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>
