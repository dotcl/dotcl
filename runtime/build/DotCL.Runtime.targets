<Project>
  <!-- Injected into PackageReference consumers (direct and, via buildTransitive,
       transitive). Copies the packaged dotcl.core and contrib tree into the
       consumer's build output so DotclHost.FindCore() finds dotcl.core at
       AppContext.BaseDirectory and (require :dotnet-class) etc. resolve from
       AppContext.BaseDirectory/contrib.
       contentFiles/copyToOutput is unreliable on plain `dotnet build`, so we
       inject explicit copy-to-output items here instead. -->
  <PropertyGroup>
    <!-- DotclAssetsDir comes from DotCL.Runtime.props, which NuGet imports ahead
         of the consumer's project body so an ItemGroup there can use it. The
         fallback is for anyone importing this file directly, without the props
         beside it. -->
    <DotclAssetsDir Condition="'$(DotclAssetsDir)' == ''">$(MSBuildThisFileDirectory)../dotclassets/</DotclAssetsDir>
    <_DotCLRuntimeAssets>$(DotclAssetsDir)</_DotCLRuntimeAssets>
    <!-- On Android, output-dir <None> items do NOT land in the APK; assets must be
         <AndroidAsset> (APK assets/) and read at runtime via the asset manager,
         since AppContext.BaseDirectory is not a real fs path holding the core.
         Detect the android TargetPlatformIdentifier to switch packaging. -->
    <_DotCLIsAndroid>false</_DotCLIsAndroid>
    <_DotCLIsAndroid Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'android'">true</_DotCLIsAndroid>
  </PropertyGroup>

  <!-- Desktop / non-android: copy next to the app; FindCore() opens it by path. -->
  <ItemGroup Condition="'$(_DotCLIsAndroid)' != 'true' And Exists('$(_DotCLRuntimeAssets)dotcl.core')">
    <None Include="$(_DotCLRuntimeAssets)dotcl.core">
      <Link>dotcl.core</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(_DotCLIsAndroid)' != 'true' And Exists('$(_DotCLRuntimeAssets)contrib')">
    <None Include="$(_DotCLRuntimeAssets)contrib/**/*">
      <Link>contrib/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <!-- Android: embed into the APK as AndroidAsset (assets/dotcl/...). At runtime
       DotclHost.FindCore() extracts them from the asset manager to a writable dir
       and opens by path. The "dotcl/" asset subdir keeps them namespaced. -->
  <ItemGroup Condition="'$(_DotCLIsAndroid)' == 'true' And Exists('$(_DotCLRuntimeAssets)dotcl.core')">
    <AndroidAsset Include="$(_DotCLRuntimeAssets)dotcl.core">
      <Link>Assets/dotcl/dotcl.core</Link>
    </AndroidAsset>
  </ItemGroup>

  <ItemGroup Condition="'$(_DotCLIsAndroid)' == 'true' And Exists('$(_DotCLRuntimeAssets)contrib')">
    <AndroidAsset Include="$(_DotCLRuntimeAssets)contrib/**/*">
      <Link>Assets/dotcl/contrib/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AndroidAsset>
  </ItemGroup>

  <!-- Project-core build: compile a consumer's <DotclProjectAsd> to a fasl
       at build time via the in-process MSBuild tasks. Only active when the
       consumer sets DotclProjectAsd; otherwise a no-op. Shipped alongside this
       file in build/ and buildTransitive/. -->
  <Import Project="$(MSBuildThisFileDirectory)DotCL.Runtime.ProjectCore.targets"
          Condition="Exists('$(MSBuildThisFileDirectory)DotCL.Runtime.ProjectCore.targets')" />
</Project>
