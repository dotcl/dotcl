(defrow "ldiff" "same list" "none" "-" 0 (ldiff *la-lf* *la-lf*))
(defrow "ldiff" "up to last" "none" "-" 224 (ldiff *la-lf* (last *la-lf*)))
(defrow "ldiff" "up to nil" "none" "-" 256 (ldiff *la-lf* nil))
(defrow "tailp" "same list" "none" "-" 0 (tailp *la-lf* *la-lf*))
(defrow "tailp" "cdr" "none" "-" 0 (tailp (cdr *la-lf*) *la-lf*))
(defrow "tailp" "nil" "none" "-" 0 (tailp nil *la-lf*))
(defrow "list-length" "8 fixnums" "none" "-" 0 (list-length *la-lf*))
(defrow "last" "8 fixnums" "none" "-" 0 (last *la-lf*))
(defrow "last" "8 fixnums n=2" "none" "-" 0 (last *la-lf* 2))
(defrow "butlast" "8 fixnums n=0" "none" "-" 256 (butlast *la-lf* 0))
(defrow "butlast" "8 fixnums n=2" "none" "-" 192 (butlast *la-lf* 2))
(defrow "nthcdr" "8 fixnums n=0" "none" "-" 0 (nthcdr 0 *la-lf*))
(defrow "nthcdr" "8 fixnums n=4" "none" "-" 0 (nthcdr 4 *la-lf*))
(defrow "endp" "8 fixnums" "none" "-" 0 (endp *la-lf*))


(defun %la-baseline ()
  (min-allocated-bytes
   (lambda () (dotimes (i *la-it*) (setq *la-sink* nil)))
   5))

(defun %la-check (rows)
  (let ((base (%la-baseline)) (bad nil))
    (dolist (row rows (nreverse bad))
      (destructuring-bind (function input variant position floor fn) row
        (funcall fn)
        (let ((got (- (min-allocated-bytes fn 5) base)))
          (when (> got (+ (* *la-it* floor) 16))
            (push (list function input variant position got (* *la-it* floor)) bad)))))))

(deftest-compiled-only list-allocation.budget
  (%la-check *la-rows*)
  nil)
