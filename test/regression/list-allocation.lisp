(defrow "append" "2 x 8 fixnums" "none" "-" 256 (append *la-lf* *la-lf2*))
(defrow "append" "3 x 8 fixnums" "none" "-" 512 (append *la-lf* *la-lf2* *la-lf*))
(defrow "append" "4 x 8 fixnums" "none" "-" 768 (append *la-lf* *la-lf2* *la-lf* *la-lf2*))
(defrow "append" "8 fixnums + atom" "none" "-" 256 (append *la-lf* 7))
(defrow "list*" "8 fixnums" "none" "-" 224 (list* 1 2 3 4 5 6 7 8))
(defrow "list*" "1 + 8 fixnums" "none" "-" 32 (list* 1 *la-lf*))
(defrow "list*" "4 fixnums" "none" "-" 96 (list* 1 2 3 4))
(defrow "revappend" "8 fixnums" "none" "-" 256 (revappend *la-lf* nil))
(defrow "revappend" "8 fixnums + tail" "none" "-" 256 (revappend *la-lf* *la-lf2*))
(defrow "revappend" "tree" "none" "-" 96 (revappend *la-tree* nil))
(defrow "copy-list" "8 fixnums" "none" "-" 256 (copy-list *la-lf*))
(defrow "copy-list" "tree" "none" "-" 96 (copy-list *la-tree*))
(defrow "copy-tree" "8 fixnums" "none" "-" 256 (copy-tree *la-lf*))
(defrow "copy-tree" "tree" "none" "-" (* 32 (%la-cons-count *la-tree*)) (copy-tree *la-tree*))
(defrow "copy-tree" "pairs" "none" "-" (* 32 (%la-cons-count *la-lpairs*)) (copy-tree *la-lpairs*))

