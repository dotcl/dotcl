;;; The classic list functions stay at or below the cons floor of their result.


(defparameter *la-it* 1000)
(defparameter *la-lf* (list 1 2 3 4 5 6 7 8))
(defparameter *la-lf2* (list 1 2 3 4 5 6 7 8))
(defparameter *la-ls* (list 'a 'b 'c 'd 'e 'f 'g 'h))
(defparameter *la-lpairs* (list (cons 'a 1) (cons 'b 2) (cons 'c 3) (cons 'd 4)
                             (cons 'e 5) (cons 'f 6) (cons 'g 7) (cons 'h 8)))
(defparameter *la-lstr* (list "aa" "bb" "cc" "dd" "ee" "ff" "gg" "hh"))
(defparameter *la-spairs* (list (cons "aa" 1) (cons "bb" 2) (cons "cc" 3) (cons "dd" 4)
                             (cons "ee" 5) (cons "ff" 6) (cons "gg" 7) (cons "hh" 8)))
(defparameter *la-keyed-pairs* (list (cons '(a) 1) (cons '(b) 2) (cons '(c) 3) (cons '(d) 4)
                                  (cons '(e) 5) (cons '(f) 6) (cons '(g) 7) (cons '(h) 8)))
(defparameter *la-rv-pairs* (list (cons 'a '(a)) (cons 'b '(b)) (cons 'c '(c)) (cons 'd '(d))
                               (cons 'e '(e)) (cons 'f '(f)) (cons 'g '(g)) (cons 'h '(h))))
(defparameter *la-plist* (list :a 1 :b 2 :c 3 :d 4))
(defparameter *la-tree* (list (list 1 2) (list 3 (list 4 5)) (list 6 7 8)))
(defparameter *la-sublis-hit* (list (cons 1 'x)))
(defparameter *la-sublis-miss* (list (cons 99 'x)))
(defparameter *la-sink* nil)
(defparameter *la-test-equal* #'equal)
(defparameter *la-zero-list* (list 0 2 3))
(defparameter *la-h-pair* (cons 'h 0))
(defparameter *la-z-pair* (cons 'z 0))
(defparameter *la-key-car* #'car)

(defun %la-never (x) (declare (ignore x)) nil)
(defun %la-always (x) (declare (ignore x)) t)
(defun %la-zero-fixnum-p (x) (and (numberp x) (zerop x)))

(defun %la-cons-count (tree)
  (if (consp tree)
      (+ 1 (%la-cons-count (car tree)) (%la-cons-count (cdr tree)))
      0))

(defvar *la-rows* nil)

(defmacro defrow (function input variant position floor form)
  (let ((name (gensym "ROW")))
    `(progn
       (defun ,name ()
         (let ((*la-sink* nil))
           (dotimes (i *la-it*) (setq *la-sink* ,form))
           *la-sink*))
       (push (list ,function ,input ,variant ,position ,floor #',name) *la-rows*))))

(defmacro defprow (function input variant position floor form)
  (let ((name (gensym "ROW")))
    `(progn
       (defun ,name ()
         (let ((*la-sink* nil) (place nil))
           (dotimes (i *la-it*)
             (setq place *la-lf2*)
             (setq *la-sink* ,form))
           *la-sink*))
       (push (list ,function ,input ,variant ,position ,floor #',name) *la-rows*))))

;;; MEMBER
(defrow "member" "fixnums" "none" "head" 0 (member 1 *la-lf*))
(defrow "member" "fixnums" "none" "end" 0 (member 8 *la-lf*))
(defrow "member" "fixnums" "none" "absent" 0 (member 99 *la-lf*))
(defrow "member" "symbols" "none" "head" 0 (member 'a *la-ls*))
(defrow "member" "symbols" "none" "end" 0 (member 'h *la-ls*))
(defrow "member" "fixnums" ":test eql" "head" 0 (member 1 *la-lf* :test #'eql))
(defrow "member" "fixnums" ":test eql" "end" 0 (member 8 *la-lf* :test #'eql))
(defrow "member" "fixnums" ":test equal" "head" 0 (member 1 *la-lf* :test #'equal))
(defrow "member" "symbols" ":test eq" "end" 0 (member 'h *la-ls* :test #'eq))
(defrow "member" "strings" ":test string=" "head" 0 (member "aa" *la-lstr* :test #'string=))
(defrow "member" "strings" ":test string=" "end" 0 (member "hh" *la-lstr* :test #'string=))
(defrow "member" "strings" ":test string=" "absent" 0 (member "zz" *la-lstr* :test #'string=))
(defrow "member" "pairs" ":key car" "head" 0 (member 'a *la-lpairs* :key #'car))
(defrow "member" "pairs" ":key car" "end" 0 (member 'h *la-lpairs* :key #'car))
(defrow "member" "pairs" ":key car" "absent" 0 (member 'z *la-lpairs* :key #'car))
(defrow "member" "fixnums" ":key identity" "end" 0 (member 8 *la-lf* :key #'identity))
(defrow "member" "fixnums" ":test eql :key identity" "end" 0 (member 8 *la-lf* :test #'eql :key #'identity))
(defrow "member" "fixnums" ":test-not eql" "head" 0 (member 99 *la-lf* :test-not #'eql))
(defrow "member" "fixnums" "variable :test equal" "head" 0 (member 1 *la-lf* :test *la-test-equal*))
(defrow "member-if" "fixnums" "none" "absent" 0 (member-if #'%la-never *la-lf*))
(defrow "member-if" "fixnums" "none" "head" 0 (member-if #'zerop *la-zero-list*))
(defrow "member-if" "pairs" ":key car" "absent" 0 (member-if #'%la-never *la-lpairs* :key #'car))

;;; ASSOC
(defrow "assoc" "pairs" "none" "head" 0 (assoc 'a *la-lpairs*))
(defrow "assoc" "pairs" "none" "end" 0 (assoc 'h *la-lpairs*))
(defrow "assoc" "pairs" "none" "absent" 0 (assoc 'z *la-lpairs*))
(defrow "assoc" "pairs" ":test eql" "head" 0 (assoc 'a *la-lpairs* :test #'eql))
(defrow "assoc" "pairs" ":test equal" "end" 0 (assoc 'h *la-lpairs* :test #'equal))
(defrow "assoc" "pairs" ":test eq" "head" 0 (assoc 'a *la-lpairs* :test #'eq))
(defrow "assoc" "string-pairs" ":test string=" "head" 0 (assoc "aa" *la-spairs* :test #'string=))
(defrow "assoc" "string-pairs" ":test string=" "end" 0 (assoc "hh" *la-spairs* :test #'string=))
(defrow "assoc" "string-pairs" ":test string=" "absent" 0 (assoc "zz" *la-spairs* :test #'string=))
(defrow "assoc" "keyed-pairs" ":key car" "head" 0 (assoc 'a *la-keyed-pairs* :key #'car))
(defrow "assoc" "keyed-pairs" ":key car" "end" 0 (assoc 'h *la-keyed-pairs* :key #'car))
(defrow "assoc" "keyed-pairs" ":key car" "absent" 0 (assoc 'z *la-keyed-pairs* :key #'car))
(defrow "assoc" "pairs" ":key identity" "end" 0 (assoc 'h *la-lpairs* :key #'identity))
(defrow "assoc" "pairs" ":test eql :key identity" "end" 0 (assoc 'h *la-lpairs* :test #'eql :key #'identity))
(defrow "assoc" "pairs" ":test-not eql" "head" 0 (assoc 'z *la-lpairs* :test-not #'eql))
(defrow "assoc" "pairs" "variable :test equal" "head" 0 (assoc 'a *la-lpairs* :test *la-test-equal*))
(defrow "assoc-if" "pairs" "none" "absent" 0 (assoc-if #'%la-never *la-lpairs*))
(defrow "assoc-if" "pairs" "none" "head" 0 (assoc-if #'%la-always *la-lpairs*))
(defrow "assoc-if" "keyed-pairs" ":key car" "absent" 0 (assoc-if #'%la-never *la-keyed-pairs* :key #'car))

;;; RASSOC
(defrow "rassoc" "pairs" "none" "head" 0 (rassoc 1 *la-lpairs*))
(defrow "rassoc" "pairs" "none" "end" 0 (rassoc 8 *la-lpairs*))
(defrow "rassoc" "pairs" "none" "absent" 0 (rassoc 99 *la-lpairs*))
(defrow "rassoc" "pairs" ":test eql" "end" 0 (rassoc 8 *la-lpairs* :test #'eql))
(defrow "rassoc" "rv-pairs" ":key car" "head" 0 (rassoc 'a *la-rv-pairs* :key #'car))
(defrow "rassoc" "pairs" ":test-not eql" "absent" 0 (rassoc 1 *la-lpairs* :test-not #'eql))
(defrow "rassoc-if" "pairs" "none" "absent" 0 (rassoc-if #'%la-never *la-lpairs*))
(defrow "rassoc-if" "rv-pairs" ":key car" "head" 0 (rassoc-if #'%la-always *la-rv-pairs* :key #'car))

;;; GETF
(defrow "getf" "plist" "none" "head" 0 (getf *la-plist* :a))
(defrow "getf" "plist" "none" "end" 0 (getf *la-plist* :d))
(defrow "getf" "plist" "none" "absent" 0 (getf *la-plist* :z))
(defrow "getf" "plist" "default" "absent" 0 (getf *la-plist* :z 0))

;;; ADJOIN and PUSHNEW
(defrow "adjoin" "fixnums" "none" "head" 0 (adjoin 1 *la-lf*))
(defrow "adjoin" "fixnums" "none" "end" 0 (adjoin 8 *la-lf*))
(defrow "adjoin" "fixnums" "none" "miss" 32 (adjoin 99 *la-lf*))
(defrow "adjoin" "fixnums" ":test eql" "head" 0 (adjoin 1 *la-lf* :test #'eql))
(defrow "adjoin" "fixnums" ":test equal" "miss" 32 (adjoin 99 *la-lf* :test #'equal))
(defrow "adjoin" "symbols" ":test eq" "end" 0 (adjoin 'h *la-ls* :test #'eq))
(defrow "adjoin" "strings" ":test string=" "end" 0 (adjoin "hh" *la-lstr* :test #'string=))
(defrow "adjoin" "strings" ":test string=" "miss" 32 (adjoin "zz" *la-lstr* :test #'string=))
(defrow "adjoin" "pairs" ":key car" "end" 0 (adjoin *la-h-pair* *la-lpairs* :key #'car))
(defrow "adjoin" "fixnums" ":key identity" "head" 0 (adjoin 1 *la-lf* :key #'identity))
(defrow "adjoin" "pairs" ":test eql :key car" "miss" 32 (adjoin *la-z-pair* *la-lpairs* :test #'eql :key #'car))
(defrow "adjoin" "fixnums" ":test-not eql" "head" 0 (adjoin 99 *la-lf* :test-not #'eql))
(defprow "pushnew" "fixnums" "none" "head" 0 (pushnew 1 place))
(defprow "pushnew" "fixnums" "none" "end" 0 (pushnew 8 place))
(defprow "pushnew" "fixnums" "none" "miss" 32 (pushnew 99 place))
(defprow "pushnew" "fixnums" ":test eql" "head" 0 (pushnew 1 place :test #'eql))
(defmacro defprowp (function input variant position floor form)
  (let ((name (gensym "ROW")))
    `(progn
       (defun ,name ()
         (let ((*la-sink* nil) (place nil))
           (dotimes (i *la-it*)
             (setq place *la-lpairs*)
             (setq *la-sink* ,form))
           *la-sink*))
       (push (list ,function ,input ,variant ,position ,floor #',name) *la-rows*))))
(defprowp "pushnew" "pairs" ":key car" "end" 0 (pushnew *la-h-pair* place :key #'car))
(defmacro defprows (function input variant position floor form)
  (let ((name (gensym "ROW")))
    `(progn
       (defun ,name ()
         (let ((*la-sink* nil) (place nil))
           (dotimes (i *la-it*)
             (setq place *la-lstr*)
             (setq *la-sink* ,form))
           *la-sink*))
       (push (list ,function ,input ,variant ,position ,floor #',name) *la-rows*))))
(defprows "pushnew" "strings" ":test string=" "miss" 32 (pushnew "zz" place :test #'string=))

