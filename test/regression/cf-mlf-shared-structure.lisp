;;; Objects shared in one constant stay one object after COMPILE-FILE and LOAD.
(defclass cmlfss-node ()
  ((x :initarg :x :accessor cmlfss-x) (y :initarg :y :accessor cmlfss-y)))
(defmethod make-load-form ((n cmlfss-node) &optional env)
  (make-load-form-saving-slots n :environment env))
(defclass cmlfss-form () ((v :initarg :v :accessor cmlfss-form-v)))
(defvar *cmlfss-extra* nil)
(defmethod make-load-form ((f cmlfss-form) &optional env)
  (declare (ignore f env))
  `(make-instance 'cmlfss-form :v ',(first *cmlfss-extra*)))
(defmacro cmlfss-lit (name) `',(symbol-value name))
(defun %cmlfss-fasl (name forms)
  (let* ((dir (regression-temp-dir))
         (src (merge-pathnames (format nil "~a.lisp" name) dir))
         (fasl (merge-pathnames (format nil "~a.fasl" name) dir)))
    (with-open-file (s src :direction :output :if-exists :supersede)
      (dolist (f forms) (prin1 f s) (terpri s)))
    (let ((*error-output* (make-broadcast-stream)))
      (compile-file src :output-file fasl))
    (load fasl) t))
(deftest-compiled-only cmlfss.shared-in-one-constant
  (let* ((l (list :shared 1 2))
         (b1 (make-instance 'cmlfss-node :x l :y 0))
         (b2 (make-instance 'cmlfss-node :x l :y 0)))
    (setf *cmlfss-obj* (list l b1) *cmlfss-two* (list b1 b2)
          *cmlfss-twice* (list b1 b1) *cmlfss-plain* (list 1 2 (vector 3 4)))
    (%cmlfss-fasl "cmlfss-shared"
                  '((defun cmlfss-obj () (cmlfss-lit *cmlfss-obj*))
                    (defun cmlfss-two () (cmlfss-lit *cmlfss-two*))
                    (defun cmlfss-twice () (cmlfss-lit *cmlfss-twice*))
                    (defun cmlfss-plain () (cmlfss-lit *cmlfss-plain*))))
    (let ((o1 (cmlfss-obj)) (o2 (cmlfss-two)) (o3 (cmlfss-twice)))
      (list (eq (first o1) (cmlfss-x (second o1)))
            (eq (cmlfss-x (first o2)) (cmlfss-x (second o2)))
            (eq (first o3) (second o3))
            (equalp (cmlfss-plain) (list 1 2 (vector 3 4)))
            (eq (cmlfss-plain) (cmlfss-plain)))))
  (t t t t t))
(deftest-compiled-only cmlfss.circular-with-instance
  (let* ((c (list :c 1))
         (b (progn (setf (cddr c) c) (make-instance 'cmlfss-node :x c :y 0))))
    (setf *cmlfss-circle* (list c b))
    (%cmlfss-fasl "cmlfss-circle"
                  '((defun cmlfss-circle () (cmlfss-lit *cmlfss-circle*))))
    (let* ((o (cmlfss-circle)) (c2 (first o)))
      (list (eq c2 (cmlfss-x (second o))) (eq c2 (cddr c2)))))
  (t t))
(deftest-compiled-only cmlfss.creation-form-sharing
  (let ((l (list :form 1 2)))
    (setf *cmlfss-extra* (list l)
          *cmlfss-form-obj* (list l (make-instance 'cmlfss-form :v 0)))
    (%cmlfss-fasl "cmlfss-form"
                  '((defun cmlfss-form-obj () (cmlfss-lit *cmlfss-form-obj*))))
    (setf *cmlfss-extra* nil)
    (let ((o (cmlfss-form-obj)))
      (list (eq (first o) (cmlfss-form-v (second o))))))
  (t))
(deftest-compiled-only cmlfss.between-top-level-constants
  (let* ((l (list :cross 1 2))
         (b1 (make-instance 'cmlfss-node :x l :y 0))
         (b2 (make-instance 'cmlfss-node :x l :y 0)))
    (setf *cmlfss-cross-a* (list l b1) *cmlfss-cross-b* (list b2))
    (%cmlfss-fasl "cmlfss-cross"
                  '((defun cmlfss-cross-a () (cmlfss-lit *cmlfss-cross-a*))
                    (defun cmlfss-cross-b () (cmlfss-lit *cmlfss-cross-b*))))
    (let ((a (cmlfss-cross-a)) (b (cmlfss-cross-b)))
      (list (eq (first a) (cmlfss-x (second a)))
            (eq (first a) (cmlfss-x (first b))))))
  (t t))
