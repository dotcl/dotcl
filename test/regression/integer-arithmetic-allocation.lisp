    (list "%ia-minusp-u" (lambda () (%ia-minusp-u *ia-m*)))
    (list "%ia-coerce-double-d" (lambda () (%ia-coerce-double-d *ia-e*)))
    (list "%ia-floor-double-d" (lambda () (%ia-floor-double-d *ia-d*)))
    (list "%ia-floor-double-u" (lambda () (%ia-floor-double-u *ia-d*)))
  ))

(deftest-compiled-only integer-arithmetic-allocation.zero
  (%ia-failures *ia-rows*)
  nil)


