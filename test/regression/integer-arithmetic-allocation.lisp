(defparameter *ia-edges*
  (list 0 1 -1 2 -2 3 -3 4 8 16 32 64 128 256 1024 32768 65535 65536
        most-positive-fixnum most-negative-fixnum))

(defparameter *ia-fixnums*
  (append *ia-edges* (loop repeat 180 collect (- (random 2000001) 1000000))))

(defun %ia-nth* (list n) (nth (mod n (length list)) list))

(defun %ia-double (n) (coerce n 'double-float))

(deftest integer-arithmetic-allocation.gcd-lcm-3-values
  (loop for i below (length *ia-fixnums*)
        for a = (nth i *ia-fixnums*)
        for b = (%ia-nth* *ia-fixnums* (1+ i))
        for c = (%ia-nth* *ia-fixnums* (+ i 2))
        always (and (= (%ia-gcd3-fast a b c) (%ia-gcd3-generic a b c))
                    (= (%ia-gcd3-fast-u a b c) (%ia-gcd3-generic a b c))
                    (= (%ia-lcm3-fast a b c) (%ia-lcm3-generic a b c))
                    (= (%ia-lcm3-fast-u a b c) (%ia-lcm3-generic a b c))))
  t)

(deftest integer-arithmetic-allocation.expt-double-values
  (loop for i below (length *ia-fixnums*)
        for d = (%ia-double (nth i *ia-fixnums*))
        for p = (%ia-nth* '(0 -1 1 -5 5 2 3 -3 10 -10 63) i)
        always (let ((x (%ia-expt-fast d p)) (y (%ia-expt-generic d p)))
                 (if (and (floatp x) (floatp y)) (= x y) (equal x y))))
  t)

(deftest integer-arithmetic-allocation.ffloor-2-values
  (loop for i below (length *ia-fixnums*)
        for a = (%ia-double (nth i *ia-fixnums*))
        for b = (%ia-double (%ia-nth* *ia-fixnums* (1+ i)))
        always (or (= b 0.0d0)
                   (= (%ia-ffloor2-fast a b) (%ia-ffloor2-generic a b))))
  t)

(deftest integer-arithmetic-allocation.ffloor-mvb-values
  (loop for i below (length *ia-fixnums*)
        for a = (%ia-double (nth i *ia-fixnums*))
        for b = (%ia-double (%ia-nth* *ia-fixnums* (1+ i)))
        always (and (equal (%ia-ffloor1-mvb-fast a) (%ia-ffloor1-mvb-generic a))
                    (equal (%ia-fceiling1-mvb-fast a) (%ia-fceiling1-mvb-generic a))
                    (equal (%ia-ftruncate1-mvb-fast a) (%ia-ftruncate1-mvb-generic a))
                    (equal (%ia-fround1-mvb-fast a) (%ia-fround1-mvb-generic a))
                    (or (= b 0.0d0)
                        (and (equal (%ia-ffloor2-mvb-fast a b) (%ia-ffloor2-mvb-generic a b))
                             (equal (%ia-fceiling2-mvb-fast a b) (%ia-fceiling2-mvb-generic a b))
                             (equal (%ia-ftruncate2-mvb-fast a b) (%ia-ftruncate2-mvb-generic a b))
                             (equal (%ia-fround2-mvb-fast a b) (%ia-fround2-mvb-generic a b))))))
  t)

(deftest integer-arithmetic-allocation.ffloor-2-zero-divisor
  (list (handler-case (%ia-ffloor2-fast 1.5d0 0.0d0) (division-by-zero () t) (error () nil))
        (handler-case (%ia-ffloor2-generic 1.5d0 0.0d0) (division-by-zero () t) (error () nil)))
  (t t))

