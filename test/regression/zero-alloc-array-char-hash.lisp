;;; Element access, fill pointers, character tests and hash writes stay within budget.
;;; These are statements about emitted code, so every allocation test is compiled-only.

(defvar *zcah-n* 10000)

(defun %zcah-under (thunk budget)
  (funcall thunk)
  (< (min-allocated-bytes thunk 5) (* *zcah-n* (+ budget 16))))

(defun %zcah-under-pool (pool fn budget &rest extra)
  (apply fn (pop pool) extra)
  (< (min-allocated-bytes
      (lambda () (apply fn (pop pool) extra)) 5)
     (* *zcah-n* (+ budget 16))))

;;; --- element access ---

(defvar *zcah-df* (make-array 16 :element-type 'double-float :initial-element 1.5d0))
(defvar *zcah-fix* (make-array 16 :element-type 'fixnum :initial-element 7))
(defvar *zcah-u8* (make-array 16 :element-type '(unsigned-byte 8) :initial-element 3))
(defvar *zcah-u32* (make-array 16 :element-type '(unsigned-byte 32) :initial-element 3))
(defvar *zcah-bit* (make-array 16 :element-type 'bit :initial-element 1))
(defvar *zcah-char* (make-array 16 :element-type 'character :initial-element #\a))
(defvar *zcah-sv* (make-array 16 :initial-element 7))
(defvar *zcah-df2* (make-array '(4 4) :element-type 'double-float :initial-element 1.5d0))

(defmacro %zcah-def-int (name params decl form)
  (let ((acc (gensym "ACC")) (i (gensym "I")))
    `(defun ,name ,params
       ,@(when decl `((declare ,@decl)))
       (let ((,acc 0))
         (declare (fixnum ,acc))
         (dotimes (,i *zcah-n*)
           (setq ,acc (logand (+ ,acc (the fixnum ,form)) #xffffff)))
         ,acc))))

(defmacro %zcah-def-double (name params decl form)
  (let ((acc (gensym "ACC")) (i (gensym "I")))
    `(defun ,name ,params
       ,@(when decl `((declare ,@decl)))
       (let ((,acc 0d0))
         (declare (double-float ,acc))
         (dotimes (,i *zcah-n*)
           (incf ,acc (the double-float ,form)))
         ,acc))))

(defmacro %zcah-def-set (name params decl form)
  (let ((i (gensym "I")))
    `(defun ,name ,params
       ,@(when decl `((declare ,@decl)))
       (dotimes (,i *zcah-n*) ,form)
       v)))

(%zcah-def-double %zcah-aref-df (a i) ((type (simple-array double-float (*)) a) (fixnum i))
  (aref a i))
(%zcah-def-double %zcah-aref-df-u (a i) ((fixnum i)) (aref a i))
(%zcah-def-set %zcah-aref-set-df (a i v)
  ((type (simple-array double-float (*)) a) (fixnum i) (double-float v))
  (setf (aref a i) v))
(%zcah-def-set %zcah-aref-set-df-u (a i v) ((fixnum i) (double-float v))
  (setf (aref a i) v))

(%zcah-def-int %zcah-aref-fix (a i) ((type (simple-array fixnum (*)) a) (fixnum i))
  (aref a i))
(%zcah-def-int %zcah-aref-fix-u (a i) ((fixnum i)) (aref a i))
(%zcah-def-set %zcah-aref-set-fix (a i v) ((type (simple-array fixnum (*)) a) (fixnum i v))
  (setf (aref a i) v))
(%zcah-def-set %zcah-aref-set-fix-u (a i v) ((fixnum i v)) (setf (aref a i) v))

(%zcah-def-int %zcah-aref-u8 (a i) ((type (simple-array (unsigned-byte 8) (*)) a) (fixnum i))
  (aref a i))
(%zcah-def-int %zcah-aref-u8-u (a i) ((fixnum i)) (aref a i))
(%zcah-def-set %zcah-aref-set-u8 (a i v)
  ((type (simple-array (unsigned-byte 8) (*)) a) (fixnum i v)) (setf (aref a i) v))
(%zcah-def-set %zcah-aref-set-u8-u (a i v) ((fixnum i v)) (setf (aref a i) v))

(%zcah-def-int %zcah-aref-u32 (a i) ((type (simple-array (unsigned-byte 32) (*)) a) (fixnum i))
  (aref a i))
(%zcah-def-int %zcah-aref-u32-u (a i) ((fixnum i)) (aref a i))
(%zcah-def-set %zcah-aref-set-u32 (a i v)
  ((type (simple-array (unsigned-byte 32) (*)) a) (fixnum i v)) (setf (aref a i) v))
(%zcah-def-set %zcah-aref-set-u32-u (a i v) ((fixnum i v)) (setf (aref a i) v))

(%zcah-def-int %zcah-aref-bit (a i) ((type (simple-array bit (*)) a) (fixnum i)) (aref a i))
(%zcah-def-int %zcah-aref-bit-u (a i) ((fixnum i)) (aref a i))
(%zcah-def-set %zcah-aref-set-bit (a i v) ((type (simple-array bit (*)) a) (fixnum i v))
  (setf (aref a i) v))
(%zcah-def-set %zcah-aref-set-bit-u (a i v) ((fixnum i v)) (setf (aref a i) v))

(%zcah-def-int %zcah-aref-char (a i) ((type (simple-array character (*)) a) (fixnum i))
  (char-code (aref a i)))
(%zcah-def-int %zcah-aref-char-u (a i) ((fixnum i)) (char-code (aref a i)))
(%zcah-def-set %zcah-aref-set-char (a i v)
  ((type (simple-array character (*)) a) (fixnum i) (character v)) (setf (aref a i) v))
(%zcah-def-set %zcah-aref-set-char-u (a i v) ((fixnum i) (character v))
  (setf (aref a i) v))

(%zcah-def-int %zcah-aref-sv (a i) ((type simple-vector a) (fixnum i)) (aref a i))
(%zcah-def-int %zcah-aref-sv-u (a i) ((fixnum i)) (aref a i))
(%zcah-def-set %zcah-aref-set-sv (a i v) ((type simple-vector a) (fixnum i v))
  (setf (aref a i) v))
(%zcah-def-set %zcah-aref-set-sv-u (a i v) ((fixnum i v)) (setf (aref a i) v))

(%zcah-def-double %zcah-aref-df2 (a i j)
  ((type (simple-array double-float (* *)) a) (fixnum i j)) (aref a i j))
(%zcah-def-double %zcah-aref-df2-u (a i j) ((fixnum i j)) (aref a i j))
(defun %zcah-aref-set-df2 (a i j v)
  (declare (type (simple-array double-float (* *)) a) (fixnum i j) (double-float v))
  (dotimes (k *zcah-n*) (setf (aref a i j) v)) v)
(defun %zcah-aref-set-df2-u (a i j v)
  (declare (fixnum i j) (double-float v))
  (dotimes (k *zcah-n*) (setf (aref a i j) v)) v)

(%zcah-def-int %zcah-svref (a i) ((type simple-vector a) (fixnum i)) (svref a i))
(%zcah-def-int %zcah-svref-u (a i) ((fixnum i)) (svref a i))
(%zcah-def-set %zcah-svref-set (a i v) ((type simple-vector a) (fixnum i v))
  (setf (svref a i) v))
(%zcah-def-set %zcah-svref-set-u (a i v) ((fixnum i v)) (setf (svref a i) v))

(%zcah-def-int %zcah-bit (a i) ((type (simple-array bit (*)) a) (fixnum i)) (bit a i))
(%zcah-def-int %zcah-bit-u (a i) ((fixnum i)) (bit a i))
(%zcah-def-set %zcah-bit-set (a i v) ((type (simple-array bit (*)) a) (fixnum i v))
  (setf (bit a i) v))
(%zcah-def-set %zcah-bit-set-u (a i v) ((fixnum i v)) (setf (bit a i) v))

(%zcah-def-int %zcah-sbit (a i) ((type (simple-array bit (*)) a) (fixnum i)) (sbit a i))
(%zcah-def-int %zcah-sbit-u (a i) ((fixnum i)) (sbit a i))
(%zcah-def-set %zcah-sbit-set (a i v) ((type (simple-array bit (*)) a) (fixnum i v))
  (setf (sbit a i) v))
(%zcah-def-set %zcah-sbit-set-u (a i v) ((fixnum i v)) (setf (sbit a i) v))

;;; --- vectors and fill pointers ---

(defvar *zcah-v* (make-array 100 :adjustable t :fill-pointer 50 :initial-element 0))

(defun %zcah-vpush (v)
  (dotimes (k *zcah-n*)
    (vector-push 7 v)
    (setf (fill-pointer v) 50))
  v)
(defun %zcah-vpush-extend (v)
  (dotimes (k *zcah-n*)
    (vector-push-extend 7 v)
    (setf (fill-pointer v) 50))
  v)

(%zcah-def-int %zcah-fill-pointer (v) ((type vector v)) (fill-pointer v))
(%zcah-def-int %zcah-fill-pointer-u (v) () (fill-pointer v))
(defun %zcah-fill-pointer-set (v)
  (declare (type vector v))
  (dotimes (k *zcah-n*) (setf (fill-pointer v) 50)) v)
(defun %zcah-fill-pointer-set-u (v)
  (dotimes (k *zcah-n*) (setf (fill-pointer v) 50)) v)
(%zcah-def-int %zcah-array-dimension (a) ((type array a)) (array-dimension a 0))
(%zcah-def-int %zcah-array-dimension-u (a) () (array-dimension a 0))
(%zcah-def-int %zcah-array-total-size (a) ((type array a)) (array-total-size a))
(%zcah-def-int %zcah-array-total-size-u (a) () (array-total-size a))
(%zcah-def-int %zcah-length-fp (v) ((type vector v)) (length v))
(%zcah-def-int %zcah-length-fp-u (v) () (length v))

;;; --- characters ---

(defmacro %zcah-def-char (name params decl form)
  `(%zcah-def-int ,name ,params ,decl ,form))

(%zcah-def-char %zcah-char= (c d) ((character c d)) (if (char= c d) 1 0))
(%zcah-def-char %zcah-char=4 (c d e f) ((character c d e f)) (if (char= c d e f) 1 0))
(%zcah-def-char %zcah-char/= (c d) ((character c d)) (if (char/= c d) 1 0))
(%zcah-def-char %zcah-char< (c d) ((character c d)) (if (char< c d) 1 0))
(%zcah-def-char %zcah-char-equal (c d) ((character c d)) (if (char-equal c d) 1 0))
(%zcah-def-char %zcah-char-equal4 (c d e f) ((character c d e f))
  (if (char-equal c d e f) 1 0))
(%zcah-def-char %zcah-char-lessp (c d) ((character c d)) (if (char-lessp c d) 1 0))
(%zcah-def-char %zcah-char-code (c) ((character c)) (char-code c))
(%zcah-def-int %zcah-char-code-u (c) () (char-code c))
(%zcah-def-char %zcah-code-char (x) ((fixnum x)) (char-code (code-char x)))
(%zcah-def-char %zcah-digit-char-p (c) ((character c)) (if (digit-char-p c) 1 0))
(%zcah-def-char %zcah-alpha-char-p (c) ((character c)) (if (alpha-char-p c) 1 0))
(%zcah-def-char %zcah-upper-case-p (c) ((character c)) (if (upper-case-p c) 1 0))
(%zcah-def-char %zcah-char-upcase (c) ((character c)) (char-code (char-upcase c)))
(%zcah-def-char %zcah-char-int (c) ((character c)) (char-int c))

;;; --- hash writes ---

(defvar *zcah-symbols* (make-array *zcah-n*))
(dotimes (i *zcah-n*) (setf (svref *zcah-symbols* i) (make-symbol (format nil "HK~D" i))))
(defvar *zcah-keys* (make-array *zcah-n* :element-type 'fixnum))
(dotimes (i *zcah-n*) (setf (aref *zcah-keys* i) (+ 1000000 i)))
(defvar *zcah-sym* (make-symbol "OVERWRITE-KEY"))

(defun %zcah-hash-overwrite-fix (h key)
  (declare (type hash-table h) (fixnum key))
  (dotimes (k *zcah-n*) (setf (gethash key h) k)) key)
(defun %zcah-hash-overwrite-sym (h key)
  (declare (type hash-table h) (symbol key))
  (dotimes (k *zcah-n*) (setf (gethash key h) k)) key)
(defun %zcah-hash-insert-fix (h)
  (declare (type hash-table h))
  (dotimes (k *zcah-n*) (setf (gethash (+ 1000000 k) h) k)) h)
(defun %zcah-hash-insert-sym (h)
  (declare (type hash-table h))
  (dotimes (k *zcah-n*) (setf (gethash (svref *zcah-symbols* k) h) k)) h)
(defun %zcah-hash-remhash-fix (h keys)
  (declare (type hash-table h) (type (simple-array fixnum (*)) keys))
  (dotimes (k *zcah-n*) (remhash (aref keys k) h)) h)
(defun %zcah-hash-remhash-sym (h keys)
  (declare (type hash-table h) (type simple-vector keys))
  (dotimes (k *zcah-n*) (remhash (svref keys k) h)) h)
(defun %zcah-hash-clrhash (h)
  (declare (type hash-table h))
  (dotimes (k *zcah-n*) (clrhash h)) h)
(defun %zcah-hash-count (h)
  (declare (type hash-table h))
  (let ((s 0)) (declare (fixnum s))
    (dotimes (k *zcah-n*) (setq s (hash-table-count h))) s))
(defun %zcah-hash-incf (h key)
  (declare (type hash-table h) (fixnum key))
  (dotimes (k *zcah-n*) (incf (gethash key h 0)))
  (gethash key h))
(defun %zcah-hash-push (h key)
  (declare (type hash-table h) (fixnum key))
  (dotimes (k *zcah-n*) (push k (gethash key h)))
  (gethash key h))

(defun %zcah-pool (test)
  (loop repeat 6 collect (make-hash-table :test test :size *zcah-n*)))
(defun %zcah-remhash-pool (test)
  (loop repeat 6 collect
        (let ((h (make-hash-table :test test :size *zcah-n*)))
          (dotimes (k *zcah-n*) (setf (gethash (+ 1000000 k) h) k))
          h)))
(defun %zcah-remhash-sym-pool (test)
  (loop repeat 6 collect
        (let ((h (make-hash-table :test test :size *zcah-n*)))
          (dotimes (k *zcah-n*) (setf (gethash (svref *zcah-symbols* k) h) k))
          h)))

(defun %zcah-overwrite-check (test key budget)
  (let ((h (make-hash-table :test test)))
    (setf (gethash key h) 0)
    (%zcah-under (if (symbolp key)
                     (lambda () (%zcah-hash-overwrite-sym h key))
                     (lambda () (%zcah-hash-overwrite-fix h key)))
                 budget)))

(deftest-compiled-only zero-alloc-array-char-hash.arrays
  (every #'identity
         (list (%zcah-under (lambda () (%zcah-aref-df *zcah-df* 3)) 0)
               (%zcah-under (lambda () (%zcah-aref-df-u *zcah-df* 3)) 24)
               (%zcah-under (lambda () (%zcah-aref-set-df *zcah-df* 3 2.5d0)) 0)
               (%zcah-under (lambda () (%zcah-aref-set-df-u *zcah-df* 3 2.5d0)) 0)
               (%zcah-under (lambda () (%zcah-aref-fix *zcah-fix* 3)) 0)
               (%zcah-under (lambda () (%zcah-aref-fix-u *zcah-fix* 3)) 0)
               (%zcah-under (lambda () (%zcah-aref-set-fix *zcah-fix* 3 8)) 0)
               (%zcah-under (lambda () (%zcah-aref-set-fix-u *zcah-fix* 3 8)) 0)
               (%zcah-under (lambda () (%zcah-aref-u8 *zcah-u8* 3)) 0)
               (%zcah-under (lambda () (%zcah-aref-u8-u *zcah-u8* 3)) 0)
               (%zcah-under (lambda () (%zcah-aref-set-u8 *zcah-u8* 3 4)) 0)
               (%zcah-under (lambda () (%zcah-aref-set-u8-u *zcah-u8* 3 4)) 0)
               (%zcah-under (lambda () (%zcah-aref-u32 *zcah-u32* 3)) 0)
               (%zcah-under (lambda () (%zcah-aref-u32-u *zcah-u32* 3)) 0)
               (%zcah-under (lambda () (%zcah-aref-set-u32 *zcah-u32* 3 4)) 0)
               (%zcah-under (lambda () (%zcah-aref-set-u32-u *zcah-u32* 3 4)) 0)
               (%zcah-under (lambda () (%zcah-aref-bit *zcah-bit* 3)) 0)
               (%zcah-under (lambda () (%zcah-aref-bit-u *zcah-bit* 3)) 0)
               (%zcah-under (lambda () (%zcah-aref-set-bit *zcah-bit* 3 0)) 0)
               (%zcah-under (lambda () (%zcah-aref-set-bit-u *zcah-bit* 3 0)) 0)
               (%zcah-under (lambda () (%zcah-aref-char *zcah-char* 3)) 0)
               (%zcah-under (lambda () (%zcah-aref-char-u *zcah-char* 3)) 0)
               (%zcah-under (lambda () (%zcah-aref-set-char *zcah-char* 3 #\b)) 0)
               (%zcah-under (lambda () (%zcah-aref-set-char-u *zcah-char* 3 #\b)) 0)
               (%zcah-under (lambda () (%zcah-aref-sv *zcah-sv* 3)) 0)
               (%zcah-under (lambda () (%zcah-aref-sv-u *zcah-sv* 3)) 0)
               (%zcah-under (lambda () (%zcah-aref-set-sv *zcah-sv* 3 8)) 0)
               (%zcah-under (lambda () (%zcah-aref-set-sv-u *zcah-sv* 3 8)) 0)
               (%zcah-under (lambda () (%zcah-aref-df2 *zcah-df2* 1 2)) 0)
               (%zcah-under (lambda () (%zcah-aref-df2-u *zcah-df2* 1 2)) 24)
               (%zcah-under (lambda () (%zcah-aref-set-df2 *zcah-df2* 1 2 2.5d0)) 0)
               (%zcah-under (lambda () (%zcah-aref-set-df2-u *zcah-df2* 1 2 2.5d0)) 0)
               (%zcah-under (lambda () (%zcah-svref *zcah-sv* 3)) 0)
               (%zcah-under (lambda () (%zcah-svref-u *zcah-sv* 3)) 0)
               (%zcah-under (lambda () (%zcah-svref-set *zcah-sv* 3 8)) 0)
               (%zcah-under (lambda () (%zcah-svref-set-u *zcah-sv* 3 8)) 0)
               (%zcah-under (lambda () (%zcah-bit *zcah-bit* 3)) 0)
               (%zcah-under (lambda () (%zcah-bit-u *zcah-bit* 3)) 0)
               (%zcah-under (lambda () (%zcah-bit-set *zcah-bit* 3 0)) 0)
               (%zcah-under (lambda () (%zcah-bit-set-u *zcah-bit* 3 0)) 0)
               (%zcah-under (lambda () (%zcah-sbit *zcah-bit* 3)) 0)
               (%zcah-under (lambda () (%zcah-sbit-u *zcah-bit* 3)) 0)
               (%zcah-under (lambda () (%zcah-sbit-set *zcah-bit* 3 0)) 0)
               (%zcah-under (lambda () (%zcah-sbit-set-u *zcah-bit* 3 0)) 0)))
  t)

(deftest-compiled-only zero-alloc-array-char-hash.vectors
  (every #'identity
         (list (%zcah-under (lambda () (%zcah-vpush *zcah-v*)) 0)
               (%zcah-under (lambda () (%zcah-vpush-extend *zcah-v*)) 0)
               (%zcah-under (lambda () (%zcah-fill-pointer *zcah-v*)) 0)
               (%zcah-under (lambda () (%zcah-fill-pointer-u *zcah-v*)) 0)
               (%zcah-under (lambda () (%zcah-fill-pointer-set *zcah-v*)) 0)
               (%zcah-under (lambda () (%zcah-fill-pointer-set-u *zcah-v*)) 0)
               (%zcah-under (lambda () (%zcah-array-dimension *zcah-v*)) 0)
               (%zcah-under (lambda () (%zcah-array-dimension-u *zcah-v*)) 0)
               (%zcah-under (lambda () (%zcah-array-total-size *zcah-v*)) 0)
               (%zcah-under (lambda () (%zcah-array-total-size-u *zcah-v*)) 0)
               (%zcah-under (lambda () (%zcah-length-fp *zcah-v*)) 0)
               (%zcah-under (lambda () (%zcah-length-fp-u *zcah-v*)) 0)))
