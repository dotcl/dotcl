(deftest-compiled-only zero-alloc-array-char-hash.characters
  (every #'identity
         (append
          (loop for code in '(0 65 255 65535)
                for c = (code-char code)
                for d = (code-char (if (zerop code) 1 (1- code)))
                append (list (%zcah-under (lambda () (%zcah-char= c c)) 0)
                             (%zcah-under (lambda () (%zcah-char/= c d)) 0)
                             (%zcah-under (lambda () (%zcah-char< d c)) 0)
                             (%zcah-under (lambda () (%zcah-char-equal c c)) 0)
                             (%zcah-under (lambda () (%zcah-char-lessp d c)) 0)
                             (%zcah-under (lambda () (%zcah-char-code c)) 0)
                             (%zcah-under (lambda () (%zcah-code-char code)) 0)
                             (%zcah-under (lambda () (%zcah-digit-char-p c)) 0)
                             (%zcah-under (lambda () (%zcah-alpha-char-p c)) 0)
                             (%zcah-under (lambda () (%zcah-upper-case-p c)) 0)
                             (%zcah-under (lambda () (%zcah-char-upcase c)) 0)
                             (%zcah-under (lambda () (%zcah-char-int c)) 0)))
          (list (%zcah-under (lambda () (%zcah-char=4 #\a #\a #\a #\a)) 0)
                (%zcah-under (lambda () (%zcah-char-equal4 #\a #\A #\a #\A)) 0)
                (%zcah-under (lambda () (%zcah-char-code-u #\A)) 0))))
  t)

(deftest zero-alloc-array-char-hash.char-values
  (list (char-lessp #\a #\b)
        (char-lessp #\b #\a)
        (char-lessp #\a #\b #\c)
        (char= #\a #\a #\a #\a)
        (char= #\a #\a #\b #\a)
        (char-equal #\A #\a #\A #\a)
        (char-equal #\A #\a #\B #\a))
  (t nil t t nil t nil))

(deftest zero-alloc-array-char-hash.hash-values
  (let ((h (make-hash-table :test 'eql)))
    (setf (gethash 100000 h) 1)
    (setf (gethash 100000 h) 2)
    (let ((incf-value (incf (gethash 100000 h 0)))
          (count-before (hash-table-count h)))
      (remhash 100000 h)
      (list incf-value count-before (hash-table-count h)
            (gethash 100000 h :miss) (remhash 100000 h))))
  (3 1 0 :miss nil))

(deftest zero-alloc-array-char-hash.fixnum-index-after-clear
  (let ((h (make-hash-table :test 'eql)))
    (dotimes (i 100) (setf (gethash (+ 100000 i) h) i))
    (clrhash h)
    (setf (gethash 100000 h) :again)
    (list (hash-table-count h) (gethash 100000 h :miss)))
  (1 :again))

(deftest zero-alloc-array-char-hash.equalp-cross-type-remhash
  (let ((h (make-hash-table :test 'equalp)))
    (setf (gethash 1.0d0 h) :float)
    (list (remhash 1 h) (hash-table-count h) (gethash 1.0d0 h :miss)))
  (t 0 :miss))

(deftest zero-alloc-array-char-hash.array-dimension-ignores-fill-pointer
  (list (array-dimension *zcah-v* 0)
        (array-dimension *zcah-df2* 0)
        (array-dimension *zcah-df2* 1))
  (100 4 4))
