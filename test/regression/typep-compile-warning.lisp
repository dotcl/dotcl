    ))

(deftest typep-compile-warning.table-size
  (>= (length *tcw-valid*) 100)
  t)

(deftest-emitting-only typep-compile-warning.valid-specs-are-silent
  (progn
    (tcw-clear)
    (loop for spec in *tcw-valid*
          for msgs = (append (tcw-warnings (list 'typep 'x (list 'quote spec)))
                             (tcw-warnings (list 'the spec 'x))
                             (tcw-warnings (list 'typecase 'x (list spec 1) (list t 2))))
          when msgs collect (list spec msgs)))
  nil)

(deftest-emitting-only typep-compile-warning.invalid-specs-warn-once
  (progn
    (tcw-clear)
    (list (length (tcw-warnings '(typep x '(integer 1.5))))
          (length (tcw-warnings '(typep x '(integer 1.5))))
          (length (tcw-warnings '(typecase x ((mod 0) 1) (t 2))))
          (length (tcw-warnings '(the (cons 1 2) x)))
          (length (tcw-warnings '(check-type x (cons 1 2))))))
  (1 0 1 1 0))

(deftest-emitting-only typep-compile-warning.message-names-the-specifier
  (progn
    (tcw-clear)
    (let ((m (first (tcw-warnings '(typep x '(integer 1.5))))))
      (list (and (search "INTEGER 1.5" m) t)
            (find #\Newline m))))
  (t nil))

(deftest-emitting-only typep-compile-warning.not-judged
  (progn
    (tcw-clear)
    (list (tcw-warnings '(typep x '(or tcw-not-yet-defined (cons integer))))
          (tcw-warnings '(typep x '(and tcw-dt (cons integer))))
          (tcw-warnings '(typep x '(member a b)))
          (tcw-warnings '(typep x 'integer))))
  (nil nil nil nil))

;; The same specifier still signals when TYPEP runs, as before.
(deftest-emitting-only typep-compile-warning.run-time-unchanged
  (let ((f (handler-bind ((warning #'muffle-warning))
             (compile nil '(lambda (x) (typep x '(integer 1 2 3)))))))
    (handler-case (progn (funcall f 3) :no-error) (error () :error)))
  :error)

;; A warning makes COMPILE-FILE's failure-p true, a clean file does not.
(deftest-emitting-only typep-compile-warning.compile-file-failure-p
  (let* ((dir (regression-temp-dir))
         (bad (format nil "~Atcw-bad.lisp" dir))
         (good (format nil "~Atcw-good.lisp" dir)))
    (tcw-clear)
    (with-open-file (o bad :direction :output :if-exists :supersede)
      (format o "(defun tcw-bad-fn (x) (typep x '(integer 1.5 7)))~%"))
    (with-open-file (o good :direction :output :if-exists :supersede)
      (format o "(defun tcw-good-fn (x) (typep x '(integer 0 7)))~%"))
    (flet ((try (file)
             (handler-bind ((warning (lambda (w) (declare (ignore w)) nil)))
               (multiple-value-bind (out warn failure) (compile-file file)
                 (declare (ignore out))
                 (list (and warn t) (and failure t))))))
      (list (try bad) (try good))))
  ((t t) (nil nil)))
