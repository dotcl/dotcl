;;; A constant compound type specifier of the wrong shape is reported when the code
;;; is compiled, as a WARNING (so COMPILE-FILE's failure-p is true, as on SBCL).
;;; A valid specifier, a DEFTYPE name, and a name not yet defined are not judged.

(deftype tcw-dt () 'integer)

(defun tcw-clear ()
  (clrhash (symbol-value (find-symbol "*CHECKED-CONSTANT-TYPE-SPECS*" "DOTCL-INTERNAL"))))

(defun tcw-warnings (form)
  (let ((messages '()))
    (handler-bind ((warning (lambda (w)
                              (push (princ-to-string w) messages)
                              (muffle-warning w))))
      (compile nil (list 'lambda '(x) '(declare (ignorable x)) form)))
    (nreverse messages)))

(defparameter *tcw-valid*
  '(
    (mod 5)
    (mod 1)
    (mod 100000000000000000000)
    (integer)
    (integer *)
    (integer * *)
    (integer 0 *)
    (integer * 10)
    (integer 0 10)
    (integer (0) (10))
    (integer -5 -1)
    (integer (1) (1))
    (rational 1/2 5)
    (rational (1/2))
    (rational * 3)
    (real 1 2)
    (real 1.5 2.5)
    (real (1.5) *)
    (real * *)
    (float 1.0 2.0)
    (float * 5.0)
    (float (1.0))
    (float 1 3)
    (single-float 1.0 3.0)
    (single-float (1.0) *)
    (single-float * *)
    (double-float 1.0d0 3.0d0)
    (double-float (1.0d0))
    (short-float 1.0)
    (long-float 1.0d0)
    (unsigned-byte 8)
    (unsigned-byte *)
    (unsigned-byte)
    (signed-byte 8)
    (signed-byte *)
    (complex)
    (complex integer)
    (complex float)
    (complex single-float)
    (complex rational)
    (complex *)
    (complex (integer 0 5))
    (and)
    (and integer)
    (and integer fixnum)
    (and (or integer string) (not null))
    (or)
    (or integer string)
    (or null (cons integer))
    (or null (cons integer string))
    (or integer (cons * *))
    (not integer)
    (not (not integer))
    (not (member 1 2))
    (member)
    (member 1 2 3)
    (member a b c)
    (member (1 2) "x" 3.5)
    (eql 5)
    (eql a)
    (eql nil)
    (satisfies integerp)
    (satisfies car)
    (array)
    (array *)
    (array integer)
    (array integer *)
    (array integer 3)
    (array integer (3 4))
    (array integer (* 4))
    (array integer (* *))
    (array * *)
    (array * 2)
    (array * 3)
    (array integer ())
    (array t 1)
    (array t (2))
    (array (integer 0 5) 2)
    (array (or integer string) (2 2))
    (simple-array integer (3))
    (simple-array * *)
    (simple-array * (*))
    (simple-array (unsigned-byte 8) (*))
    (simple-array character 1)
    (simple-array t (2))
    (simple-array)
