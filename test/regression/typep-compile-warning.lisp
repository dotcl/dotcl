    (vector integer)
    (vector integer 5)
    (vector integer *)
    (vector * 5)
    (vector * 2)
    (vector t 2)
    (vector (unsigned-byte 8) 16)
    (simple-vector)
    (simple-vector 5)
    (simple-vector *)
    (simple-vector 2)
    (string)
    (string 5)
    (string *)
    (string 1)
    (simple-string 5)
    (simple-string *)
    (base-string 5)
    (simple-base-string 5)
    (bit-vector 5)
    (bit-vector *)
    (simple-bit-vector 5)
    (cons)
    (cons integer)
    (cons integer string)
    (cons * *)
