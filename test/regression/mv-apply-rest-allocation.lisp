;;; regression: skip-under-interp
;;; Multiple values, calls, lambda lists and constant types must not allocate.

(defparameter *mva-sink* nil)
(defvar *mva-iterations* 1000)

(defun %mva-values2 (a b) (values a b))
(defun %mva-values3 (a b c) (values a b c))
(defun %mva-add2 (a b) (+ a b))
(defun %mva-add3 (a b c) (+ a b c))
(defun %mva-g0 () 0)
(defun %mva-g1 (a) a)
(defun %mva-g2 (a b) (+ a b))
(defun %mva-g3 (a b c) (+ a b c))
(defun %mva-opt (a &optional (b 0)) (+ a b))
(defun %mva-rest (a &rest r) (if r (+ a (car r)) a))
(defun %mva-key (a &key (b 0) (c 0)) (+ a b c))
(defun %mva-key-aok-fn (a &key (b 0) (c 0) &allow-other-keys) (+ a b c))

(defstruct %mva-point x y)

(defvar *mva-fn2* #'%mva-values2)
(defvar *mva-fn3* #'%mva-values3)
(defvar *mva-list0* nil)
(defvar *mva-list1* (list 1))
(defvar *mva-list2* (list 1 2))
(defvar *mva-list3* (list 1 2 3))
(defvar *mva-fixnum-type* 'fixnum)
(defvar *mva-string-type* 'string)
(defvar *mva-point* (make-%mva-point :x 1 :y 2))
(defvar *mva-string* "abc")
(defvar *mva-list* '(1 2 3))
(defvar *mva-symbol* 'foo)
(defvar *mva-u8* (make-array 4 :element-type '(unsigned-byte 8)))

(defvar *mva-closure0* nil)
(defvar *mva-closure1* nil)
(defvar *mva-closure2* nil)
(defvar *mva-closure3* nil)
(let ((k 3))
  (setq *mva-closure0* (lambda () k)
        *mva-closure1* (lambda (a) (+ a k))
        *mva-closure2* (lambda (a b) (+ a b k))
        *mva-closure3* (lambda (a b c) (+ a b c k))))

(defmacro %mva-def-row (name params &body body)
  `(defun ,name ,params
     (declare (fixnum a b c))
     (let ((acc 0))
       (declare (fixnum acc))
       (dotimes (i *mva-iterations* acc)
         (declare (fixnum i))
         (setq acc (logand (+ acc (the fixnum (progn ,@body))) #xffffff))))))

(%mva-def-row %mva-mv-bind2 (a b c) (multiple-value-bind (x y) (values a b) (+ x y)))
(%mva-def-row %mva-mv-bind3 (a b c) (multiple-value-bind (x y z) (values a b c) (+ x y z)))
(%mva-def-row %mva-mv-bind2-fn (a b c)
  (multiple-value-bind (x y) (funcall *mva-fn2* a b) (+ x y)))
(%mva-def-row %mva-mv-bind3-fn (a b c)
  (multiple-value-bind (x y z) (funcall *mva-fn3* a b c) (+ x y z)))

(%mva-def-row %mva-mv-setq2 (a b c)
  (let ((x 0) (y 0))
    (declare (fixnum x y))
    (multiple-value-setq (x y) (values a b))
    (+ x y)))
(%mva-def-row %mva-mv-setq3 (a b c)
  (let ((x 0) (y 0) (z 0))
    (declare (fixnum x y z))
    (multiple-value-setq (x y z) (values a b c))
    (+ x y z)))
(%mva-def-row %mva-mv-setq2-fn (a b c)
  (let ((x 0) (y 0))
    (declare (fixnum x y))
    (multiple-value-setq (x y) (funcall *mva-fn2* a b))
    (+ x y)))
(%mva-def-row %mva-mv-setq3-fn (a b c)
  (let ((x 0) (y 0) (z 0))
    (declare (fixnum x y z))
    (multiple-value-setq (x y z) (funcall *mva-fn3* a b c))
    (+ x y z)))

(%mva-def-row %mva-nth2 (a b c) (nth-value 1 (values a b)))
(%mva-def-row %mva-nth3 (a b c) (nth-value 1 (values a b c)))
(%mva-def-row %mva-nth3-2 (a b c) (nth-value 2 (values a b c)))
(%mva-def-row %mva-nth2-fn (a b c) (nth-value 1 (funcall *mva-fn2* a b)))
(%mva-def-row %mva-nth3-fn (a b c) (nth-value 1 (funcall *mva-fn3* a b c)))
(%mva-def-row %mva-nth3-2-fn (a b c) (nth-value 2 (funcall *mva-fn3* a b c)))

(%mva-def-row %mva-mvc2 (a b c) (multiple-value-call #'%mva-add2 (values a b)))
(%mva-def-row %mva-mvc3 (a b c) (multiple-value-call #'%mva-add3 (values a b c)))
(%mva-def-row %mva-mvc2-fn (a b c) (multiple-value-call #'%mva-add2 (funcall *mva-fn2* a b)))
(%mva-def-row %mva-mvc3-fn (a b c)
  (multiple-value-call #'%mva-add3 (funcall *mva-fn3* a b c)))

(%mva-def-row %mva-mvp2 (a b c)
  (multiple-value-bind (x y) (multiple-value-prog1 (values a b)) (+ x y)))
(%mva-def-row %mva-mvp3 (a b c)
  (multiple-value-bind (x y z) (multiple-value-prog1 (values a b c)) (+ x y z)))
(%mva-def-row %mva-mvp2-fn (a b c)
  (multiple-value-bind (x y) (multiple-value-prog1 (funcall *mva-fn2* a b)) (+ x y)))
(%mva-def-row %mva-mvp3-fn (a b c)
  (multiple-value-bind (x y z)
      (multiple-value-prog1 (funcall *mva-fn3* a b c)) (+ x y z)))

(%mva-def-row %mva-funcall-g0 (a b c) (funcall #'%mva-g0))
(%mva-def-row %mva-funcall-g1 (a b c) (funcall #'%mva-g1 a))
(%mva-def-row %mva-funcall-g2 (a b c) (funcall #'%mva-g2 a b))
(%mva-def-row %mva-funcall-g3 (a b c) (funcall #'%mva-g3 a b c))
(%mva-def-row %mva-funcall-c0 (a b c) (funcall *mva-closure0*))
(%mva-def-row %mva-funcall-c1 (a b c) (funcall *mva-closure1* a))
(%mva-def-row %mva-funcall-c2 (a b c) (funcall *mva-closure2* a b))
(%mva-def-row %mva-funcall-c3 (a b c) (funcall *mva-closure3* a b c))

(%mva-def-row %mva-apply-g0 (a b c) (apply #'%mva-g0 *mva-list0*))
(%mva-def-row %mva-apply-g1 (a b c) (apply #'%mva-g1 *mva-list1*))
(%mva-def-row %mva-apply-g2 (a b c) (apply #'%mva-g2 *mva-list2*))
(%mva-def-row %mva-apply-g3 (a b c) (apply #'%mva-g3 *mva-list3*))
(%mva-def-row %mva-apply-c0 (a b c) (apply *mva-closure0* *mva-list0*))
(%mva-def-row %mva-apply-c1 (a b c) (apply *mva-closure1* *mva-list1*))
(%mva-def-row %mva-apply-c2 (a b c) (apply *mva-closure2* *mva-list2*))
(%mva-def-row %mva-apply-c3 (a b c) (apply *mva-closure3* *mva-list3*))
(%mva-def-row %mva-apply-spread1 (a b c) (apply #'%mva-g2 a *mva-list1*))
(%mva-def-row %mva-apply-spread2 (a b c) (apply #'%mva-g3 a b *mva-list1*))

(%mva-def-row %mva-opt0 (a b c) (%mva-opt a))
(%mva-def-row %mva-opt1 (a b c) (%mva-opt a b))
(%mva-def-row %mva-rest0 (a b c) (%mva-rest a))
(%mva-def-row %mva-key0 (a b c) (%mva-key a))
(%mva-def-row %mva-key1 (a b c) (%mva-key a :b b))
(%mva-def-row %mva-key2 (a b c) (%mva-key a :b b :c c))
(%mva-def-row %mva-key-apply1 (a b c) (apply #'%mva-key a '(:b 1)))
(%mva-def-row %mva-key-apply2 (a b c) (apply #'%mva-key a '(:b 1 :c 2)))
(%mva-def-row %mva-key-aok (a b c) (%mva-key-aok-fn a :b b :d c))

(%mva-def-row %mva-typep-fixnum (a b c) (if (typep a 'fixnum) 1 0))
(%mva-def-row %mva-typep-string (a b c) (if (typep *mva-string* 'string) 1 0))
(%mva-def-row %mva-typep-list (a b c) (if (typep *mva-list* 'list) 1 0))
(%mva-def-row %mva-typep-symbol (a b c) (if (typep *mva-symbol* 'symbol) 1 0))
(%mva-def-row %mva-typep-struct (a b c) (if (typep *mva-point* '%mva-point) 1 0))
(%mva-def-row %mva-typep-int-range (a b c) (if (typep a '(integer 0 100)) a 0))
(%mva-def-row %mva-typep-or (a b c) (if (typep *mva-string* '(or null string)) 1 0))
(%mva-def-row %mva-typep-member (a b c) (if (typep *mva-symbol* '(member :a :b)) 1 0))
(%mva-def-row %mva-typep-array (a b c)
  (if (typep *mva-u8* '(simple-array (unsigned-byte 8) (*))) 1 0))
(%mva-def-row %mva-typep-var (a b c) (if (typep a *mva-fixnum-type*) 1 0))
(%mva-def-row %mva-typep-var-string (a b c) (if (typep *mva-string* *mva-string-type*) 1 0))
(%mva-def-row %mva-subtypep (a b c) (if (subtypep 'fixnum 'integer) 1 0))
(%mva-def-row %mva-subtypep-2 (a b c) (if (subtypep '(integer 0 100) 'fixnum) 1 0))
(%mva-def-row %mva-check-type (a b c) (check-type a fixnum) a)
(%mva-def-row %mva-the (a b c) (the fixnum (+ a b c)))

(defun %mva-baseline ()
  (min-allocated-bytes (lambda ()
                         (dotimes (%i 1000) (setq *mva-sink* nil)))
                       5))

(defun %mva-failures (rows)
  (let ((base (%mva-baseline)) (bad nil))
    (dolist (row rows (nreverse bad))
      (funcall (cdr row))
      (let ((got (min-allocated-bytes (cdr row) 5)))
        (when (> got base) (push (list (car row) got base) bad))))))

(defmacro %mva-row (label form)
  `(cons ,label (lambda () (dotimes (%i 1000) (setq *mva-sink* ,form)))))

(deftest-compiled-only mv-allocation.values
  (%mva-failures
   (list
    (%mva-row "multiple-value-bind 2, direct" (%mva-mv-bind2 3 4 5))
    (%mva-row "multiple-value-bind 3, direct" (%mva-mv-bind3 3 4 5))
    (%mva-row "multiple-value-bind 2, funcall variable" (%mva-mv-bind2-fn 3 4 5))
    (%mva-row "multiple-value-bind 3, funcall variable" (%mva-mv-bind3-fn 3 4 5))
    (%mva-row "multiple-value-setq 2, direct" (%mva-mv-setq2 3 4 5))
    (%mva-row "multiple-value-setq 3, direct" (%mva-mv-setq3 3 4 5))
    (%mva-row "multiple-value-setq 2, funcall variable" (%mva-mv-setq2-fn 3 4 5))
    (%mva-row "multiple-value-setq 3, funcall variable" (%mva-mv-setq3-fn 3 4 5))
    (%mva-row "nth-value 1 of 2, direct" (%mva-nth2 3 4 5))
    (%mva-row "nth-value 1 of 3, direct" (%mva-nth3 3 4 5))
    (%mva-row "nth-value 2 of 3, direct" (%mva-nth3-2 3 4 5))
    (%mva-row "nth-value 1 of 2, funcall variable" (%mva-nth2-fn 3 4 5))
    (%mva-row "nth-value 1 of 3, funcall variable" (%mva-nth3-fn 3 4 5))
    (%mva-row "nth-value 2 of 3, funcall variable" (%mva-nth3-2-fn 3 4 5))
    (%mva-row "multiple-value-call 2, direct" (%mva-mvc2 3 4 5))
    (%mva-row "multiple-value-call 3, direct" (%mva-mvc3 3 4 5))
    (%mva-row "multiple-value-call 2, funcall variable" (%mva-mvc2-fn 3 4 5))
    (%mva-row "multiple-value-call 3, funcall variable" (%mva-mvc3-fn 3 4 5))
    (%mva-row "multiple-value-prog1 2, direct" (%mva-mvp2 3 4 5))
    (%mva-row "multiple-value-prog1 3, direct" (%mva-mvp3 3 4 5))
    (%mva-row "multiple-value-prog1 2, funcall variable" (%mva-mvp2-fn 3 4 5))
    (%mva-row "multiple-value-prog1 3, funcall variable" (%mva-mvp3-fn 3 4 5))))
  nil)

(deftest-compiled-only mv-allocation.calls
  (%mva-failures
   (list
    (%mva-row "funcall global 0" (%mva-funcall-g0 3 4 5))
    (%mva-row "funcall global 1" (%mva-funcall-g1 3 4 5))
    (%mva-row "funcall global 2" (%mva-funcall-g2 3 4 5))
    (%mva-row "funcall global 3" (%mva-funcall-g3 3 4 5))
    (%mva-row "funcall closure 0" (%mva-funcall-c0 3 4 5))
    (%mva-row "funcall closure 1" (%mva-funcall-c1 3 4 5))
    (%mva-row "funcall closure 2" (%mva-funcall-c2 3 4 5))
    (%mva-row "funcall closure 3" (%mva-funcall-c3 3 4 5))
    (%mva-row "apply global 0" (%mva-apply-g0 3 4 5))
    (%mva-row "apply global 1" (%mva-apply-g1 3 4 5))
    (%mva-row "apply global 2" (%mva-apply-g2 3 4 5))
    (%mva-row "apply global 3" (%mva-apply-g3 3 4 5))
    (%mva-row "apply closure 0" (%mva-apply-c0 3 4 5))
    (%mva-row "apply closure 1" (%mva-apply-c1 3 4 5))
    (%mva-row "apply closure 2" (%mva-apply-c2 3 4 5))
    (%mva-row "apply closure 3" (%mva-apply-c3 3 4 5))
    (%mva-row "apply global 2, one spread arg" (%mva-apply-spread1 3 4 5))
    (%mva-row "apply global 3, two spread args" (%mva-apply-spread2 3 4 5))))
  nil)

(deftest-compiled-only mv-allocation.lambda-lists
  (%mva-failures
   (list
    (%mva-row "&optional, 0 extra" (%mva-opt0 3 4 5))
    (%mva-row "&optional, 1 extra" (%mva-opt1 3 4 5))
    (%mva-row "&rest, 0 extra" (%mva-rest0 3 4 5))
    (%mva-row "&key, 0 keywords" (%mva-key0 3 4 5))
    (%mva-row "&key, 1 keyword" (%mva-key1 3 4 5))
    (%mva-row "&key, 2 keywords" (%mva-key2 3 4 5))
    (%mva-row "&key through apply, 1 keyword" (%mva-key-apply1 3 4 5))
    (%mva-row "&key through apply, 2 keywords" (%mva-key-apply2 3 4 5))
    (%mva-row "&key &allow-other-keys, unknown key" (%mva-key-aok 3 4 5))))
  nil)

(deftest-compiled-only mv-allocation.types
  (%mva-failures
   (list
    (%mva-row "typep constant fixnum" (%mva-typep-fixnum 3 4 5))
    (%mva-row "typep constant string" (%mva-typep-string 3 4 5))
    (%mva-row "typep constant list" (%mva-typep-list 3 4 5))
    (%mva-row "typep constant symbol" (%mva-typep-symbol 3 4 5))
    (%mva-row "typep constant defstruct" (%mva-typep-struct 3 4 5))
    (%mva-row "typep constant (integer 0 100)" (%mva-typep-int-range 3 4 5))
    (%mva-row "typep constant (or null string)" (%mva-typep-or 3 4 5))
    (%mva-row "typep constant (member :a :b)" (%mva-typep-member 3 4 5))
    (%mva-row "typep constant simple-array" (%mva-typep-array 3 4 5))
    (%mva-row "typep variable type" (%mva-typep-var 3 4 5))
    (%mva-row "typep variable type of string" (%mva-typep-var-string 3 4 5))
    (%mva-row "subtypep constant fixnum integer" (%mva-subtypep 3 4 5))
    (%mva-row "subtypep constant (integer 0 100) fixnum" (%mva-subtypep-2 3 4 5))
    (%mva-row "check-type fixnum at safety 1" (%mva-check-type 3 4 5))
    (%mva-row "the fixnum at safety 1" (%mva-the 3 4 5))))
  nil)
