;;; The standard pprint dispatch table for code: the special forms and macros
;;; SBCL's initial table prints in a shape of their own (DEFUN, LET, IF, COND as a
;;; function call, LOOP, FLET, CASE, DO, SETQ, ...), and a macro whose lambda
;;; list has &BODY. Expected values are SBCL 2.6.8's output at right margins of
;;; 80 and 40 (generated by printing the same forms there).

(defun %psf-print (object margin)
  (let ((*print-right-margin* margin)
        (*print-pretty* t)
        (*print-escape* t)
        (*print-readably* nil)
        (*print-length* nil)
        (*print-level* nil)
        (*print-lines* nil)
        (*print-circle* nil)
        (*print-miser-width* nil)
        (*print-case* :upcase)
        (*package* (find-package "CL-USER")))
    (prin1-to-string object)))

(defmacro psf-with-thing ((var thing) &body body)
  (list* 'let (list (list var thing)) body))

(deftest pprint-standard-dispatch-forms.defun.1
  (%psf-print '(defun fact (n) (if (<= n 1) 1 (* n (fact (- n 1)))) (let ((a 1) (b 2) (c 3)) (list a b c a b c a b c a b c))) 80)
  "(DEFUN FACT (N)
  (IF (<= N 1)
      1
      (* N (FACT (- N 1))))
  (LET ((A 1) (B 2) (C 3))
    (LIST A B C A B C A B C A B C)))")

(deftest pprint-standard-dispatch-forms.defun.2
  (%psf-print '(defun foo (a b &optional (c 1) &key (d 2 dp) ((:e e) 3) &rest r &aux z) "doc" (declare (ignore a)) (list a b c d e r z)) 80)
  "(DEFUN FOO (A B &OPTIONAL (C 1) &KEY (D 2 DP) ((:E E) 3) &REST R &AUX Z)
  \"doc\"
  (DECLARE (IGNORE A))
  (LIST A B C D E R Z))")

