;;; Counting loops whose pack reads and writes the bounded loop proves in range.

(defun %dsl-count (needle text)
  (loop with start = 0
        for pos = (search needle text :start2 start)
        while pos count t do (setf start (1+ pos))))

(defparameter *dsl-backed-kinds*
  '((double-float "F64.2") (single-float "F32.4") ((signed-byte 64) "S64.2")
    ((unsigned-byte 64) "U64.2") ((signed-byte 32) "S32.4") ((unsigned-byte 16) "U16.8")
    ((unsigned-byte 8) "U8.16")))

(defun %dsl-bounded-form (element-type kind safety notinline shape)
  (let* ((aref (simd-sym kind "-AREF"))
         (add (simd-sym kind "+"))
         (lanes (simd-lane-count kind))
         (decls `((type (simple-array ,element-type (*)) x z)
                  (type (integer 0 1000) n)
                  (optimize (speed 3) (safety ,safety))
                  ,@(and notinline `((notinline ,aref ,add (setf ,aref)))))))
    `(lambda (x z n)
       (declare ,@decls)
       ,(ecase shape
          (:do `(do ((i 0 (+ i ,lanes))) ((>= i n))
                  (declare (type (integer 0 1100) i))
                  (setf (,aref z i) (,add (,aref x i) (,aref z i)))))
          (:offset `(do ((i 0 (+ i ,(* 2 lanes)))) ((>= i n))
                      (declare (type (integer 0 1100) i))
                      (setf (,aref z i) (,add (,aref x (+ i ,lanes)) (,aref z i)))
                      (setf (,aref z (+ ,lanes i)) (,aref x i))))
          (:unaligned `(do ((i 1 (+ i ,lanes))) ((>= i n))
                         (declare (type (integer 0 1100) i))
                         (setf (,aref z i) (,add (,aref x i) (,aref z i)))))
          (:loop-to `(loop for i of-type (integer 0 1100) from 0 to n by ,lanes
                           do (setf (,aref z i) (,add (,aref x i) (,aref z i))))))
       z)))

(defun %dsl-bounded-agrees-p (element-type kind safety shape)
  (let* ((lanes (simd-lane-count kind))
         (state (make-random-state t))
         (lowered (compile nil (%dsl-bounded-form element-type kind safety nil shape)))
         (boxed (compile nil (%dsl-bounded-form element-type kind safety t shape))))
    (loop for len in (list 0 1 (1- lanes) lanes (1+ lanes) (* 2 lanes) (1+ (* 2 lanes))
                           (1- (* 3 lanes)) (* 4 lanes))
          always (loop for n in (remove-duplicates
                                 (remove-if #'minusp (list 0 1 (1- len) len (1+ len) (- len lanes)
                                                           (* lanes (floor len lanes)))))
                       always (or (and (= safety 0)
                                       (> (+ n (if (member shape '(:offset :loop-to)) (* 2 lanes) lanes))
                                          len))
                                  (let* ((x (%dsl-int-or-float-array element-type len state))
                                         (z1 (%dsl-int-or-float-array element-type len state))
                                         (z2 (copy-seq z1))
                                         (r1 (%dsl-run lowered (list x z1 n)))
                                         (r2 (%dsl-run boxed (list x z2 n))))
                                    (and (or (and (typep r1 'error) (typep r2 'error))
                                             (and (not (typep r1 'error)) (not (typep r2 'error))))
                                         (equalp z1 z2))))))))

(defun %dsl-int-or-float-array (element-type n state)
  (if (subtypep element-type 'float)
      (let ((a (make-array n :element-type element-type)))
        (dotimes (i n a) (setf (aref a i) (coerce (- (random 100) 50) element-type))))
      (%dsl-int-array element-type n state)))

(deftest-emitting-only dotcl-simd-lower.bounded-loops
  (loop for (type kind) in *dsl-backed-kinds*
        append (loop for shape in '(:do :offset :unaligned :loop-to)
                     unless (and (%dsl-bounded-agrees-p type kind 1 shape)
                                 (%dsl-bounded-agrees-p type kind 0 shape))
                       collect (list kind shape)))
  nil)

(deftest-compiled-only dotcl-simd-lower.bounded-loop-shape
  (flet ((sil (shape safety)
           (let ((dotcl:*save-sil* t))
             (eval `(defun %dsl-bounded-shape
                        ,@(cdr (%dsl-bounded-form 'double-float "F64.2" safety nil shape))))
             (%flat-text (dotcl:function-sil #'%dsl-bounded-shape)))))
    (list (%dsl-count "Simd.LoadAt.Double" (sil :do 1))
          (%dsl-count "Simd.StoreAt.Double" (sil :do 0))
          (%dsl-count "Simd.LoadAt.Double" (sil :offset 0))
          (%dsl-count "Simd.StoreAt.Double" (sil :offset 1))
          (%dsl-count "Simd.LoadAt." (sil :unaligned 0))
          (%dsl-count "Simd.LoadAt.Double" (sil :loop-to 1))))
  (2 1 3 2 0 2))
