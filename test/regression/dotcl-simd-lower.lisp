(deftest-emitting-only dotcl-simd-lower.argument-order
  ;; The second argument's effect happens before the first one's type error
  ;; would, exactly as for the ordinary call.
  (let ((log '()))
    (flet ((note (x) (push x log) x))
      (declare (ignorable #'note))
      (let ((f (compile nil '(lambda (a note)
                               (dotcl-simd:f64.2+ a (funcall note (dotcl-simd:f64.2 2d0)))))))
        (list (signals-error (funcall f "bad" #'note) type-error)
              (length log)))))
  (t 1))

(defun %dsl-kernel (element-type kind safety notinline)
  (compile nil (%dsl-kernel-form element-type kind safety notinline)))

(defun %dsl-kernel-form (element-type kind safety notinline)
  (let ((aref (simd-sym kind "-AREF"))
        (add (simd-sym kind "+"))
        (mul (simd-sym kind "*"))
        (lanes (simd-lane-count kind)))
    `(lambda (x y z n)
                (declare (type (simple-array ,element-type (*)) x y z)
                         (type (integer 0 100000) n)
                         (optimize (speed 3) (safety ,safety))
                         ,@(and notinline `((notinline ,aref ,add ,mul (setf ,aref)))))
                (do ((i 0 (+ i ,lanes))) ((>= i n))
                  (declare (type (integer 0 100100) i))
                  (setf (,aref z i) (,add (,aref x i) (,mul (,aref y i) (,aref x i)))))
                z)))

(defun %dsl-arrays (element-type n)
  (let ((x (make-array n :element-type element-type))
        (y (make-array n :element-type element-type)))
    (dotimes (i n)
      (setf (aref x i) (coerce (- (* i 0.75) 3) element-type)
            (aref y i) (coerce (- 7 (* i 0.5)) element-type)))
    (values x y)))

(defun %dsl-kernel-agrees-p (element-type kind safety)
  (multiple-value-bind (x y) (%dsl-arrays element-type 64)
    (flet ((run (notinline)
             (let ((z (make-array 64 :element-type element-type
                                     :initial-element (coerce 0 element-type))))
               (funcall (%dsl-kernel element-type kind safety notinline) x y z 64)
               z)))
      (let ((l (run nil)) (b (run t)))
        (and (equalp l b)
             (loop for i below 64
                   always (= (aref l i) (+ (aref x i) (* (aref y i) (aref x i))))))))))

(deftest-emitting-only dotcl-simd-lower.kernels
  (list (%dsl-kernel-agrees-p 'double-float "F64.2" 0)
        (%dsl-kernel-agrees-p 'double-float "F64.2" 1)
        (%dsl-kernel-agrees-p 'single-float "F32.4" 0)
        (%dsl-kernel-agrees-p 'single-float "F32.4" 1))
  (t t t t))

(defun %dsl-int-array (element-type n state)
  (let ((a (make-array n :element-type element-type))
        (r (integer-type-range element-type)))
    (dotimes (i n a)
      (setf (aref a i) (+ (car r) (random (1+ (- (cdr r) (car r))) state))))))

(defun %dsl-int-kernel-agrees-p (element-type kind safety)
  (let* ((state (make-random-state t))
         (x (%dsl-int-array element-type 64 state))
         (y (%dsl-int-array element-type 64 state)))
    (flet ((run (notinline)
             (let ((z (make-array 64 :element-type element-type :initial-element 0)))
               (funcall (%dsl-kernel element-type kind safety notinline) x y z 64)
               z)))
      (equalp (run nil) (run t)))))

