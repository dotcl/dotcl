;;; DOTCL-SIMD calls the compiler lowers to raw Vector128 values, against the
;;; same code with the operations declared NOTINLINE (ordinary calls).
;;; Uses the random packs of dotcl-simd-ops.lisp.

(require "dotcl-simd")

(defun %dsl-compile-pair (lambda-list body-fn names)
  "Two compiled functions: BODY-FN's form lowered, and with NAMES NOTINLINE."
  (values (compile nil `(lambda ,lambda-list ,(funcall body-fn)))
          (compile nil `(lambda ,lambda-list
                          (declare (notinline ,@names))
                          ,(funcall body-fn)))))

(defun %dsl-same-p (a b)
  (or (and (typep a 'error) (typep b 'error))
      (simd-same-p a b)))

(defun %dsl-run (fn args)
  (handler-case (apply fn args) (error (e) e)))

(defun %dsl-tree-differences (name suffix arity)
  (let* ((op (simd-sym name suffix))
         (state (make-random-state t))
         (bad '()))
    (multiple-value-bind (lowered boxed)
        (if (= arity 2)
            (%dsl-compile-pair '(a b c) (lambda () `(,op (,op a b) c)) (list op))
            (%dsl-compile-pair '(a) (lambda () `(,op (,op a))) (list op)))
      (dotimes (i 40)
        (let ((args (loop repeat (if (= arity 2) 3 1) collect (simd-random-pack name state))))
          (let ((l (%dsl-run lowered args)) (b (%dsl-run boxed args)))
            (unless (%dsl-same-p l b) (push (list name suffix args l b) bad))))))
    (subseq bad 0 (min 3 (length bad)))))

(deftest-emitting-only dotcl-simd-lower.differential-binary
  (append
   (loop for name in *simd-names*
         append (loop for suffix in '("+" "-" "*" "-MIN" "-MAX" "-AND" "-OR" "-XOR" "-ANDC1")
                      append (%dsl-tree-differences name suffix 2)))
   (loop for name in *simd-float-names* append (%dsl-tree-differences name "/" 2)))
  nil)

(deftest-emitting-only dotcl-simd-lower.differential-unary
  (append
   (loop for name in *simd-names* append (%dsl-tree-differences name "-NOT" 1))
   (loop for name in *simd-float-names* append (%dsl-tree-differences name "-SQRT" 1)))
  nil)

