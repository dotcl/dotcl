(deftest-compiled-only dotcl-simd-lower.netstandard-fasl
  ;; A fasl for netstandard cannot name Vector128: the calls stay ordinary.
  (let ((src (regression-temp-file "dsl-ns.lisp"))
        (fasl (regression-temp-file "dsl-ns.fasl"))
        (sil (regression-temp-file "dsl-ns.sil")))
    (with-open-file (s src :direction :output :if-exists :supersede)
      (let ((*package* (find-package :cl-user)))
        (prin1 '(defun dsl-ns-kernel (x y)
                 (declare (type (simple-array double-float (*)) x y))
                 (dotimes (k 1)
                   (setf (dotcl-simd:f64.2-aref y 0)
                         (dotcl-simd:f64.2+ (dotcl-simd:f64.2-aref x 0) 1d0)))
                 y)
               s)))
    (let ((*error-output* (make-broadcast-stream)))
      (compile-file src :output-file fasl :sil t :corlib-name "netstandard"))
    (let ((text (with-open-file (s sil) (let ((str (make-string (file-length s))))
                                          (subseq str 0 (read-sequence str s))))))
      (load fasl)
      (list (search "Simd." text)
            (coerce (funcall 'dsl-ns-kernel
                             (make-array 2 :element-type 'double-float :initial-contents '(1d0 2d0))
                             (make-array 2 :element-type 'double-float :initial-element 0d0))
                    'list))))
  (nil (2d0 3d0)))

(defun %dsl-oob-agrees-p (element-type kind safety)
  (let* ((aref (simd-sym kind "-AREF"))
         (lanes (simd-lane-count kind))
         (decl `(declare (type (simple-array ,element-type (*)) a) (fixnum i)
                         (optimize (safety ,safety))))
         (read (compile nil `(lambda (a i) ,decl (,aref a i))))
         (write (compile nil `(lambda (a i p) ,decl (setf (,aref a i) p))))
         (read-b (compile nil `(lambda (a i) ,decl (declare (notinline ,aref)) (,aref a i))))
         (write-b (compile nil `(lambda (a i p) ,decl (declare (notinline (setf ,aref))) (setf (,aref a i) p))))
         (p (funcall (simd-sym kind "") (coerce 1 element-type))))
    (loop for n in (list 0 1 (1- lanes) lanes (* 2 lanes))
          always (loop for i in '(0 -1 1 -2)
                       always (let ((a (make-array n :element-type element-type :initial-element (coerce 0 element-type)))
                                    (b (make-array n :element-type element-type :initial-element (coerce 0 element-type))))
                                (and (eq (typep (%dsl-run read (list a i)) 'error)
                                         (typep (%dsl-run read-b (list b i)) 'error))
                                     (eq (typep (%dsl-run write (list a i p)) 'error)
                                         (typep (%dsl-run write-b (list b i p)) 'error))
                                     (equalp a b)))))))

