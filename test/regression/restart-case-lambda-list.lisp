;;; RESTART-CASE clause lambda lists are ordinary lambda lists (CLHS), so
;;; &optional/&key defaults, supplied-p variables, &rest, &aux, arity checks and
;;; unknown-keyword checks all have to work on both evaluator paths.

(defparameter *rcl-forms*
  '((restart-case (invoke-restart 'r 1)
      (r (a &optional (b 2)) (list a b)))
    (restart-case (invoke-restart 'r 1 3)
      (r (a &optional (b 2)) (list a b)))
    (restart-case (invoke-restart 'r 1)
      (r (a &optional (b 2 bsp)) (list a b bsp)))
    (restart-case (invoke-restart 'r 1 3)
      (r (a &optional (b 2 bsp)) (list a b bsp)))
    (restart-case (invoke-restart 'r :a 1)
      (r (&key (a 5) (b 6)) (list a b)))
    (restart-case (invoke-restart 'r)
      (r (&key (a 5) (b 6)) (list a b)))
    (restart-case (invoke-restart 'r :a 1)
      (r (&key (a 5 asp) (b 6 bsp)) (list a asp b bsp)))
    (restart-case (invoke-restart 'r 1 2 3)
      (r (a &rest rest) (list a rest)))
    (restart-case (invoke-restart 'r 1)
      (r (a &aux (b (1+ a))) (list a b)))
    (restart-case (invoke-restart 'r 1)
      (r () :ok))
    (restart-case (invoke-restart 'r 1 2)
      (r (a) a))
    (restart-case (invoke-restart 'r)
      (r (a) a))
    (restart-case (invoke-restart 'r :c 1)
      (r (&key a) a))
    (restart-case (invoke-restart 'r :c 1)
      (r (&key a &allow-other-keys) a))
    (restart-case (invoke-restart 'r 1 :a 2)
      (r (x &rest y &key a) (list x y a)))
    (restart-case (invoke-restart 'r 1)
      (r (x) (setq x (+ x 10)) x))
    (let ((f nil))
      (restart-case (invoke-restart 'r 7)
        (r (x) (setq f (lambda () x))))
      (funcall f))))

(defun %rcl-results (mode)
  (let ((dotcl:*evaluator-mode* mode))
    (mapcar (lambda (form)
              (handler-case (eval form)
                (error (c)
                  (list :error (if (typep c 'program-error)
                                   'program-error
                                   (type-of c))))))
            *rcl-forms*)))

(deftest restart-case-lambda-list.forms
  (list (%rcl-results :compile) (%rcl-results :interpret))
  (((1 2) (1 3) (1 2 nil) (1 3 t) (1 6) (5 6) (1 t 6 nil)
    (1 (2 3)) (1 2)
    (:error program-error) (:error program-error)
    (:error program-error) (:error program-error)
    nil (1 (:a 2) 2) 11 7)
   ((1 2) (1 3) (1 2 nil) (1 3 t) (1 6) (5 6) (1 t 6 nil)
    (1 (2 3)) (1 2)
    (:error program-error) (:error program-error)
    (:error program-error) (:error program-error)
    nil (1 (:a 2) 2) 11 7)))
