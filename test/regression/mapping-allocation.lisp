(defun %ma-first-car (x) (car x))
(defun %ma-one (x) (list x))
(defun %ma-one-tail (x) (list (car x)))

(defmacro %ma-defrow (name label budget group form)
  `(progn
     (defun ,name ()
       (let ((%ma-x nil))
         (dotimes (%ma-i 1000) (setq %ma-x ,form))
         %ma-x))
     (push (list ,label ,budget #',name) ,group)))

(defmacro %ma-defcaprow (name label budget group form)
  `(progn
     (defun ,name ()
       (let ((k 3) (%ma-x nil))
         (dotimes (%ma-i 1000) (setq %ma-x ,form))
         %ma-x))
     (push (list ,label ,budget #',name) ,group)))

(defun %ma-baseline ()
  (min-allocated-bytes (lambda ()
                         (dotimes (%ma-i 1000) (setq *ma-sink* nil)))
                       5))

(defun %ma-failures (rows)
  (let ((base (%ma-baseline)) (bad nil))
    (dolist (row rows (nreverse bad))
      (let ((label (first row)) (budget (second row)) (fn (third row)))
        (funcall fn)
        (let ((got (min-allocated-bytes fn 5)))
          (when (> got (+ base (* 1000 budget) 16))
            (push (list label got (+ base (* 1000 budget))) bad)))))))

