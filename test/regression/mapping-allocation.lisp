(defun %ma-check (label rows)
  (let ((bad (%ma-failures rows)))
    (when bad (print (list label 'OVER-BUDGET bad)))
    bad))

(deftest-compiled-only mapping-allocation.mapping
  (%ma-check 'mapping *ma-map-rows*)
