;;; Writes to a reused string output stream must cost only the result string.

(defparameter *sos-sink* nil)
(defparameter *sos-iterations* 1000)
(defparameter *sos-runs* 5)
(defparameter *sos-allowance* 0)

(defparameter *sos-s0* "")
(defparameter *sos-s1* "a")
(defparameter *sos-s10* "abcdefghij")
(defparameter *sos-s1000* (make-string 1000 :initial-element #\a))
(defparameter *sos-bignum* (expt 7 40))
(defparameter *sos-list3* (list 1 2 3))
(defparameter *sos-vector3* (vector 1 2 3))
(defparameter *sos-symbol* 'abcdef)
(defparameter *sos-keyword* :abcdef)
(defparameter *sos-char* #\a)
(defparameter *sos-stream* (make-string-output-stream))

(defun %sos-get () (get-output-stream-string *sos-stream*))
(defun %sos-write-string (s) (write-string s *sos-stream*) (%sos-get))
(defun %sos-write-char (n) (dotimes (i n) (write-char *sos-char* *sos-stream*)) (%sos-get))
(defun %sos-write-line (s) (write-line s *sos-stream*) (%sos-get))
(defun %sos-terpri () (terpri *sos-stream*) (%sos-get))
(defun %sos-fresh-line-col0 () (fresh-line *sos-stream*) (%sos-get))
(defun %sos-fresh-line-after ()
  (write-string *sos-s1* *sos-stream*)
  (fresh-line *sos-stream*)
  (%sos-get))
(defun %sos-write-string-start-end ()
  (write-string *sos-s10* *sos-stream* :start 2 :end 8)
  (%sos-get))
(defun %sos-write-line-start-end ()
  (write-line *sos-s10* *sos-stream* :start 2 :end 8)
  (%sos-get))

(defun %sos-princ (obj) (princ obj *sos-stream*) (%sos-get))
(defun %sos-prin1 (obj) (prin1 obj *sos-stream*) (%sos-get))
(defun %sos-print (obj) (print obj *sos-stream*) (%sos-get))
(defun %sos-write (obj) (write obj :stream *sos-stream*) (%sos-get))
(defun %sos-write-escape-nil ()
  (write *sos-s10* :stream *sos-stream* :escape nil) (%sos-get))
(defun %sos-write-escape-t ()
  (write *sos-s10* :stream *sos-stream* :escape t) (%sos-get))
(defun %sos-write-base-16-fixnum ()
  (write 12345 :stream *sos-stream* :base 16) (%sos-get))
(defun %sos-write-base-16-bignum ()
  (write *sos-bignum* :stream *sos-stream* :base 16) (%sos-get))
(defun %sos-write-radix-16-fixnum ()
  (write 12345 :stream *sos-stream* :radix 16) (%sos-get))
(defun %sos-write-radix-16-bignum ()
  (write *sos-bignum* :stream *sos-stream* :radix 16) (%sos-get))

(defun %sos-format-a-fixnum () (format *sos-stream* "~A" 12345) (%sos-get))
(defun %sos-format-a-string () (format *sos-stream* "~A" *sos-s10*) (%sos-get))
(defun %sos-format-s-string () (format *sos-stream* "~S" *sos-s10*) (%sos-get))
(defun %sos-format-d-fixnum () (format *sos-stream* "~D" 12345) (%sos-get))
(defun %sos-format-x-fixnum () (format *sos-stream* "~X" 12345) (%sos-get))
(defun %sos-format-b-fixnum () (format *sos-stream* "~B" 12345) (%sos-get))
(defun %sos-format-c-char () (format *sos-stream* "~C" *sos-char*) (%sos-get))
(defun %sos-format-percent () (format *sos-stream* "~%") (%sos-get))
(defun %sos-format-amp () (format *sos-stream* "~&") (%sos-get))
(defun %sos-format-tilde () (format *sos-stream* "~~") (%sos-get))
(defun %sos-format-literal () (format *sos-stream* "abcdefghij") (%sos-get))
(defun %sos-format-constant ()
  (format *sos-stream* "~A-~D-~S" *sos-s1* 12345 *sos-symbol*) (%sos-get))
(defun %sos-format-three ()
  (format *sos-stream* "~A~D~X" *sos-s1* 12345 255) (%sos-get))

(defun %sos-baseline ()
  (min-allocated-bytes (lambda ()
                         (dotimes (i *sos-iterations*)
                           (setq *sos-sink* nil)))
                       *sos-runs*))

(defun %sos-bytes (total base)
  (/ (- total base) (float *sos-iterations*)))

(defun %sos-in-thunk (fn)
  (lambda ()
    (let ((*print-pretty* nil))
      (dotimes (i *sos-iterations*)
        (setq *sos-sink* (funcall fn))))))

(defun %sos-failures (rows)
  (let ((base (%sos-baseline)) (bad nil))
    (dolist (row rows (nreverse bad))
      (let ((label (car row)) (fn (cdr row)))
        (let* ((result (funcall fn))
               (floor-str result)
               (floor (%sos-bytes (min-allocated-bytes
                                   (lambda ()
                                     (dotimes (i *sos-iterations*)
                                       (setq *sos-sink* (make-string (length floor-str)))))
                                   *sos-runs*)
                                  base))
               (got (%sos-bytes (min-allocated-bytes (%sos-in-thunk fn) *sos-runs*) base)))
          (unless (<= got (+ floor *sos-allowance*))
            (push (list label got floor) bad)))))))

(defmacro %sos-row (label fn)
  `(cons ,label (function ,fn)))

(deftest-compiled-only string-output-stream-writes-allocation.reused-writes
  (%sos-failures
   (list
    (%sos-row "reused-get" %sos-get)
    (%sos-row "reused-write-string-0" (lambda () (%sos-write-string *sos-s0*)))
    (%sos-row "reused-write-string-1" (lambda () (%sos-write-string *sos-s1*)))
    (%sos-row "reused-write-string-10" (lambda () (%sos-write-string *sos-s10*)))
    (%sos-row "reused-write-string-1000" (lambda () (%sos-write-string *sos-s1000*)))
    (%sos-row "reused-write-char-1" (lambda () (%sos-write-char 1)))
    (%sos-row "reused-write-char-10" (lambda () (%sos-write-char 10)))
    (%sos-row "reused-write-char-100" (lambda () (%sos-write-char 100)))
    (%sos-row "reused-write-line" (lambda () (%sos-write-line *sos-s10*)))
    (%sos-row "reused-terpri" %sos-terpri)
    (%sos-row "reused-fresh-line-col0" %sos-fresh-line-col0)
    (%sos-row "reused-fresh-line-after" %sos-fresh-line-after)
    (%sos-row "reused-write-string-start-end" %sos-write-string-start-end)
    (%sos-row "reused-write-line-start-end" %sos-write-line-start-end)))
  nil)

(deftest-compiled-only string-output-stream-writes-allocation.printing
  (%sos-failures
   (list
    (%sos-row "princ-fixnum" (lambda () (%sos-princ 12345)))
    (%sos-row "princ-bignum" (lambda () (%sos-princ *sos-bignum*)))
    (%sos-row "princ-symbol" (lambda () (%sos-princ *sos-symbol*)))
    (%sos-row "princ-keyword" (lambda () (%sos-princ *sos-keyword*)))
    (%sos-row "princ-char" (lambda () (%sos-princ *sos-char*)))
    (%sos-row "princ-string" (lambda () (%sos-princ *sos-s10*)))
    (%sos-row "prin1-fixnum" (lambda () (%sos-prin1 12345)))
    (%sos-row "prin1-bignum" (lambda () (%sos-prin1 *sos-bignum*)))
    (%sos-row "prin1-symbol" (lambda () (%sos-prin1 *sos-symbol*)))
    (%sos-row "prin1-char" (lambda () (%sos-prin1 *sos-char*)))
    (%sos-row "prin1-string" (lambda () (%sos-prin1 *sos-s10*)))
    (%sos-row "print-fixnum" (lambda () (%sos-print 12345)))
    (%sos-row "print-bignum" (lambda () (%sos-print *sos-bignum*)))
    (%sos-row "print-symbol" (lambda () (%sos-print *sos-symbol*)))
    (%sos-row "print-char" (lambda () (%sos-print *sos-char*)))
    (%sos-row "print-string" (lambda () (%sos-print *sos-s10*)))
    (%sos-row "write-fixnum" (lambda () (%sos-write 12345)))
    (%sos-row "write-bignum" (lambda () (%sos-write *sos-bignum*)))
    (%sos-row "write-symbol" (lambda () (%sos-write *sos-symbol*)))
    (%sos-row "write-char" (lambda () (%sos-write *sos-char*)))
    (%sos-row "write-string" (lambda () (%sos-write *sos-s10*)))
    (%sos-row "write-escape-nil-string" %sos-write-escape-nil)
    (%sos-row "write-escape-t-string" %sos-write-escape-t)
    (%sos-row "write-base-16-fixnum" %sos-write-base-16-fixnum)
    (%sos-row "write-base-16-bignum" %sos-write-base-16-bignum)
    (%sos-row "write-radix-16-fixnum" %sos-write-radix-16-fixnum)
    (%sos-row "write-radix-16-bignum" %sos-write-radix-16-bignum)))
  nil)

(deftest-compiled-only string-output-stream-writes-allocation.formatting
  (%sos-failures
   (list
    (%sos-row "format-a-fixnum" %sos-format-a-fixnum)
    (%sos-row "format-a-string" %sos-format-a-string)
    (%sos-row "format-s-string" %sos-format-s-string)
    (%sos-row "format-d-fixnum" %sos-format-d-fixnum)
    (%sos-row "format-x-fixnum" %sos-format-x-fixnum)
    (%sos-row "format-b-fixnum" %sos-format-b-fixnum)
    (%sos-row "format-c-char" %sos-format-c-char)
    (%sos-row "format-percent" %sos-format-percent)
    (%sos-row "format-amp" %sos-format-amp)
    (%sos-row "format-tilde" %sos-format-tilde)
    (%sos-row "format-literal" %sos-format-literal)
    (%sos-row "format-constant" %sos-format-constant)
    (%sos-row "format-three" %sos-format-three)))
  nil)
