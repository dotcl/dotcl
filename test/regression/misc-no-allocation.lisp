;;; Small integer, short list and cheap string operations allocate only their result.

(defvar *mna-n* 10000)

(defun %mna-under (thunk budget)
  (funcall thunk)
  (< (min-allocated-bytes thunk 5) (* *mna-n* (+ budget 16))))

(defmacro %mna-def-int (name params decl form)
  (let ((acc (gensym "ACC")) (i (gensym "I")))
    `(defun ,name ,params
       ,@(when decl `((declare ,@decl)))
       (let ((,acc 0))
         (declare (fixnum ,acc))
         (dotimes (,i *mna-n*)
           (setq ,acc (logand (+ ,acc (the fixnum ,form)) #xffffff)))
         ,acc))))

(defmacro %mna-def-obj (name params decl form)
  (let ((acc (gensym "ACC")) (i (gensym "I")))
    `(defun ,name ,params
       ,@(when decl `((declare ,@decl)))
       (let ((,acc nil))
         (dotimes (,i *mna-n*) (setq ,acc ,form))
         ,acc))))

(%mna-def-int %mna-floor-decl (a b) (fixnum a b) (floor a b))
(%mna-def-int %mna-ceiling-decl (a b) (fixnum a b) (ceiling a b))
(%mna-def-int %mna-truncate-decl (a b) (fixnum a b) (truncate a b))
(%mna-def-int %mna-mod-decl (a b) (fixnum a b) (mod a b))
(%mna-def-int %mna-rem-decl (a b) (fixnum a b) (rem a b))
(%mna-def-int %mna-floor-plain (a b) nil (floor a b))
(%mna-def-int %mna-ceiling-plain (a b) nil (ceiling a b))
(%mna-def-int %mna-truncate-plain (a b) nil (truncate a b))
(%mna-def-int %mna-mod-plain (a b) nil (mod a b))
(%mna-def-int %mna-rem-plain (a b) nil (rem a b))
(%mna-def-int %mna-ash (a n) ((fixnum a) (fixnum n)) (ash a n))
(%mna-def-int %mna-logand (a b) (fixnum a b) (logand a b))
(%mna-def-int %mna-logior (a b) (fixnum a b) (logior a b))
(%mna-def-int %mna-logxor (a b) (fixnum a b) (logxor a b))
(%mna-def-int %mna-logcount (a) (fixnum a) (logcount a))
(%mna-def-int %mna-integer-length (a) (fixnum a) (integer-length a))
(%mna-def-int %mna-abs (a) (fixnum a) (abs a))
(%mna-def-int %mna-min (a b) (fixnum a b) (min a b))
(%mna-def-int %mna-max (a b) (fixnum a b) (max a b))
(%mna-def-int %mna-1+ (a) (fixnum a) (1+ a))
(%mna-def-int %mna-evenp (a) (fixnum a) (if (evenp a) 1 0))
(%mna-def-int %mna-zerop (a) (fixnum a) (if (zerop a) 1 0))

(%mna-def-obj %mna-member (k xs) ((fixnum k) list) (member k xs))
(%mna-def-obj %mna-assoc (k xs) ((fixnum k) list) (assoc k xs))
(%mna-def-obj %mna-reverse (xs) (list) (reverse xs))
(%mna-def-obj %mna-append (xs ys) (list list) (append xs ys))
(%mna-def-obj %mna-length (xs) (list) (the fixnum (length xs)))
(%mna-def-obj %mna-nreverse (xs) (list) (nreverse xs))
(%mna-def-obj %mna-last (xs) (list) (last xs))
(%mna-def-obj %mna-list* (a b c) (fixnum fixnum fixnum) (list* a b c))
(%mna-def-obj %mna-cons (a b) (fixnum fixnum) (cons a b))

(%mna-def-obj %mna-string= (a b) ((simple-string a) (simple-string b))
  (if (string= a b) 1 0))
(%mna-def-int %mna-char (s i) ((simple-string s) (fixnum i)) (char-code (char s i)))
(%mna-def-int %mna-schar (s i) ((simple-string s) (fixnum i)) (char-code (schar s i)))
(%mna-def-obj %mna-string-upcase (s) (simple-string) (string-upcase s))
(%mna-def-obj %mna-string-downcase (s) (simple-string) (string-downcase s))
(%mna-def-obj %mna-subseq (s) (simple-string) (subseq s 2 6))
(%mna-def-obj %mna-concatenate (a b) ((simple-string a) (simple-string b))
  (concatenate 'string a b))
(%mna-def-obj %mna-string< (a b) ((simple-string a) (simple-string b))
  (if (string< a b) 1 0))
(%mna-def-int %mna-char-upcase (c) (character) (char-code (char-upcase c)))

(defvar *mna-list* (loop for i below 10 collect (* i 3)))
(defvar *mna-list2* (loop for i below 5 collect i))
(defvar *mna-alist* (loop for i below 10 collect (cons (* i 3) i)))
(defvar *mna-string* "abcdefgh")
(defvar *mna-string2* "abcdefgi")
(defvar *mna-string-up* "ABCDEFGH")

(deftest-compiled-only misc-no-allocation.integers
  (let ((a 1000) (b 7) (shift 5))
    (every #'identity
           (list (%mna-under (lambda () (%mna-floor-decl a b)) 0)
                 (%mna-under (lambda () (%mna-ceiling-decl a b)) 0)
                 (%mna-under (lambda () (%mna-truncate-decl a b)) 0)
                 (%mna-under (lambda () (%mna-mod-decl a b)) 0)
                 (%mna-under (lambda () (%mna-rem-decl a b)) 0)
                 (%mna-under (lambda () (%mna-floor-plain a b)) 0)
                 (%mna-under (lambda () (%mna-ceiling-plain a b)) 0)
                 (%mna-under (lambda () (%mna-truncate-plain a b)) 0)
                 (%mna-under (lambda () (%mna-mod-plain a b)) 0)
                 (%mna-under (lambda () (%mna-rem-plain a b)) 0)
                 (%mna-under (lambda () (%mna-ash 3 shift)) 0)
                 (%mna-under (lambda () (%mna-logand a b)) 0)
                 (%mna-under (lambda () (%mna-logior a b)) 0)
                 (%mna-under (lambda () (%mna-logxor a b)) 0)
                 (%mna-under (lambda () (%mna-logcount a)) 0)
                 (%mna-under (lambda () (%mna-integer-length a)) 0)
                 (%mna-under (lambda () (%mna-abs a)) 0)
                 (%mna-under (lambda () (%mna-min a b)) 0)
                 (%mna-under (lambda () (%mna-max a b)) 0)
                 (%mna-under (lambda () (%mna-1+ a)) 0)
                 (%mna-under (lambda () (%mna-evenp a)) 0)
                 (%mna-under (lambda () (%mna-zerop a)) 0))))
  t)

(deftest-compiled-only misc-no-allocation.lists
  (every #'identity
         (list (%mna-under (lambda () (%mna-member 15 *mna-list*)) 0)
               (%mna-under (lambda () (%mna-assoc 15 *mna-alist*)) 0)
               (%mna-under (lambda () (%mna-reverse *mna-list*)) (* 32 (length *mna-list*)))
               (%mna-under (lambda () (%mna-append *mna-list* *mna-list2*))
                           (* 32 (length *mna-list*)))
               (%mna-under (lambda () (%mna-length *mna-list*)) 0)
               (%mna-under (lambda () (%mna-nreverse *mna-list*)) 0)
               (%mna-under (lambda () (%mna-last *mna-list*)) 0)
               (%mna-under (lambda () (%mna-list* 1 2 3)) 64)
               (%mna-under (lambda () (%mna-cons 1 2)) 32)))
  t)

(deftest-compiled-only misc-no-allocation.strings
  (every #'identity
         (list (%mna-under (lambda () (%mna-string= *mna-string* *mna-string2*)) 0)
               (%mna-under (lambda () (%mna-char *mna-string* 3)) 0)
               (%mna-under (lambda () (%mna-schar *mna-string* 3)) 0)
               (%mna-under (lambda () (%mna-string-upcase *mna-string*)) 72)
               (%mna-under (lambda () (%mna-string-downcase *mna-string-up*)) 72)
               (%mna-under (lambda () (%mna-subseq *mna-string*)) 64)
               (%mna-under (lambda () (%mna-concatenate *mna-string* *mna-string2*)) 88)
               (%mna-under (lambda () (%mna-string< *mna-string* *mna-string2*)) 0)
               (%mna-under (lambda () (%mna-char-upcase #\c)) 0)))
  t)

(deftest misc-no-allocation.designators
  (list (string-upcase 'abc)
        (string-downcase "ABC")
        (string-upcase "aBc")
        (string-upcase #\a)
        (concatenate 'string "ab" "cd")
        (concatenate 'simple-string "ab" "cd")
        (concatenate 'string "" "cd")
        (concatenate 'string '(#\a #\b) "cd"))
  ("ABC" "abc" "ABC" "A" "abcd" "abcd" "cd" "abcd"))
