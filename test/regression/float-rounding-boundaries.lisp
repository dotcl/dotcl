;;; Boundary cases for the float-rounding lanes: FLOOR / CEILING / TRUNCATE / ROUND and the
;;; F versions, MOD and REM, of declared doubles and singles with a divisor (negative, zero
;;; remainder, fraction, ratio, bignum), read as a value, in a sum, as multiple values, in a
;;; MULTIPLE-VALUE-BIND, with NTH-VALUE, and stored through SETF. The expected values are SBCL's.

(defun %frb-val (th)
  (handler-case (let ((r (multiple-value-list (funcall th)))) (if (cdr r) (cons :mv r) (car r)))
    (division-by-zero () :div0) (error () :error)))

