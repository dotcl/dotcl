(defun %fca-failures (rows)
  (let ((base (%fca-baseline)) (bad nil))
    (dolist (row rows (nreverse bad))
      (funcall (second row))
      (let ((got (min-allocated-bytes (second row) 5))
            (floor (third row)))
        (let ((per-call (/ (- got base) (float *fca-iterations*))))
          (when (> per-call (+ floor 16))
            (push (list (first row) per-call floor) bad)))))))

