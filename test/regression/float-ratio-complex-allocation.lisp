(defparameter *fca-thirty* 30)
(defparameter *fca-three* 3)
(defparameter *fca-two* 2)
(defparameter *fca-one* 1)

(defun %fca-d-add-d (a b)
  (declare (type double-float a b))
  (dotimes (i *fca-iterations*)
    (setq *sink* (+ a b)))
  *fca-sink*)

(defun %fca-d-add-u ()
  (dotimes (i *fca-iterations*)
