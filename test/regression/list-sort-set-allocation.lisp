(defun %lsa-baseline ()
  (min-allocated-bytes
   (lambda () (dotimes (i *lsa-it*) (setq *lsa-sink* nil)))
   5))

(defun %lsa-check (rows)
  (let ((base (%lsa-baseline)) (bad nil))
    (dolist (row rows (nreverse bad))
      (destructuring-bind (name budget setup fn) row
        (funcall fn)
        (when setup (funcall setup))
        (let* ((gross (min-allocated-bytes fn 5))
               (got (if setup (- gross (min-allocated-bytes setup 5))
                        (- gross base))))
          (when (> got (+ (* *lsa-it* budget) 16))
            (push (list name got budget) bad)))))))

(deftest-compiled-only list-sort-set-allocation.budget
  (%lsa-check *lsa-rows*)
  nil)

(defun %lsa-match (a b test test-not)
  (if test-not (not (funcall test-not a b)) (funcall test a b)))

(defun %lsa-member (item list test test-not key)
  (dolist (x list nil)
    (when (%lsa-match item (funcall key x) test test-not) (return t))))

(defun %lsa-member-rev (item list test test-not key)
  (dolist (x list nil)
    (when (%lsa-match (funcall key x) item test test-not) (return t))))

(defun %lsa-ref-union (l1 l2 test test-not key)
  (let ((result (copy-list l2)))
    (dolist (x l1 result)
      (unless (%lsa-member (funcall key x) l2 test test-not key)
        (push x result)))))

(defun %lsa-ref-intersection (l1 l2 test test-not key)
  (let ((result nil))
    (dolist (x l1 (nreverse result))
      (when (%lsa-member (funcall key x) l2 test test-not key)
        (push x result)))))

(defun %lsa-ref-difference (l1 l2 test test-not key)
  (let ((result nil))
    (dolist (x l1 (nreverse result))
      (unless (%lsa-member (funcall key x) l2 test test-not key)
        (push x result)))))

(defun %lsa-ref-xor (l1 l2 test test-not key)
  (let ((result nil))
    (dolist (x l1)
      (unless (%lsa-member (funcall key x) l2 test test-not key)
        (push x result)))
    (dolist (x l2)
      (unless (%lsa-member-rev (funcall key x) l1 test test-not key)
        (push x result)))
    result))

(defvar *lsa-seed* 20261114)

(defun %lsa-rand (n)
  (setq *lsa-seed* (mod (+ (* *lsa-seed* 1103515245) 12345) 2147483648))
  (mod (ash *lsa-seed* -16) n))

(defun %lsa-cases ()
  (let ((cases nil))
    (dotimes (i 30 (nreverse cases))
      (let ((l1 nil) (l2 nil))
        (dotimes (j (+ 1 (%lsa-rand 7))) (push (%lsa-rand 6) l1))
        (dotimes (j (+ 1 (%lsa-rand 7))) (push (%lsa-rand 6) l2))
        (push (list l1 l2) cases)))))

(deftest list-sort-set-allocation.set-ops-random
  (let ((bad nil))
    (labels ((chk (name actual expected)
               (unless (equal actual expected) (push name bad))))
      (dolist (case (%lsa-cases))
        (destructuring-bind (l1 l2) case
          (let ((p1 (mapcar (lambda (x) (cons x x)) l1))
                (p2 (mapcar (lambda (x) (cons x x)) l2))
                (s1 (mapcar #'princ-to-string l1))
                (s2 (mapcar #'princ-to-string l2)))
            (chk '(union) (union l1 l2) (%lsa-ref-union l1 l2 #'eql nil #'identity))
            (chk '(union :test equal) (union l1 l2 :test #'equal)
                 (%lsa-ref-union l1 l2 #'equal nil #'identity))
            (chk '(union :test string=) (union s1 s2 :test #'string=)
                 (%lsa-ref-union s1 s2 #'string= nil #'identity))
            (chk '(union :key car) (union p1 p2 :key #'car)
                 (%lsa-ref-union p1 p2 #'eql nil #'car))
            (chk '(nunion) (nunion (copy-list l1) (copy-list l2))
                 (%lsa-ref-union l1 l2 #'eql nil #'identity))
            (chk '(nunion :test equal) (nunion (copy-list l1) (copy-list l2) :test #'equal)
                 (%lsa-ref-union l1 l2 #'equal nil #'identity))
            (chk '(nunion :test string=) (nunion (copy-list s1) (copy-list s2) :test #'string=)
                 (%lsa-ref-union s1 s2 #'string= nil #'identity))
            (chk '(nunion :key car) (nunion (copy-list p1) (copy-list p2) :key #'car)
                 (%lsa-ref-union p1 p2 #'eql nil #'car))
            (chk '(intersection) (intersection l1 l2)
                 (%lsa-ref-intersection l1 l2 #'eql nil #'identity))
            (chk '(intersection :test equal) (intersection l1 l2 :test #'equal)
                 (%lsa-ref-intersection l1 l2 #'equal nil #'identity))
            (chk '(intersection :test string=) (intersection s1 s2 :test #'string=)
                 (%lsa-ref-intersection s1 s2 #'string= nil #'identity))
            (chk '(intersection :key car) (intersection p1 p2 :key #'car)
                 (%lsa-ref-intersection p1 p2 #'eql nil #'car))
            (chk '(nintersection) (nintersection (copy-list l1) (copy-list l2))
                 (%lsa-ref-intersection l1 l2 #'eql nil #'identity))
            (chk '(nintersection :test equal) (nintersection (copy-list l1) (copy-list l2) :test #'equal)
                 (%lsa-ref-intersection l1 l2 #'equal nil #'identity))
            (chk '(nintersection :test string=) (nintersection (copy-list s1) (copy-list s2) :test #'string=)
                 (%lsa-ref-intersection s1 s2 #'string= nil #'identity))
            (chk '(nintersection :key car) (nintersection (copy-list p1) (copy-list p2) :key #'car)
                 (%lsa-ref-intersection p1 p2 #'eql nil #'car))
            (chk '(set-difference) (set-difference l1 l2)
                 (%lsa-ref-difference l1 l2 #'eql nil #'identity))
            (chk '(set-difference :test equal) (set-difference l1 l2 :test #'equal)
                 (%lsa-ref-difference l1 l2 #'equal nil #'identity))
            (chk '(set-difference :test string=) (set-difference s1 s2 :test #'string=)
                 (%lsa-ref-difference s1 s2 #'string= nil #'identity))
            (chk '(set-difference :key car) (set-difference p1 p2 :key #'car)
                 (%lsa-ref-difference p1 p2 #'eql nil #'car))
            (chk '(nset-difference) (nset-difference (copy-list l1) (copy-list l2))
                 (%lsa-ref-difference l1 l2 #'eql nil #'identity))
            (chk '(nset-difference :test equal) (nset-difference (copy-list l1) (copy-list l2) :test #'equal)
                 (%lsa-ref-difference l1 l2 #'equal nil #'identity))
            (chk '(nset-difference :test string=) (nset-difference (copy-list s1) (copy-list s2) :test #'string=)
                 (%lsa-ref-difference s1 s2 #'string= nil #'identity))
            (chk '(nset-difference :key car) (nset-difference (copy-list p1) (copy-list p2) :key #'car)
                 (%lsa-ref-difference p1 p2 #'eql nil #'car))
            (chk '(set-exclusive-or) (set-exclusive-or l1 l2)
                 (%lsa-ref-xor l1 l2 #'eql nil #'identity))
            (chk '(set-exclusive-or :test equal) (set-exclusive-or l1 l2 :test #'equal)
                 (%lsa-ref-xor l1 l2 #'equal nil #'identity))
            (chk '(set-exclusive-or :test string=) (set-exclusive-or s1 s2 :test #'string=)
                 (%lsa-ref-xor s1 s2 #'string= nil #'identity))
            (chk '(set-exclusive-or :key car) (set-exclusive-or p1 p2 :key #'car)
                 (%lsa-ref-xor p1 p2 #'eql nil #'car))
            (chk '(nset-exclusive-or) (nset-exclusive-or (copy-list l1) (copy-list l2))
                 (%lsa-ref-xor l1 l2 #'eql nil #'identity))
            (chk '(nset-exclusive-or :test equal) (nset-exclusive-or (copy-list l1) (copy-list l2) :test #'equal)
                 (%lsa-ref-xor l1 l2 #'equal nil #'identity))
            (chk '(nset-exclusive-or :test string=) (nset-exclusive-or (copy-list s1) (copy-list s2) :test #'string=)
                 (%lsa-ref-xor s1 s2 #'string= nil #'identity))
            (chk '(nset-exclusive-or :key car) (nset-exclusive-or (copy-list p1) (copy-list p2) :key #'car)
                 (%lsa-ref-xor p1 p2 #'eql nil #'car)))))
      (nreverse bad)))
  nil)

(deftest list-sort-set-allocation.set-index-boundary
  (let ((l16 (loop for i below 16 collect i))
        (l17 (loop for i below 17 collect i))
        (l64 (loop for i below 64 collect i)))
    (list (subsetp '(0 15) l16 :test #'eql)
          (subsetp '(0 16) l17 :test #'eql)
          (subsetp '(0 17) l17 :test #'eql)
          (subsetp '(0 63) l64)
          (subsetp '(99) l64)))
  (t t nil t nil))

(deftest list-sort-set-allocation.set-index-hash-path
  (let ((a (loop for i below 64 collect i))
        (b (loop for i from 32 below 96 collect i)))
    (list (equal (union a b) (%lsa-ref-union a b #'eql nil #'identity))
          (equal (intersection a b) (%lsa-ref-intersection a b #'eql nil #'identity))
          (equal (set-difference a b) (%lsa-ref-difference a b #'eql nil #'identity))
          (equal (set-exclusive-or a b) (%lsa-ref-xor a b #'eql nil #'identity))
          (equal (union a b :test #'equal) (%lsa-ref-union a b #'equal nil #'identity))
          (equal (intersection a b :test #'equal) (%lsa-ref-intersection a b #'equal nil #'identity))
          (equal (set-difference a b :test #'equal) (%lsa-ref-difference a b #'equal nil #'identity))
          (equal (set-exclusive-or a b :test #'equal) (%lsa-ref-xor a b #'equal nil #'identity))))
  (t t t t t t t t))
