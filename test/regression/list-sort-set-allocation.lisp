;;; Allocation of the list set operations and the list builders against the
;;; cons floor. Allocation is asserted on emitted code only: the interpreter
;;; does not use the direct entries and shortcuts whose cost is measured here.

(defparameter *lsa-it* 1000)
(defparameter *lsa-sink* nil)
(defparameter *lsa-rows* nil)

(defparameter *lsa-l4* (list 1 2 3 4))
(defparameter *lsa-l4b* (list 3 4 5 6))
(defparameter *lsa-l8* (list 1 2 3 4 5 6 7 8))
(defparameter *lsa-l8b* (list 1 2 3 4 5 6 7 8))
(defparameter *lsa-l16* (loop for i below 16 collect i))
(defparameter *lsa-l16b* (loop for i below 16 collect (+ i 8)))
(defparameter *lsa-s8* (list 'a 'b 'c 'd 'e 'f 'g 'h))
(defparameter *lsa-s8b* (list 'e 'f 'g 'h 'i 'j 'k 'l))
(defparameter *lsa-str8* (list "a" "b" "c" "d" "e" "f" "g" "h"))
(defparameter *lsa-str8b* (list "e" "f" "g" "h" "i" "j" "k" "l"))
(defparameter *lsa-pairs8* (loop for s in *lsa-s8* for i from 1 collect (cons s i)))
(defparameter *lsa-pairs8b* (loop for s in *lsa-s8b* for i from 1 collect (cons s i)))
(defparameter *lsa-keys4* (list 'a 'b 'c 'd))
(defparameter *lsa-vals4* (list 1 2 3 4))
(defparameter *lsa-keys16* (loop for i below 16 collect i))
(defparameter *lsa-vals16* (loop for i below 16 collect (- i)))
(defparameter *lsa-alist4* (list (cons 'x 0) (cons 'y 0) (cons 'z 0) (cons 'w 0)))
(defparameter *lsa-alist16* (loop for i below 16 collect (cons i (- i))))
(defparameter *lsa-tail5* (nthcdr 5 *lsa-l8*))

(defun %lsa-copy-two-l4 ()
  (let ((x nil)) (dotimes (i *lsa-it*) (setq x (progn (copy-list *lsa-l4*) (copy-list *lsa-l4b*)))) x))
