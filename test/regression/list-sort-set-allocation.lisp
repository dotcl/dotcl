(defun %lsa-copy-l8 ()
  (let ((x nil)) (dotimes (i *lsa-it*) (setq x (copy-list *lsa-l8*))) x))

(defmacro lsa-row (name budget form)
  (let ((fn (gensym "ROW")))
    `(progn
       (defun ,fn () (let ((x nil)) (dotimes (i *lsa-it*) (setq x ,form)) x))
       (push (list ,name ,budget nil #',fn) *lsa-rows*))))

(defmacro lsa-drow (name budget setup form)
  (let ((fn (gensym "ROW")))
    `(progn
       (defun ,fn () (let ((x nil)) (dotimes (i *lsa-it*) (setq x ,form)) x))
       (push (list ,name ,budget ,setup #',fn) *lsa-rows*))))

