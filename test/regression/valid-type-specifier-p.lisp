(deftest valid-type-specifier-p.matches-sbcl
  (loop for (spec . expected) in *vts-table*
        unless (eq (dotcl:valid-type-specifier-p spec) expected)
          collect spec)
  nil)

(deftest valid-type-specifier-p.table-size
  (>= (length *vts-table*) 150)
  t)

;;; Where dotcl intentionally differs from SBCL.

(deftype vts-loop-a () 'vts-loop-a)
(deftype vts-loop-b () 'vts-loop-c)
(deftype vts-loop-c () '(or null vts-loop-b))

;; SBCL exhausts its control stack (or times out) on a self-referential DEFTYPE;
;; dotcl stops at a depth limit and answers NIL.
(deftest valid-type-specifier-p.self-referential-deftype
  (list (dotcl:valid-type-specifier-p 'vts-loop-a)
        (dotcl:valid-type-specifier-p 'vts-loop-b)
        (dotcl:valid-type-specifier-p '(or integer vts-loop-c)))
  (nil nil nil))

;; SBCL answers NIL for an astronomically large byte size; dotcl accepts any
;; positive integer.
(deftest valid-type-specifier-p.huge-byte-size
  (dotcl:valid-type-specifier-p '(unsigned-byte 100000000000000000000))
  t)

(deftest valid-type-specifier-p.class-object
  (list (dotcl:valid-type-specifier-p (find-class 'integer))
        (dotcl:valid-type-specifier-p (find-class 'vts-class)))
  (t t))

(deftest valid-type-specifier-p.non-specifier-objects
  (list (dotcl:valid-type-specifier-p #'car)
        (dotcl:valid-type-specifier-p (make-hash-table))
        (dotcl:valid-type-specifier-p #\a)
        (dotcl:valid-type-specifier-p (vector 1 2)))
  (nil nil nil nil))
