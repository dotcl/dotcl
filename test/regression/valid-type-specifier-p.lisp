(deftype vts-bad-exp () '(cons 1 2))
(deftype vts-signals-t () (error "x"))
(deftype vts-with-arg (n) `(integer 0 ,n))
(defstruct vts-point x y)
(define-condition vts-cond (error) ())
(defclass vts-class () ())

