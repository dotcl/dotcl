  (HANDLER-CASE (MULTIPLE-VALUE-LIST (INTEGER-DECODE-FLOAT (FLOAT 9007199254740992 1.0d0))) (ERROR (E) (TYPE-OF E)))
  (4503599627370496 1 1))

