;;; String trimming, bit fields, plists and symbol accessors, and double conversions
;;; stay within budget. These are statements about emitted code, so every allocation
;;; test is compiled-only.

(defvar *zatb-n* 10000)

(defun %zatb-under (thunk budget)
  (funcall thunk)
  (< (min-allocated-bytes thunk 5) (* *zatb-n* (+ budget 16))))

(defmacro %zatb-def-int (name params decl form)
  (let ((acc (gensym "ACC")) (i (gensym "I")))
    `(defun ,name ,params
       ,@(when decl `((declare ,@decl)))
       (let ((,acc 0))
         (declare (fixnum ,acc))
         (dotimes (,i *zatb-n*)
           (setq ,acc (logand (+ ,acc (the fixnum ,form)) #xffffff)))
         ,acc))))

(defmacro %zatb-def-double (name params decl form)
  (let ((acc (gensym "ACC")) (i (gensym "I")))
    `(defun ,name ,params
       ,@(when decl `((declare ,@decl)))
       (let ((,acc 0d0))
         (declare (double-float ,acc))
         (dotimes (,i *zatb-n*)
           (incf ,acc (the double-float ,form)))
         ,acc))))

(defmacro %zatb-def-obj (name params decl form)
  (let ((acc (gensym "ACC")) (i (gensym "I")))
    `(defun ,name ,params
       ,@(when decl `((declare ,@decl)))
       (let ((,acc nil))
         (dotimes (,i *zatb-n*) (setq ,acc ,form))
         ,acc))))

(defun %zatb-global2 (a b) (declare (fixnum a b)) (+ a b))

(defconstant +zatb-space-bag+ " ")
(defvar *zatb-two-sided* "  abcd  ")
(defvar *zatb-untrimmed* "abcdefgh")
(defvar *zatb-empty* "")
(defvar *zatb-all-space* "        ")
(defvar *zatb-sa* "abcdefgh")
(defvar *zatb-sb* "abcdefgi")
(defvar *zatb-sc* "ABCDEFGH")
(defvar *zatb-plist* (list :k 1 :j 2))
(defvar *zatb-sym* 'zero-alloc-trim-bits-plist-symbol)
(defvar *zatb-u64* #x123456789abc)
(defvar *zatb-u64b* #x0f0f0f0f0f0f)
(defvar *zatb-fn* #'%zatb-global2)
(defvar *zatb-args2* (list 1 2))
(defvar *zatb-d* 1.5d0)

(setf (symbol-value *zatb-sym*) 42
      (get *zatb-sym* :k) 7)

(defvar *zatb-closure0* nil)
(defvar *zatb-closure1* nil)
(defvar *zatb-closure2* nil)
(defvar *zatb-closure3* nil)
(let ((k 3))
  (setq *zatb-closure0* (lambda () k)
        *zatb-closure1* (lambda (a) (+ a k))
        *zatb-closure2* (lambda (a b) (+ a b k))
        *zatb-closure3* (lambda (a b c) (+ a b c k))))

;;; --- strings ---

(%zatb-def-obj %zatb-trim (s) ((simple-string s)) (string-trim " " s))
(%zatb-def-obj %zatb-trim-u (s) () (string-trim " " s))
(%zatb-def-obj %zatb-left-trim (s) ((simple-string s)) (string-left-trim " " s))
(%zatb-def-obj %zatb-left-trim-u (s) () (string-left-trim " " s))
(%zatb-def-obj %zatb-right-trim (s) ((simple-string s)) (string-right-trim " " s))
(%zatb-def-obj %zatb-right-trim-u (s) () (string-right-trim " " s))
(%zatb-def-obj %zatb-trim-list (s) ((simple-string s)) (string-trim '(#\Space) s))
(%zatb-def-obj %zatb-trim-constant (s) ((simple-string s))
  (string-trim +zatb-space-bag+ s))

(%zatb-def-int %zatb-string-equal (a b) ((simple-string a b))
  (if (string-equal a b) 1 0))
(%zatb-def-int %zatb-string-lessp (a b) ((simple-string a b))
  (if (string-lessp a b) 1 0))
(%zatb-def-int %zatb-string-not-equal (a b) ((simple-string a b))
  (or (string-not-equal a b) 0))
(%zatb-def-obj %zatb-string-string (s) ((simple-string s)) (string s))
(%zatb-def-obj %zatb-string-symbol (s) ((symbol s)) (string s))
(%zatb-def-obj %zatb-symbol-name (s) ((symbol s)) (symbol-name s))

;;; --- integers ---

(%zatb-def-int %zatb-logbitp (i n) ((fixnum i) (type (unsigned-byte 64) n))
  (if (logbitp i n) 1 0))
(%zatb-def-int %zatb-ldb-4 (n) ((type (unsigned-byte 64) n))
  (ldb (byte 8 4) n))
(%zatb-def-int %zatb-ldb-56 (n) ((type (unsigned-byte 64) n))
  (ldb (byte 8 56) n))
(%zatb-def-int %zatb-dpb (v n) ((fixnum v) (type (unsigned-byte 64) n))
  (dpb v (byte 8 4) n))
(%zatb-def-int %zatb-mask-field (n) ((type (unsigned-byte 64) n))
  (mask-field (byte 8 4) n))
(%zatb-def-int %zatb-deposit-field (v n) ((fixnum v) (type (unsigned-byte 64) n))
  (deposit-field v (byte 8 4) n))
(%zatb-def-obj %zatb-byte-constant () () (byte 8 4))
(%zatb-def-obj %zatb-byte-variable (s p) ((fixnum s p)) (byte s p))
(%zatb-def-int %zatb-logtest (a b) ((type (unsigned-byte 64) a b))
  (if (logtest a b) 1 0))
(%zatb-def-int %zatb-logandc1 (a b) ((type (unsigned-byte 64) a b))
  (logandc1 a b))
(%zatb-def-int %zatb-lognot (a) ((fixnum a)) (lognot a))
(%zatb-def-int %zatb-isqrt (a) ((fixnum a)) (isqrt a))
(%zatb-def-int %zatb-gcd (a b) ((fixnum a b)) (gcd a b))
(%zatb-def-int %zatb-lcm (a b) ((fixnum a b)) (lcm a b))
(%zatb-def-int %zatb-integer-length (n) ((type (unsigned-byte 64) n))
  (integer-length n))
(%zatb-def-int %zatb-logcount (n) ((type (unsigned-byte 64) n)) (logcount n))

;;; --- lists and symbols ---

(%zatb-def-obj %zatb-getf-hit (p) (list) (getf p :k))
(%zatb-def-obj %zatb-getf-miss (p) (list) (getf p :missing))
(%zatb-def-obj %zatb-get-hit (s) ((symbol s)) (get s :k))
(%zatb-def-obj %zatb-get-miss (s) ((symbol s)) (get s :missing))
(%zatb-def-obj %zatb-symbol-value (s) ((symbol s)) (symbol-value s))
(%zatb-def-int %zatb-boundp (s) ((symbol s)) (if (boundp s) 1 0))
(%zatb-def-int %zatb-fboundp (s) ((symbol s)) (if (fboundp s) 1 0))
(%zatb-def-obj %zatb-symbol-function (s) ((symbol s)) (symbol-function s))

(%zatb-def-int %zatb-funcall-global (fn a b) ((type function fn) (fixnum a b))
  (funcall fn a b))
(%zatb-def-int %zatb-funcall-closure0 (fn) ((type function fn)) (funcall fn))
(%zatb-def-int %zatb-funcall-closure1 (fn a) ((type function fn) (fixnum a))
  (funcall fn a))
(%zatb-def-int %zatb-funcall-closure2 (fn a b) ((type function fn) (fixnum a b))
  (funcall fn a b))
(%zatb-def-int %zatb-funcall-closure3 (fn a b c) ((type function fn) (fixnum a b c))
  (funcall fn a b c))
(%zatb-def-int %zatb-apply2 (fn args) ((type function fn) (list args))
  (apply fn args))

(%zatb-def-int %zatb-mvbind (a b) ((fixnum a b))
  (multiple-value-bind (x y) (values a b) (+ x y)))
(%zatb-def-int %zatb-nth-value (a b) ((fixnum a b)) (nth-value 1 (floor a b)))

;;; --- doubles ---

(%zatb-def-double %zatb-float (n) ((fixnum n)) (float n 1d0))
(%zatb-def-int %zatb-truncate (d) ((double-float d)) (truncate d))
(%zatb-def-int %zatb-round (d) ((double-float d)) (round d))
(%zatb-def-int %zatb-floor (d) ((double-float d)) (floor d))
(%zatb-def-int %zatb-ceiling (d) ((double-float d)) (ceiling d))
(%zatb-def-double %zatb-ffloor (d) ((double-float d)) (ffloor d))
(%zatb-def-double %zatb-sqrt (d) ((double-float d)) (sqrt d))
(%zatb-def-double %zatb-abs (d) ((double-float d)) (abs d))
(%zatb-def-double %zatb-expt-double (d) ((double-float d)) (expt d 2))
(%zatb-def-int %zatb-expt-fixnum (n) ((fixnum n)) (expt n 2))
(%zatb-def-double %zatb-coerce (n) ((fixnum n)) (coerce n 'double-float))

(deftest-compiled-only zero-alloc-trim-bits-plist.strings
  (every #'identity
         (list
          (%zatb-under (lambda () (%zatb-trim *zatb-two-sided*)) 64)
          (%zatb-under (lambda () (%zatb-trim-u *zatb-two-sided*)) 64)
          (%zatb-under (lambda () (%zatb-left-trim *zatb-two-sided*)) 72)
          (%zatb-under (lambda () (%zatb-left-trim-u *zatb-two-sided*)) 72)
          (%zatb-under (lambda () (%zatb-right-trim *zatb-two-sided*)) 72)
          (%zatb-under (lambda () (%zatb-right-trim-u *zatb-two-sided*)) 72)
          (%zatb-under (lambda () (%zatb-trim-list *zatb-two-sided*)) 64)
          (%zatb-under (lambda () (%zatb-trim-constant *zatb-two-sided*)) 64)
          (%zatb-under (lambda () (%zatb-trim *zatb-untrimmed*)) 0)
          (%zatb-under (lambda () (%zatb-trim-u *zatb-untrimmed*)) 0)
          (%zatb-under (lambda () (%zatb-trim-list *zatb-untrimmed*)) 0)
          (%zatb-under (lambda () (%zatb-trim *zatb-empty*)) 0)
          (%zatb-under (lambda () (%zatb-trim *zatb-all-space*)) 32)
          (%zatb-under (lambda () (%zatb-string-equal *zatb-sa* *zatb-sb*)) 0)
          (%zatb-under (lambda () (%zatb-string-lessp *zatb-sa* *zatb-sb*)) 0)
          (%zatb-under (lambda () (%zatb-string-not-equal *zatb-sa* *zatb-sc*)) 0)
          (%zatb-under (lambda () (%zatb-string-string *zatb-sa*)) 0)
          (%zatb-under (lambda () (%zatb-string-symbol 'foo)) 0)
          (%zatb-under (lambda () (%zatb-symbol-name 'foo)) 0)))
  t)

(deftest-compiled-only zero-alloc-trim-bits-plist.integers
  (every #'identity
         (list
          (%zatb-under (lambda () (%zatb-logbitp 5 *zatb-u64*)) 0)
          (%zatb-under (lambda () (%zatb-ldb-4 *zatb-u64*)) 0)
          (%zatb-under (lambda () (%zatb-ldb-56 *zatb-u64*)) 0)
          (%zatb-under (lambda () (%zatb-dpb 3 *zatb-u64*)) 24)
          (%zatb-under (lambda () (%zatb-mask-field *zatb-u64*)) 0)
          (%zatb-under (lambda () (%zatb-deposit-field 3 *zatb-u64*)) 24)
          (%zatb-under (lambda () (%zatb-byte-constant)) 32)
          (%zatb-under (lambda () (%zatb-byte-variable 8 4)) 32)
          (%zatb-under (lambda () (%zatb-logtest *zatb-u64* *zatb-u64b*)) 0)
          (%zatb-under (lambda () (%zatb-logandc1 *zatb-u64* *zatb-u64b*)) 24)
          (%zatb-under (lambda () (%zatb-lognot 12345)) 0)
          (%zatb-under (lambda () (%zatb-isqrt *zatb-u64*)) 0)
          (%zatb-under (lambda () (%zatb-gcd 123456 7890)) 0)
          (%zatb-under (lambda () (%zatb-lcm 123456 7890)) 24)
          (%zatb-under (lambda () (%zatb-integer-length *zatb-u64*)) 0)
          (%zatb-under (lambda () (%zatb-logcount *zatb-u64*)) 0)))
  t)

(deftest-compiled-only zero-alloc-trim-bits-plist.lists-and-symbols
  (every #'identity
         (list
          (%zatb-under (lambda () (%zatb-getf-hit *zatb-plist*)) 0)
          (%zatb-under (lambda () (%zatb-getf-miss *zatb-plist*)) 0)
          (%zatb-under (lambda () (%zatb-get-hit *zatb-sym*)) 0)
          (%zatb-under (lambda () (%zatb-get-miss *zatb-sym*)) 0)
          (%zatb-under (lambda () (%zatb-symbol-value *zatb-sym*)) 0)
          (%zatb-under (lambda () (%zatb-boundp *zatb-sym*)) 0)
          (%zatb-under (lambda () (%zatb-fboundp 'car)) 0)
          (%zatb-under (lambda () (%zatb-symbol-function 'car)) 0)
          (%zatb-under (lambda () (%zatb-funcall-global *zatb-fn* 3 4)) 0)
          (%zatb-under (lambda () (%zatb-funcall-closure0 *zatb-closure0*)) 0)
          (%zatb-under (lambda () (%zatb-funcall-closure1 *zatb-closure1* 3)) 0)
          (%zatb-under (lambda () (%zatb-funcall-closure2 *zatb-closure2* 3 4)) 0)
          (%zatb-under (lambda () (%zatb-funcall-closure3 *zatb-closure3* 3 4 5)) 0)
          (%zatb-under (lambda () (%zatb-apply2 *zatb-fn* *zatb-args2*)) 0)
          (%zatb-under (lambda () (%zatb-mvbind 3 4)) 0)
          (%zatb-under (lambda () (%zatb-nth-value 17 5)) 0)))
  t)

(deftest-compiled-only zero-alloc-trim-bits-plist.doubles
  (every #'identity
         (list
          (%zatb-under (lambda () (%zatb-float 7)) 0)
          (%zatb-under (lambda () (%zatb-truncate *zatb-d*)) 0)
          (%zatb-under (lambda () (%zatb-round *zatb-d*)) 0)
          (%zatb-under (lambda () (%zatb-floor *zatb-d*)) 0)
          (%zatb-under (lambda () (%zatb-ceiling *zatb-d*)) 0)
          (%zatb-under (lambda () (%zatb-ffloor *zatb-d*)) 0)
          (%zatb-under (lambda () (%zatb-sqrt *zatb-d*)) 0)
          (%zatb-under (lambda () (%zatb-abs *zatb-d*)) 0)
          (%zatb-under (lambda () (%zatb-expt-double *zatb-d*)) 0)
          (%zatb-under (lambda () (%zatb-expt-fixnum 7)) 0)
          (%zatb-under (lambda () (%zatb-coerce 7)) 0)))
  t)

(deftest zero-alloc-trim-bits-plist.trim-values
  (list (string-trim " " *zatb-two-sided*)
        (string-left-trim " " *zatb-two-sided*)
        (string-right-trim " " *zatb-two-sided*)
        (string-trim '(#\Space) *zatb-two-sided*)
        (string-trim +zatb-space-bag+ *zatb-two-sided*)
        (string-trim " " *zatb-all-space*)
        (string-trim "" "  abc  "))
  ("abcd" "abcd  " "  abcd" "abcd" "abcd" "" "  abc  "))

(deftest zero-alloc-trim-bits-plist.trim-shares-an-untrimmed-string
  (list (eq (string-trim " " *zatb-untrimmed*) *zatb-untrimmed*)
        (eq (string-left-trim " " *zatb-untrimmed*) *zatb-untrimmed*)
        (eq (string-right-trim " " *zatb-untrimmed*) *zatb-untrimmed*)
        (eq (string-trim '(#\Space) *zatb-untrimmed*) *zatb-untrimmed*)
        (eq (string-trim " " *zatb-empty*) *zatb-empty*)
        (eq (string-trim " " 'zero-alloc-trim-bits-plist-symbol)
            (symbol-name 'zero-alloc-trim-bits-plist-symbol)))
  (t t t t t t))

(deftest zero-alloc-trim-bits-plist.bit-field-values
  (let ((n #x123456789abc))
    (list (ldb (byte 8 4) n)
          (ldb (byte 8 56) n)
          (mask-field (byte 8 4) n)
          (dpb 3 (byte 8 4) n)
          (deposit-field 3 (byte 8 4) n)
          (logbitp 5 n)
          (logcount n)
          (integer-length n)
          (integer-length 0)
          (integer-length -1)
          (integer-length -16)))
  (171 0 2736 20015998341180 20015998341132 t 22 45 0 0 4))

(deftest zero-alloc-trim-bits-plist.double-values
  (list (expt 1.5d0 2)
        (sqrt 2.25d0)
        (abs -1.5d0)
        (float 7 1d0)
        (coerce 7 'double-float))
  (2.25d0 1.5d0 1.5d0 7.0d0 7.0d0))
