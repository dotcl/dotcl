;;; regression: skip-under-interp
;;; The reading-only sequence functions must not allocate for a simple vector,
;;; a fixnum array, a simple string or a list with a plain :TEST or none.
;;; Allocation is asserted only on emitted code, so these tests are compiled-only:
;;; the interpreter does not use the direct entries whose cost is measured here.

(defparameter *sa-sink* nil)

(defparameter *sa-sv* (vector 1 2 3 4 5 6 7 8))
(defparameter *sa-fv* (make-array 8 :element-type 'fixnum :initial-contents '(1 2 3 4 5 6 7 8)))
(defparameter *sa-ss* "abcdefgh")
(defparameter *sa-lst* (list 1 2 3 4 5 6 7 8))
(defparameter *sa-alist* (list (cons 1 'a) (cons 2 'b) (cons 3 'c) (cons 4 'd)
                               (cons 5 'e) (cons 6 'f) (cons 7 'g) (cons 8 'h)))
(defparameter *sa-svf* (vector 1 2 3 4 5 6 7 8))
(defparameter *sa-fvf* (make-array 8 :element-type 'fixnum :initial-contents '(1 2 3 4 5 6 7 8)))
(defparameter *sa-ssf* "abcdefgh")
(defparameter *sa-lstf* (list 1 2 3 4 5 6 7 8))
(defparameter *sa-svr* (vector 1 2 3 4 5 6 7 8))
(defparameter *sa-fvr* (make-array 8 :element-type 'fixnum :initial-contents '(1 2 3 4 5 6 7 8)))
(defparameter *sa-ssr* "abcdefgh")
(defparameter *sa-lstr* (list 1 2 3 4 5 6 7 8))
(defparameter *sa-lstn* (list 1 2 3 4 5 6 7 8))
(defparameter *sa-svn* (vector 1 2 3 4 5 6 7 8))

(defun %sa-always (x) (declare (ignore x)) t)
(defun %sa-never (x) (declare (ignore x)) nil)
(defun %sa-last (a b) (declare (ignore a)) b)

(defun %sa-baseline ()
  (min-allocated-bytes (lambda ()
                         (dotimes (%i 1000) (setq *sa-sink* nil)))
                       5))

(defun %sa-failures (rows)
  (let ((base (%sa-baseline)) (bad nil))
    (dolist (row rows (nreverse bad))
      (funcall (cdr row))
      (let ((got (min-allocated-bytes (cdr row) 5)))
        (when (> got base) (push (list (car row) got base) bad))))))

(defmacro %sa-row (label form)
  `(cons ,label (lambda () (dotimes (%i 1000) (setq *sa-sink* ,form)))))

(deftest-compiled-only sequence-allocation.scalars
  (%sa-failures
   (list
    (%sa-row "length/simple-vector" (length *sa-sv*))
    (%sa-row "length/fixnum-array" (length *sa-fv*))
    (%sa-row "length/simple-string" (length *sa-ss*))
    (%sa-row "length/list" (length *sa-lst*))
    (%sa-row "elt/simple-vector" (elt *sa-sv* 3))
    (%sa-row "elt/fixnum-array" (elt *sa-fv* 3))
    (%sa-row "elt/simple-string" (elt *sa-ss* 3))
    (%sa-row "elt/list" (elt *sa-lst* 3))
    (%sa-row "string=/simple-string" (string= *sa-ss* *sa-ss*))
    (%sa-row "string=/simple-string:start1" (string= *sa-ss* *sa-ss* :start1 1))
    (%sa-row "string=/simple-string:end1" (string= *sa-ss* *sa-ss* :end1 5))
    (%sa-row "char/simple-string" (char *sa-ss* 3))
    (%sa-row "schar/simple-string" (schar *sa-ss* 3))
    (%sa-row "aref/simple-vector" (aref *sa-sv* 3))
    (%sa-row "aref/fixnum-array" (aref *sa-fv* 3))
    (%sa-row "aref/simple-string" (aref *sa-ss* 3))
   ))
  nil)

