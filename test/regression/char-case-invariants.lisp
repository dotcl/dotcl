;;; CLHS 13.1.4.3 case pairs and the string/alphanumeric counterparts, over the BMP.

(defun %char-case-invariants ()
  (let ((failures '())
        (lower-to-upper (make-hash-table :test #'eql))
        (upper-to-lower (make-hash-table :test #'eql)))
    (flet ((fail (code what)
             (when (< (length failures) 40)
               (push (list code what) failures))))
      (dotimes (code 65536)
        (let* ((c (code-char code))
               (u? (upper-case-p c))
               (l? (lower-case-p c))
               (b? (both-case-p c))
               (up (char-upcase c))
               (dn (char-downcase c))
               (s (string c)))
          (unless (eq b? (or u? l?)) (fail code :both-case))
          (unless (or (not b?) (alpha-char-p c)) (fail code :case-not-alpha))
          (if b?
              (progn
                (when l? (unless (char= (char-downcase up) c) (fail code :down-up)))
                (when u? (unless (char= (char-upcase dn) c) (fail code :up-down))))
              (unless (and (char= up c) (char= dn c)) (fail code :case-less-identity)))
          (when l?
            (unless (and (not (char= up c)) (upper-case-p up) (char= dn c))
              (fail code :lower-pair)))
          (when u?
            (unless (and (not (char= dn c)) (lower-case-p dn) (char= up c))
              (fail code :upper-pair)))
          (unless (char-equal c up) (fail code :char-equal-upcase))
          (unless (char-equal c dn) (fail code :char-equal-downcase))
          (unless (char= (char (string-upcase s) 0) up) (fail code :string-upcase))
          (unless (char= (char (string-downcase s) 0) dn) (fail code :string-downcase))
          (unless (char= (char (string-capitalize s) 0) (if b? up c))
            (fail code :string-capitalize))
          (unless (char= (char (nstring-upcase (copy-seq s)) 0) up)
            (fail code :nstring-upcase))
          (unless (char= (char (nstring-downcase (copy-seq s)) 0) dn)
            (fail code :nstring-downcase))
          (unless (char= (char (nstring-capitalize (copy-seq s)) 0) (if b? up c))
            (fail code :nstring-capitalize))
          (unless (eq (not (null (alphanumericp c)))
                      (not (null (or (alpha-char-p c) (digit-char-p c)))))
            (fail code :alphanumericp))
          (when l?
            (when (gethash (char-code up) lower-to-upper) (fail code :lower-collision))
            (setf (gethash (char-code up) lower-to-upper) t))
          (when u?
            (when (gethash (char-code dn) upper-to-lower) (fail code :upper-collision))
            (setf (gethash (char-code dn) upper-to-lower) t)))))
    (nreverse failures)))

(deftest char-case-invariants.bmp
  (%char-case-invariants)
  nil)

(deftest char-case-invariants.reported-characters
  (list (lower-case-p (code-char #xDF))
        (char= (char-upcase (code-char #xDF))
               (code-char #xDF))
        (upper-case-p (code-char #x130))
        (char= (char-downcase (code-char #x130)) (code-char #x130))
        (char-code (char-upcase (code-char #x3C2)))
        (char-code (char-downcase (char-upcase (code-char #x3C2))))
        (char-code (char-downcase (code-char #x212A)))
        (char-code (char (string-upcase (string (code-char #x2170))) 0))
        (char-code (char (string-upcase (string (code-char #x24D0))) 0))
        (char-code (char (string-upcase (string (code-char #x01C5))) 0))
        (char-equal (code-char #x212A) (char-downcase (code-char #x212A)))
        (char-equal (code-char #x1E9E) (char-downcase (code-char #x1E9E)))
        (alphanumericp (code-char #x0661))
        (digit-char-p (code-char #x0661)))
  (nil t nil t #x3C2 #x3C2 #x212A #x2170 #x24D0 #x01C5 t t nil nil))

(deftest char-case-invariants.ascii-and-equalp
  (let ((h (make-hash-table :test 'equalp)))
    (setf (gethash (code-char #x212A) h) :kelvin
          (gethash #\k h) :k)
    (list (char-upcase #\a) (char-downcase #\A)
          (upper-case-p #\A) (lower-case-p #\a) (both-case-p #\a)
          (string-upcase "aBc") (string-downcase "AbC")
          (string-capitalize "hELLO wORLD")
          (string-equal (string (code-char #x212A)) "k")
          (equalp (string (code-char #x212A)) "k")
          (gethash (code-char #x212A) h) (gethash #\k h)
          (hash-table-count h)))
  (#\A #\a t t t "ABC" "abc" "Hello World" nil nil :kelvin :k 2))
