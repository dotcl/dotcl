(defun %ffw-mismatches ()
  (loop for (ctl val expected) in *ffw-table*
        for got = (handler-case (format nil ctl val) (error (e) (type-of e)))
        unless (equal got expected) collect (list ctl val expected got)))

(deftest format-fixed-width-only.sbcl-table
  (%ffw-mismatches)
  nil)

(deftest format-fixed-width-only.the-two-reported
  (list (format nil "~3,,2,,F" 0.5d0) (format nil "~3,,2,'*,F" 0.5d0)
        (format nil "~4,,2,,F" 0.5d0) (format nil "~2,,2,'*,F" 0.5d0)
        (format nil "~5,,0,,F" -0.5d0) (format nil "~4,,0,,F" -0.5d0) (format nil "~3,,0,'*,F" -0.5d0))
  ("50." "50." "50.0" "**" " -0.5" "-0.5" "-.5"))

;; A value whose shortest digits end in a tie reads as that tie, but its binary value is on one side
;; of it: 9.95d0 is 9.949999..., so at width 3 it is "9.9", not a carry into "10." or an extra digit
;; (the answers are SBCL's).
(deftest format-fixed-width-only.tie-in-the-shortest-digits
  (let ((*read-default-float-format* 'double-float))
    (list (format nil "~3F" 9.95d0) (format nil "~4F" 9.95d0) (format nil "~3F" 9.9d0)
          (format nil "~3F" 0.995d0) (format nil "~4F" 0.995d0) (format nil "~4,,1F" 9.95d0)))
  ("9.9" "9.95" "9.9" ".99" ".995" "99.5"))

;; The suite's expectations for a width that is too short and no scale factor (FORMAT.F.5, .8,
;; .45, .46): the zero after the point stays, and a value with no integer digit prints ".0".
(deftest format-fixed-width-only.suite-expectations-without-a-scale-factor
  (list (format nil "~2f" 1.0d0) (format nil "~3@F" 1.0d0) (format nil "~2f ~2f" 1.1d0 1.9d0)
        (format nil "~2f ~1f ~0f" 0.01d0 0.01d0 0.01d0)
        (format nil "~3,,2,,F" 0.5d0) (format nil "~1,,2,,F" 0.5d0))
  ("1.0" "+1.0" "1.0 2.0" ".0 .0 .0" "50." "50."))

;; A width of 0 or 1 with no d: a value of 0.1 or more keeps its shortest digits (as SBCL does);
;; only a value below 0.1 prints ".0" (FORMAT.F.46 needs that for 0.01).
(deftest format-fixed-width-only.below-one-keeps-digits
  (list (format nil "~1F" 0.1d0) (format nil "~1F" 0.25d0) (format nil "~0F" 1/3)
        (format nil "~1F" -0.1d0) (format nil "~1F" 0.01d0) (format nil "~0F" 0.5d0))
  (".1" ".25" ".33333334" "-.1" ".0" ".5"))
