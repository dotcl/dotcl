;;; Right shifts by a constant of 64 or more, and LDB at positions from 64 up,
;;; on integers that are not in [0, 2^64). The 64-bit lane computes (ash x -k)
;;; with the count capped at 64 (every larger shift gives 0 there) and falls
;;; back to the generic ASH when X is outside the lane; the fallback used the
;;; capped count, so (ash (expt 2 127) -120) gave 2^63 and
;;; (ldb (byte 8 120) x) gave 0. The expected values are SBCL 2.6.8's.
;;; Operands avoid the fixnum bounds, which differ between implementations.

(defun %ush-ash-r0 (x) (ash x 0))
(defun %ush-ash-r1 (x) (ash x -1))
(defun %ush-ash-r63 (x) (ash x -63))
(defun %ush-ash-r64 (x) (ash x -64))
(defun %ush-ash-r65 (x) (ash x -65))
(defun %ush-ash-r100 (x) (ash x -100))
(defun %ush-ash-r120 (x) (ash x -120))
(defun %ush-ash-r127 (x) (ash x -127))
(defun %ush-ash-r128 (x) (ash x -128))
(defun %ush-ash-r200 (x) (ash x -200))
(defun %ush-ash-r1000 (x) (ash x -1000))
(defun %ush-ldb-8-0 (x) (ldb (byte 8 0) x))
(defun %ush-ldb-8-60 (x) (ldb (byte 8 60) x))
(defun %ush-ldb-8-63 (x) (ldb (byte 8 63) x))
(defun %ush-ldb-8-64 (x) (ldb (byte 8 64) x))
(defun %ush-ldb-8-65 (x) (ldb (byte 8 65) x))
(defun %ush-ldb-32-96 (x) (ldb (byte 32 96) x))
(defun %ush-ldb-16-80 (x) (ldb (byte 16 80) x))
(defun %ush-ldb-8-120 (x) (ldb (byte 8 120) x))
(defun %ush-ldb-64-64 (x) (ldb (byte 64 64) x))
(defun %ush-ldb-64-100 (x) (ldb (byte 64 100) x))
(defun %ush-ldb-8-200 (x) (ldb (byte 8 200) x))
(defun %ush-and-r64 (x) (logand (ash x -64) #xff))
(defun %ush-and-r100 (x) (logand (ash x -100) #xff))
(defun %ush-and-r120 (x) (logand (ash x -120) #xff))
(defun %ush-u64-r1 (x) (ash (logand x #xffffffffffffffff) -1))
(defun %ush-u64-r63 (x) (ash (logand x #xffffffffffffffff) -63))
(defun %ush-u64-r64 (x) (ash (logand x #xffffffffffffffff) -64))
(defun %ush-u64-r65 (x) (ash (logand x #xffffffffffffffff) -65))
(defun %ush-u64-r100 (x) (ash (logand x #xffffffffffffffff) -100))
(defun %ush-ash-var (x k) (ash x k))
(defun %ush-ash-var64 (x k) (declare (type (integer -64 0) k)) (ash x k))

(defparameter *ush-xs* (list 0 1 -1 -5 12345 (expt 2 61) (- (expt 2 61)) (expt 2 62) (1- (expt 2 63)) (expt 2 63) (1- (expt 2 64)) (expt 2 64) (1+ (expt 2 64)) (expt 2 127) (+ (expt 2 200) 12345) (- (expt 2 127)) (- -1 (expt 2 64)) (- (expt 3 90))))
(defparameter *ush-fns* '(%ush-ash-r0 %ush-ash-r1 %ush-ash-r63 %ush-ash-r64 %ush-ash-r65 %ush-ash-r100 %ush-ash-r120 %ush-ash-r127 %ush-ash-r128 %ush-ash-r200 %ush-ash-r1000 %ush-ldb-8-0 %ush-ldb-8-60 %ush-ldb-8-63 %ush-ldb-8-64 %ush-ldb-8-65 %ush-ldb-32-96 %ush-ldb-16-80 %ush-ldb-8-120 %ush-ldb-64-64 %ush-ldb-64-100 %ush-ldb-8-200 %ush-and-r64 %ush-and-r100 %ush-and-r120 %ush-u64-r1 %ush-u64-r63 %ush-u64-r64 %ush-u64-r65 %ush-u64-r100))

(deftest unsigned-shift-past-64
  (list (loop for f in *ush-fns* collect (mapcar (symbol-function f) *ush-xs*))
        (loop for k in '(-1 -63 -64 -65 -100 -127 -128 -200)
              collect (mapcar (lambda (x) (%ush-ash-var x k)) *ush-xs*))
        (loop for k in '(-1 -63 -64)
              collect (mapcar (lambda (x) (%ush-ash-var64 x k)) *ush-xs*))
        (mapcar (lambda (x) (ash x (- (expt 2 70)))) *ush-xs*))
