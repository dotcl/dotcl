;;; Three levels of :before / :after methods on INITIALIZE-INSTANCE and SHARED-INITIALIZE, and changes to
;;; the middle level and to the class precedence list of an already planned class, one step after the
;;; other. The expected value is SBCL's.

(defvar *cpl-log* nil)
(defclass cpl-1 () ((a :initarg :a :initform 1)))
(defclass cpl-2 (cpl-1) ((b :initarg :b :initform 2)))
(defclass cpl-3 (cpl-2) ((c :initarg :c :initform 3)))
(defclass cpl-9 () ())
(defmethod initialize-instance :before ((o cpl-1) &key &allow-other-keys) (push :ii-b-1 *cpl-log*))
(defmethod initialize-instance :before ((o cpl-2) &key &allow-other-keys) (push :ii-b-2 *cpl-log*))
(defmethod initialize-instance :before ((o cpl-3) &key &allow-other-keys) (push :ii-b-3 *cpl-log*))
(defmethod initialize-instance :after ((o cpl-1) &key &allow-other-keys) (push :ii-a-1 *cpl-log*))
(defmethod initialize-instance :after ((o cpl-2) &key &allow-other-keys) (push :ii-a-2 *cpl-log*))
(defmethod initialize-instance :after ((o cpl-3) &key &allow-other-keys) (push :ii-a-3 *cpl-log*))
(defmethod shared-initialize :before ((o cpl-1) slot-names &key &allow-other-keys) (push :si-b-1 *cpl-log*))
(defmethod shared-initialize :before ((o cpl-3) slot-names &key &allow-other-keys) (push :si-b-3 *cpl-log*))
(defmethod shared-initialize :after ((o cpl-2) slot-names &key &allow-other-keys) (push :si-a-2 *cpl-log*))
(defun cpl-mk (c &rest args) (setq *cpl-log* nil) (apply #'make-instance c args) (reverse *cpl-log*))
(defun cpl-3x (c &rest args) (let (r) (dotimes (i 3) (setq r (apply #'cpl-mk c args))) r))

(deftest ctor-plan-levels.steps
  (list
   (list :three-levels (cpl-3x 'cpl-1 :a 1) (cpl-3x 'cpl-2) (cpl-3x 'cpl-3 :c 4))
   (progn (defmethod initialize-instance :before ((o cpl-2) &key z &allow-other-keys)
            (declare (ignore z)) (push :ii-b-2-late *cpl-log*))
          (list :middle-added (cpl-3x 'cpl-3)))
   (progn (remove-method #'initialize-instance
                         (find-method #'initialize-instance '(:before) (list (find-class 'cpl-2))))
          (list :middle-removed (cpl-3x 'cpl-3)))
   (progn (eval '(defclass cpl-3 (cpl-9) ((c :initarg :c :initform 3))))
          (list :cpl-changed (cpl-3x 'cpl-3 :c 1)))
   (progn (eval '(defclass cpl-3 (cpl-2) ((c :initarg :c :initform 3))))
          (list :cpl-back (cpl-3x 'cpl-3 :c 1)))
   (progn (defmethod initialize-instance :before ((o cpl-9) &key &allow-other-keys) (push :ii-b-9 *cpl-log*))
          (list :before-on-unrelated (cpl-3x 'cpl-1) (cpl-3x 'cpl-3)))
   (progn (eval '(defclass cpl-1 (cpl-9) ((a :initarg :a :initform 1))))
          (list :superclass-gained (cpl-3x 'cpl-1) (cpl-3x 'cpl-3))))
  ((:three-levels (:ii-b-1 :si-b-1 :ii-a-1)
    (:ii-b-2 :ii-b-1 :si-b-1 :si-a-2 :ii-a-1 :ii-a-2)
    (:ii-b-3 :ii-b-2 :ii-b-1 :si-b-3 :si-b-1 :si-a-2 :ii-a-1 :ii-a-2 :ii-a-3))
   (:middle-added (:ii-b-3 :ii-b-2-late :ii-b-1 :si-b-3 :si-b-1 :si-a-2 :ii-a-1 :ii-a-2 :ii-a-3))
   (:middle-removed (:ii-b-3 :ii-b-1 :si-b-3 :si-b-1 :si-a-2 :ii-a-1 :ii-a-2 :ii-a-3))
   (:cpl-changed (:ii-b-3 :si-b-3 :ii-a-3))
   (:cpl-back (:ii-b-3 :ii-b-1 :si-b-3 :si-b-1 :si-a-2 :ii-a-1 :ii-a-2 :ii-a-3))
   (:before-on-unrelated (:ii-b-1 :si-b-1 :ii-a-1)
    (:ii-b-3 :ii-b-1 :si-b-3 :si-b-1 :si-a-2 :ii-a-1 :ii-a-2 :ii-a-3))
   (:superclass-gained (:ii-b-1 :ii-b-9 :si-b-1 :ii-a-1)
    (:ii-b-3 :ii-b-1 :ii-b-9 :si-b-3 :si-b-1 :si-a-2 :ii-a-1 :ii-a-2 :ii-a-3))))
