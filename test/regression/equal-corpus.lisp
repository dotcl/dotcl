;;; EQUAL and EQUALP over a corpus of 103 objects (numbers of every type with signed zeros, characters,
;;; strings of several kinds, symbols, lists and trees, long lists, vectors, bit vectors, arrays, pathnames,
;;; structures, functions, hash tables), every pair, and the hash tables with the tests EQL / EQUAL / EQUALP:
;;; lookups, removal and the order MAPHASH walks. The expected rows are the ones the build before the list fast
;;; paths in EQUAL and the list hashing produced, which agree with SBCL apart from the identity of coalesced
;;; literals.

(defstruct eqc-pt x y)
(defstruct (eqc-pt2 (:include eqc-pt)) z)
(defparameter *eqc-gen*
  (list
   '0 '1 '-1 '(expt 2 62) '(expt 2 64) '(- (expt 2 64)) '(expt 10 30) '(+ (expt 10 30) 1)
   '1.0f0 '1.0d0 '-0.0d0 '0.0d0 '0.0f0 '-0.0f0 '2.5d0 '2.5f0 '1/2 '-1/2 '0.5d0 '(float (expt 10 30) 1d0)
   '#c(1 2) '#c(1.0f0 2.0f0) '#c(1.0d0 2.0d0) '#c(1 2.0d0) '#c(0.5d0 0.0d0)
   '#\a '#\A '#\b '#\Space '(code-char 233) '(code-char 201)
   '"" '"a" '"A" '"ab" '"AB" '(copy-seq "ab") '(make-string 3 :initial-element #\a) '"aaa" '"AAA" '(coerce "ab" 'simple-base-string)
   '(make-array 2 :element-type 'character :adjustable t :fill-pointer 2 :initial-contents "ab")
   '(make-array 4 :element-type 'character :fill-pointer 2 :initial-contents "abzz")
   ''a ''A ':a 'nil 't ''b '(make-symbol "A") '(intern "a")
   'nil ''(1 2 3) '(list 1 2 3) '(list 1 2 4) ''(1 2 . 3) ''(1 . 2) '(cons 1 2) ''(a "b" #\c 1.0d0) '(list 'a "b" #\c 1.0d0) '(list 'a "B" #\C 1)
   ''((1 2) (3 (4 5)) "x" :k) '(copy-tree '((1 2) (3 (4 5)) "x" :k)) '(copy-tree '((1 2) (3 (4 5)) "X" :K))
   '(make-list 1000 :initial-element 7) '(make-list 1000 :initial-element 7) '(make-list 1001 :initial-element 7) '(append (make-list 999 :initial-element 7) '(8))
   '(let ((l (list 1 2 3))) l)
   '#(1 2 3) '(vector 1 2 3) '(vector 1.0d0 2 3) '(vector 1 2) '(vector) '(make-array 3 :initial-element 0) '(make-array 3 :element-type '(unsigned-byte 8) :initial-element 0) '(make-array 3 :element-type 'fixnum :initial-element 0) '(vector "a" "A")
   '#*101 '(copy-seq #*101) '#*1010 '(make-array 3 :element-type 'bit :initial-element 0) '#*
   '(make-array '(2 2) :initial-element 1) '(make-array '(2 2) :initial-element 1) '(make-array '(2 2) :initial-element 1.0d0) '(make-array '(1 4) :initial-element 1)
   '(pathname "/a/b.c") '(pathname "/a/b.c") '(pathname "/a/B.c") '(pathname "/a/b.d")
   '(make-eqc-pt :x 1 :y 2) '(make-eqc-pt :x 1 :y 2) '(make-eqc-pt :x 1 :y 3) '(make-eqc-pt :x "a" :y 2) '(make-eqc-pt :x "A" :y 2) '(make-eqc-pt2 :x 1 :y 2 :z 3) '(make-eqc-pt2 :x 1 :y 2 :z 3)
   '#'car '#'cdr
   '(let ((h (make-hash-table :test 'equal))) (setf (gethash "a" h) 1) h)
   '(let ((h (make-hash-table :test 'equal))) (setf (gethash "a" h) 1) h)
   '(let ((h (make-hash-table :test 'equal))) (setf (gethash "a" h) 2) h)
   ))

(defun %eqc-b (x) (if x 1 0))

(defun %eqc-rows ()
  (let* ((objs (mapcar #'eval *eqc-gen*)) (n (length objs)) (rows nil))
    (dotimes (i n)
      (let ((a (nth i objs)) (s (make-string-output-stream)))
        (dotimes (j n)
          (let ((c (nth j objs)))
            (format s "~d~d~d" (%eqc-b (eql a c)) (%eqc-b (equal a c)) (%eqc-b (equalp a c)))))
        (push (get-output-stream-string s) rows)))
    (nreverse rows)))

(defun %eqc-hash (test)
  (let* ((*print-pretty* nil) (objs (mapcar #'eval *eqc-gen*)) (n (length objs)) (h (make-hash-table :test test)) (s (make-string-output-stream)))
    (dotimes (i n) (setf (gethash (nth i objs) h) i))
    (format s "~a count ~d" test (hash-table-count h))
    (dotimes (j n) (multiple-value-bind (v p) (gethash (nth j objs) h) (format s " | ~a ~d ~a ~a" test j v p)))
    (dotimes (i n) (when (evenp i) (remhash (nth i objs) h)))
    (format s " | ~a count after remhash ~d" test (hash-table-count h))
    (dotimes (j n) (multiple-value-bind (v p) (gethash (nth j objs) h) (format s " | ~a ~d ~a ~a" test j v p)))
    (let ((ks nil)) (maphash (lambda (k v) (declare (ignore k)) (push v ks)) h) (format s " | ~a order ~a" test (reverse ks)))
    (get-output-stream-string s)))

