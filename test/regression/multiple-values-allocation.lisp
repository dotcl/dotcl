(defun %mva-vars (n)
  (loop for i below n collect (intern (format nil "V~D" i))))

(defun %mva-consumer-label (consumer)
  (ecase consumer
    (:mvb-all "multiple-value-bind all")
    (:mvb-first "multiple-value-bind first")
    (:mvb-more "multiple-value-bind more variables")
    (:nth-0 "nth-value 0")
    (:nth-1 "nth-value 1")
    (:nth-3 "nth-value 3")
    (:nth-var "nth-value variable")
    (:mvl "multiple-value-list")
    (:mvc-add "multiple-value-call +")
    (:mvc-list "multiple-value-call list")
    (:mvp "multiple-value-prog1")
    (:mvsetq "multiple-value-setq")
    (:values-list-roundtrip "values-list roundtrip")
    (:single "single-value use")
    (:discard "discarded in progn")
    (:dbind "destructuring-bind")))

(defun %mva-consumer-floor (consumer n)
  (ecase consumer
    ((:mvb-all :mvb-first :mvb-more :nth-0 :nth-1 :nth-3 :nth-var
      :mvc-add :mvp :mvsetq :single :discard)
     0)
    ((:mvl :mvc-list :values-list-roundtrip :dbind)
     (* *mva-cons-bytes* n))))

(defun %mva-consumer-code (consumer p n)
  (let* ((vars (%mva-vars n))
         (more (%mva-vars (+ n 2))))
    (flet ((bind (bound form)
             `(multiple-value-bind ,bound ,p (declare (ignorable ,@bound))
                (and ,@bound ,form))))
      (ecase consumer
        (:mvb-all (bind vars t))
        (:mvb-first `(multiple-value-bind ,(%mva-vars 1) ,p
                       (and ,@(%mva-vars 1) t)))
        (:mvb-more (bind more t))
        (:nth-0 `(nth-value 0 ,p))
        (:nth-1 `(nth-value 1 ,p))
        (:nth-3 `(nth-value 3 ,p))
        (:nth-var `(nth-value *mva-index* ,p))
        (:mvl `(length (multiple-value-list ,p)))
        (:mvc-add `(multiple-value-call #'+ ,p))
        (:mvc-list `(length (multiple-value-call #'list ,p)))
        (:mvp `(multiple-value-bind ,vars (multiple-value-prog1 ,p *mva-sink2*)
                 (declare (ignorable ,@vars))
                 (and ,@vars t)))
        (:mvsetq
         `(let (,@(loop for v in vars collect `(,v nil)))
            (multiple-value-setq ,vars ,p)
            (and ,@vars t)))
        (:values-list-roundtrip
         `(multiple-value-bind ,vars (values-list (multiple-value-list ,p))
            (declare (ignorable ,@vars))
            (and ,@vars t)))
        (:single `(if ,p t nil))
        (:discard `(progn ,p t))
        (:dbind `(destructuring-bind ,vars (multiple-value-list ,p)
                   (declare (ignorable ,@vars))
                   (and ,@vars t)))))))

(defmacro %mva-def-producer (label n producer fvar generic numeric)
  (let ((rows nil))
    (dolist (mode '(:direct :funcall :generic))
      (dolist (consumer *mva-consumers*)
        (unless (and (eq consumer :mvc-add) (not numeric))
          (let* ((p (ecase mode
                      (:direct `(,producer a b))
                      (:funcall `(funcall ,fvar a b))
                      (:generic `(,generic a b))))
                 (fn (gensym "ROW"))
                 (row-label (format nil "~A / ~A / ~A" label
                                    (%mva-consumer-label consumer)
                                    (ecase mode
                                      (:direct "direct")
                                      (:funcall "funcall variable")
                                      (:generic "generic function")))))
            (push `(defun ,fn (a b) ,(%mva-consumer-code consumer p n)) rows)
            (push `(push (list ,row-label ,(%mva-consumer-floor consumer n) #',fn)
                         *mva-rows*)
                  rows)))))
    `(progn ,@(nreverse rows))))

(defmacro %mva-def-values-list-rows (n listvar)
  (let ((vars (%mva-vars n))
        (rows nil))
    (flet ((row (suffix floor code)
             (let ((fn (gensym "ROW")))
               (push `(progn
                        (defun ,fn (a b) (declare (ignore a b)) ,code)
                        (push (list ,(format nil "values-list ~D from list / ~A"
                                             n suffix)
                                    ,floor #',fn)
                              *mva-rows*))
                     rows))))
      (row "multiple-value-bind" 0
           `(multiple-value-bind ,vars (values-list ,listvar)
              (declare (ignorable ,@vars))
              (and ,@vars t)))
      (row "multiple-value-list" (* *mva-cons-bytes* n)
           `(length (multiple-value-list (values-list ,listvar))))
      (row "nth-value 1" 0 `(nth-value 1 (values-list ,listvar)))
      (row "single-value use" 0 `(if (values-list ,listvar) t nil))
      (row "discarded in progn" 0 `(progn (values-list ,listvar) t)))
    `(progn ,@(nreverse rows))))


(when (compiled-mode-p)
  (setq *mva-rows* nil)
  (dolist (p *mva-producers*)
    (eval `(%mva-def-producer ,@p)))
  (%mva-def-values-list-rows 0 *mva-list0*)
  (%mva-def-values-list-rows 2 *mva-list2*)
  (%mva-def-values-list-rows 3 *mva-list3*)
  (%mva-def-values-list-rows 5 *mva-list5*)
  (%mva-def-values-list-rows 6 *mva-list6*))

