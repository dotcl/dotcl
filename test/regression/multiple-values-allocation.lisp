;;; Multiple values: allocation per call; compiled-only, the interpreter has no snapshot.

;;; Bytes per call for multiple values producers and consumers.

(defparameter *mva-iterations* 1000)
(defparameter *mva-runs* 5)
(defparameter *mva-sink* nil)
(defparameter *mva-sink2* 0)
(defparameter *mva-cons-bytes* 32)
(defvar *mva-index* 1)

(defparameter *mva-str1* "alpha")
(defparameter *mva-str2* "beta")
(defparameter *mva-d1* 3.0d0)
(defparameter *mva-d2* 4.0d0)
(defparameter *mva-numstr* "42")
(defparameter *mva-readstr* "42")
(defparameter *mva-ht* (let ((h (make-hash-table :test 'eql)))
                     (setf (gethash 3 h) 30)
                     h))
(defparameter *mva-list0* nil)
(defparameter *mva-list2* (list 1 2))
(defparameter *mva-list3* (list 1 2 3))
(defparameter *mva-list5* (list 1 2 3 4 5))
(defparameter *mva-list6* (list 1 2 3 4 5 6))

;;; --- producers ---

(defun %mva-p-v2-fx (a b) (values a b))
(defun %mva-p-v2-dbl (a b)
  (declare (ignore a b))
  (values *mva-d1* *mva-d2*))
(defun %mva-p-v2-str (a b)
  (declare (ignore a b))
  (values *mva-str1* *mva-str2*))
(defun %mva-p-v5-mixed (a b)
  (values a b *mva-d1* *mva-str1* (+ a b)))
(defun %mva-p-user2 (a b) (values a b))
(defun %mva-p-user3 (a b) (values a b (+ a b)))
(defun %mva-p-user6 (a b)
  (values a b (+ a b) *mva-d1* *mva-str1* 'six))
(defun %mva-p-tail2 (a b) (%mva-p-user2 a b))
(defun %mva-p-zero (a b)
  (declare (ignore a b))
  (values))
(defun %mva-p-block2 (a b)
  (block b2 (return-from b2 (values a b))))
(defun %mva-p-let2 (a b)
  (let ((x a) (y b)) (values x y)))
(defun %mva-p-floor-fx (a b)
  (declare (ignore b))
  (floor a 3))
(defun %mva-p-floor-dbl (a b)
  (declare (ignore b))
  (floor (float a 1d0) 2.5d0))
(defun %mva-p-truncate-fx (a b)
  (declare (ignore b))
  (truncate a 3))
(defun %mva-p-truncate-dbl (a b)
  (declare (ignore b))
  (truncate (float a 1d0) 2.5d0))
(defun %mva-p-round-fx (a b)
  (declare (ignore b))
  (round a 3))
(defun %mva-p-round-dbl (a b)
  (declare (ignore b))
  (round (float a 1d0) 2.5d0))
(defun %mva-p-gethash (a b)
  (declare (ignore b))
  (gethash a *mva-ht*))
(defun %mva-p-parse-integer (a b)
  (declare (ignore a b))
  (parse-integer *mva-numstr*))
(defun %mva-p-read-from-string (a b)
  (declare (ignore a b))
  (read-from-string *mva-readstr*))

