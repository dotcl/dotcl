;;; regression: skip-under-interp
;;; A literal that holds shared objects inside other shared objects, and instances made by MAKE-LOAD-FORM whose
;;; slots hold the same objects, loads with the sharing it was compiled with. The data of such a literal has
;;; nested regions for the shared slots; a region the loader skipped (its slot already filled) left the
;;; slots of the objects inside it empty, and a later reference to one of them read the wrong bytes
;;; (an IndexOutOfRangeException) or found nothing. Found by a generator of random literal graphs.

(defparameter *fsn-source* "(defpackage :fsn (:use :cl))
(in-package :fsn)
(eval-when (:compile-toplevel :load-toplevel :execute)
  (defstruct (base (:constructor nil)) (alias nil))
  (defstruct (nd (:include base)) a b)
  (defmethod make-load-form ((o base) &optional env) (make-load-form-saving-slots o :slot-names '(a b) :environment env)))
(eval-when (:compile-toplevel :load-toplevel :execute)
  (defun sig (x)
    (let ((seen (make-hash-table :test 'eq)) (n 0) (*package* (find-package :fsn)) (*print-pretty* nil))
      (labels ((w (x)
                 (cond ((or (consp x) (nd-p x))
                        (let ((id (gethash x seen)))
                          (if id (format nil \"#~D\" id)
                              (progn (setf (gethash x seen) (incf n))
                                     (if (consp x)
                                         (format nil \"(~A . ~A)\" (w (car x)) (w (cdr x)))
                                         (format nil \"<ND ~A ~A>\" (w (nd-a x)) (w (nd-b x))))))))
                       (t (format nil \"~S\" x)))))
        (w x)))))
(eval-when (:compile-toplevel)
  (defvar *pool* (make-array 40))
  (setf (aref *pool* 0) (list 'm0))
  (setf (aref *pool* 1) (list 'm1))
  (setf (aref *pool* 2) (list (aref *pool* 0)))
  (setf (aref *pool* 3) (list (aref *pool* 0) (aref *pool* 1) (aref *pool* 1)))
  (setf (aref *pool* 4) (list (aref *pool* 2) (aref *pool* 1)))
  (setf (aref *pool* 5) (make-nd :a (aref *pool* 0) :b (aref *pool* 3)))
  (setf (aref *pool* 6) (make-nd :a (aref *pool* 3) :b (aref *pool* 2)))
  (setf (aref *pool* 7) (make-nd :a (aref *pool* 1) :b (aref *pool* 6)))
  (setf (aref *pool* 8) (list (aref *pool* 1) (aref *pool* 2) (aref *pool* 4)))
  (setf (aref *pool* 9) (list (aref *pool* 0) (aref *pool* 6)))
  (setf (aref *pool* 10) (list (aref *pool* 7) (aref *pool* 3) (aref *pool* 4) (aref *pool* 3)))
  (setf (aref *pool* 11) (list (aref *pool* 1) (aref *pool* 2)))
  (setf (aref *pool* 12) (list (aref *pool* 10) (aref *pool* 10) (aref *pool* 9) (aref *pool* 5)))
  (defvar *tops* (list (aref *pool* 12))))
(defmacro top (i) `(quote ,(nth i *tops*)))
(defmacro expected () (list (quote quote) (mapcar (function sig) *tops*)))
(defvar *r* nil)
(push (top 0) *r*)
(setq *r* (nreverse *r*))
(defun expected-sig () (expected))
(defun loaded-sig () (mapcar (function sig) *r*))
")

(deftest-emitting-only fasl-shared-nested-regions.sharing-is-kept
  (let* ((dir (format nil "~A/fsn" (regression-temp-dir)))
         (src (format nil "~A/fsn.lisp" dir))
         (fasl (format nil "~A/fsn.fasl" dir)))
    (ensure-directories-exist src)
    (with-open-file (o src :direction :output :if-exists :supersede) (write-string *fsn-source* o))
    (let ((*error-output* (make-broadcast-stream)))
      (compile-file src :output-file fasl))
    (load fasl)
    (let ((p (find-package :fsn)))
      (equal (funcall (find-symbol "LOADED-SIG" p)) (funcall (find-symbol "EXPECTED-SIG" p)))))
  t)

;;; A structure made by MAKE-LOAD-FORM that two forms of a file both contain, with an object that it shares with
;;; the rest of each form: both forms see the sharing. The structure is made once, and its slot holds the object
;;; the first form shares (it is in a shared slot of the file when the second form reaches it).

(defparameter *fsx-source* "(defpackage :fsx (:use :cl))
(in-package :fsx)
(eval-when (:compile-toplevel :load-toplevel :execute)
  (defstruct (base (:constructor nil)) (alias nil))
  (defstruct (nd (:include base)) a b)
  (defmethod make-load-form ((o base) &optional env) (make-load-form-saving-slots o :slot-names '(a b) :environment env)))
(eval-when (:compile-toplevel)
  (defvar *p* (list 'x 'y))
  (defvar *n* (make-nd :a 1 :b *p*))
  (defvar *t0* (list *n* *p*))
  (defvar *t1* (list *p* *n*)))
(defmacro lit (x) `',(symbol-value x))
(defvar *r0* (lit *t0*))
(defvar *r1* (lit *t1*))
(defun check () (list :form0 (eq (nd-b (first *r0*)) (second *r0*)) :form1 (eq (nd-b (second *r1*)) (first *r1*)) :same-nd (eq (first *r0*) (second *r1*))))
")

(deftest-emitting-only fasl-shared-nested-regions.object-shared-across-two-forms
  (let* ((dir (format nil "~A/fsx" (regression-temp-dir)))
         (src (format nil "~A/fsx.lisp" dir))
         (fasl (format nil "~A/fsx.fasl" dir)))
    (ensure-directories-exist src)
    (with-open-file (o src :direction :output :if-exists :supersede) (write-string *fsx-source* o))
    (let ((*error-output* (make-broadcast-stream)))
      (compile-file src :output-file fasl))
    (load fasl)
    (funcall (find-symbol "CHECK" :fsx)))
  (:form0 t :form1 t :same-nd t))
