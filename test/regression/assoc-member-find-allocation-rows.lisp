(defparameter *amf-cons-list* (list (cons 'a 1) (cons 'b 2) (cons 'c 3) (cons 'd 4) (cons 'e 5) (cons 'f 6) (cons 'g 7) (cons 'h 8)))
(defparameter *amf-vector* (vector 1 2 3 4 5 6 7 8))
