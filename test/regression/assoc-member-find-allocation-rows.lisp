(defparameter *amf-z-pair* (cons 'z 9))
(defparameter *amf-dups* (list 1 2 2 3 1))
(defparameter *amf-sink* nil)

(defun %amf-never (x) (declare (ignore x)) nil)
(defun %amf-always (x) (declare (ignore x)) t)
(defun %amf-three-p (x) (eql x 3))

(defvar *amf-rows* nil)

(defmacro %amf-defrow (id op input variant position floor above form)
  (let ((name (gensym "AMFROW")))
    `(progn
       (defun ,name ()
         (let ((*amf-sink* nil))
           (dotimes (i 1000) (setq *amf-sink* ,form))
           *amf-sink*))
       (push (list ,id ,op ,input ,variant ,position ,floor ,above #',name)
             *amf-rows*))))

