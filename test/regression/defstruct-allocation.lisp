(dsa-row "setf-include-c" 0 (setf (%dsa-inc-c *dsa-inc*) 9))
(dsa-row "setf-conc-nil-x" 0 (setf (dsa-cnx *dsa-cn*) 9))
(dsa-row "setf-conc-prefix-x" 0 (setf (%dsa-cp-x *dsa-cp*) 9))
(dsa-row "setf-vector-a" 0 (setf (%dsa-vec-a *dsa-vec*) 9))
