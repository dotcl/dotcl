  (make-%dsa-m :sym :k :str "v" :d 1d0 :arr *dsa-m-arr* :flag t))
(dsa-row "ctor-include" 136 (make-%dsa-inc :a 1 :b 2 :c 3))
(dsa-row "ctor-conc-nil" 128 (make-%dsa-cn :dsa-cnx 1 :dsa-cny 2))
(dsa-row "ctor-conc-prefix" 128 (make-%dsa-cp :x 1 :y 2))
(dsa-row "ctor-vector" 136 (make-%dsa-vec :a 1 :b 2 :c 3))
