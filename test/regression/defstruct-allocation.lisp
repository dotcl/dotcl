;;; DEFSTRUCT constructors, accessors and related operations stay within their floors.

(defparameter *dsa-it* 1000)
(defparameter *dsa-sink* nil)
(defparameter *dsa-rows* nil)

(defstruct %dsa-u a b c)
(defstruct %dsa-f (a 0 :type fixnum) (b 0 :type fixnum) (c 0 :type fixnum))
(defstruct %dsa-d (a 0d0 :type double-float) (b 0d0 :type double-float)
  (c 0d0 :type double-float))
(defstruct %dsa-m (sym 'x :type symbol) (str "s" :type string) (d 0d0 :type double-float)
  (arr (make-array 1 :element-type 'double-float) :type (simple-array double-float (*)))
  (flag nil :type boolean))
(defstruct %dsa-inc-base a b)
(defstruct (%dsa-inc (:include %dsa-inc-base)) c)
(defstruct (%dsa-cn (:conc-name nil)) dsa-cnx dsa-cny)
(defstruct (%dsa-cp (:conc-name %dsa-cp-)) x y)
(defstruct (%dsa-vec (:type vector)) a b c)
(defstruct (%dsa-vecn (:type vector) :named) a b c)
(defstruct (%dsa-list (:type list)) a b c)
(defstruct (%dsa-listn (:type list) :named) a b c)
(defstruct %dsa-ro (x 0 :type fixnum :read-only t) (y 0 :type fixnum))
(defstruct %dsa-all a b c)
(defstruct %dsa-def (a 1) (b 2) (c 3))
(defstruct %dsa-call (a (list 1)) (b (+ 1 2)) (c "x"))
(defstruct (%dsa-boa (:constructor make-%dsa-boa (a b c))) a b c)
(defstruct (%dsa-boao (:constructor make-%dsa-boao (a &optional (b 2) &aux (c (+ a b)))))
  a b c)
(defstruct %dsa-loop (a 0d0 :type double-float) b)
(defstruct %dsa-ret (d 0d0 :type double-float) (f 0 :type fixnum)
  (s 0f0 :type single-float) (b nil))

(defparameter *dsa-m-arr* (make-array 1 :element-type 'double-float))
(defparameter *dsa-u* (make-%dsa-u :a 1 :b 2 :c 3))
(defparameter *dsa-f* (make-%dsa-f :a 1 :b 2 :c 3))
(defparameter *dsa-d* (make-%dsa-d :a 1d0 :b 2d0 :c 3d0))
(defparameter *dsa-m* (make-%dsa-m :sym :k :str "v" :d 1d0 :arr *dsa-m-arr* :flag t))
(defparameter *dsa-inc* (make-%dsa-inc :a 1 :b 2 :c 3))
(defparameter *dsa-cn* (make-%dsa-cn :dsa-cnx 1 :dsa-cny 2))
(defparameter *dsa-cp* (make-%dsa-cp :x 1 :y 2))
(defparameter *dsa-vec* (make-%dsa-vec :a 1 :b 2 :c 3))
(defparameter *dsa-vecn* (make-%dsa-vecn :a 1 :b 2 :c 3))
(defparameter *dsa-list* (make-%dsa-list :a 1 :b 2 :c 3))
(defparameter *dsa-listn* (make-%dsa-listn :a 1 :b 2 :c 3))
(defparameter *dsa-ro* (make-%dsa-ro :x 1 :y 2))
(defparameter *dsa-loop* (make-%dsa-loop :a 0d0 :b 0))
(defparameter *dsa-iv* 7)
(defparameter *dsa-dv* 7d0)
(defparameter *dsa-sv* "w")

(defmacro dsa-row (name floor form)
  (let ((fn (gensym "ROW")))
    `(progn
       (defun ,fn ()
         (let ((*dsa-sink* nil))
           (dotimes (i *dsa-it*) (setq *dsa-sink* ,form))
           *dsa-sink*))
       (push (list ,name ,floor #',fn) *dsa-rows*))))

(defmacro dsa-srow (name floor form)
  "A row whose form is a statement: its value is not kept."
  (let ((fn (gensym "ROW")))
    `(progn
       (defun ,fn ()
         (let ((*dsa-sink* nil))
           (dotimes (i *dsa-it*) ,form (setq *dsa-sink* nil))
           *dsa-sink*))
       (push (list ,name ,floor #',fn) *dsa-rows*))))

;;; Constructors
(dsa-row "ctor-u3" 136 (make-%dsa-u :a 1 :b 2 :c 3))
(dsa-row "ctor-f3" 136 (make-%dsa-f :a 1 :b 2 :c 3))
(dsa-row "ctor-d3" 136 (make-%dsa-d :a 1d0 :b 2d0 :c 3d0))
