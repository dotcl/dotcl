;;; Increment and arithmetic
(dsa-srow "incf-fixnum" 0
  (progn (setf (%dsa-f-a *dsa-f*) 0) (incf (%dsa-f-a *dsa-f*))))
(dsa-srow "incf-double" 0
  (progn (setf (%dsa-d-a *dsa-d*) 0d0) (incf (%dsa-d-a *dsa-d*) 1d0)))

(defun %dsa-read-add ()
  (let ((x 0d0))
    (declare (double-float x))
    (dotimes (i *dsa-it*) (setq x (+ (%dsa-d-a *dsa-d*) 1d0)))
    (if (minusp x) (%dsa-d-b *dsa-d*) (%dsa-d-b *dsa-d*))))

;;; Copy, predicate, typep
(dsa-row "copy-u3" 136 (copy-%dsa-u *dsa-u*))
(dsa-row "copy-f3" 136 (copy-%dsa-f *dsa-f*))
(dsa-row "copy-d3" 136 (copy-%dsa-d *dsa-d*))
(dsa-row "copy-mixed" 152 (copy-%dsa-m *dsa-m*))
(dsa-row "copy-include" 136 (copy-%dsa-inc *dsa-inc*))
(dsa-row "copy-vector" 136 (copy-%dsa-vec *dsa-vec*))
(dsa-row "copy-vector-named" 136 (copy-%dsa-vecn *dsa-vecn*))
(dsa-row "copy-list" 136 (copy-%dsa-list *dsa-list*))
(dsa-row "copy-list-named" 136 (copy-%dsa-listn *dsa-listn*))
(dsa-row "copy-read-only" 128 (copy-%dsa-ro *dsa-ro*))
(dsa-row "predicate-u3-true" 0 (%dsa-u-p *dsa-u*))
(dsa-row "predicate-u3-false" 0 (%dsa-u-p *dsa-f*))
(dsa-row "predicate-vector-named-true" 0 (%dsa-vecn-p *dsa-vecn*))
(dsa-row "predicate-vector-named-false" 0 (%dsa-vecn-p *dsa-vec*))
(dsa-row "typep-name-true" 0 (typep *dsa-u* '%dsa-u))
(dsa-row "typep-name-false" 0 (typep *dsa-f* '%dsa-u))

(defun %dsa-baseline ()
  (min-allocated-bytes
   (lambda () (dotimes (i *dsa-it*) (setq *dsa-sink* nil)))
   5))

(defun %dsa-check (rows)
  (let ((base (%dsa-baseline)) (bad nil))
    (dolist (row rows (nreverse bad))
      (destructuring-bind (name floor fn) row
        (funcall fn)
        (let ((got (- (min-allocated-bytes fn 5) base)))
          (when (> got (* *dsa-it* (+ floor 16)))
            (push (list name got floor) bad)))))))

(deftest-compiled-only defstruct-allocation.budget
  (%dsa-check (append *dsa-rows* (list (list "read-add" 0 #'%dsa-read-add))))
  nil)

(defun %dsa-loop-update ()
  (let ((s *dsa-loop*))
    (dotimes (i 1000) (incf (%dsa-loop-a s) 1d0))
    (%dsa-loop-b s)))

(deftest-compiled-only defstruct-allocation.loop
  (let ((base (%dsa-baseline)))
    (funcall #'%dsa-loop-update)
    (< (- (min-allocated-bytes #'%dsa-loop-update 5) base) 16))
  t)

;;; A raw slot store returns the value it stored, not a fresh box of the raw
;;; value: the literal or variable is already an object.
(deftest defstruct-allocation.setf-returns-value
  (let ((x (make-%dsa-ret))
        (v 3d0))
    (declare (double-float v))
    (let ((r1 (setf (%dsa-ret-d x) v))
          (r2 (setf (%dsa-ret-f x) most-positive-fixnum))
          (r3 (setf (%dsa-ret-s x) 1.5f0))
          (r4 (setf (%dsa-ret-b x) :b)))
      (list (= r1 3d0) (= r2 most-positive-fixnum) (= r3 1.5f0) (eq r4 :b)
            (%dsa-ret-d x) (%dsa-ret-f x) (%dsa-ret-s x) (%dsa-ret-b x))))
  (t t t t 3d0 9223372036854775807 1.5f0 :b))

(deftest defstruct-allocation.setf-type-check
  (let ((x (make-%dsa-ret)))
    (list (handler-case (progn (setf (%dsa-ret-d x) 1) :stored)
            (type-error () :type-error))
          (%dsa-ret-d x)))
  (:type-error 0d0))
