(dsa-row "ctor-call-initforms" 136 (make-%dsa-call :c "z"))
(dsa-row "ctor-boa" 136 (make-%dsa-boa 1 2 3))
(dsa-row "ctor-boa-optional-aux" 136 (make-%dsa-boao 1))
(dsa-row "ctor-boa-optional-aux-supplied" 136 (make-%dsa-boao 1 5))
(dsa-row "ctor-funcall" 136 (funcall #'make-%dsa-u :a 1 :b 2 :c 3))

;;; Readers
(dsa-row "read-u3-a" 0 (%dsa-u-a *dsa-u*))
(dsa-row "read-u3-b" 0 (%dsa-u-b *dsa-u*))
(dsa-row "read-u3-c" 0 (%dsa-u-c *dsa-u*))
(dsa-row "read-f3-a" 0 (%dsa-f-a *dsa-f*))
(dsa-row "read-f3-b" 0 (%dsa-f-b *dsa-f*))
