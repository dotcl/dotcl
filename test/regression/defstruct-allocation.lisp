(dsa-row "read-read-only-x" 0 (%dsa-ro-x *dsa-ro*))

;;; Writers
(dsa-row "setf-u3-a" 0 (setf (%dsa-u-a *dsa-u*) :x))
(dsa-row "setf-u3-b" 0 (setf (%dsa-u-b *dsa-u*) :y))
(dsa-row "setf-u3-c" 0 (setf (%dsa-u-c *dsa-u*) :z))
(dsa-row "setf-f3-a" 0 (setf (%dsa-f-a *dsa-f*) *dsa-iv*))
(dsa-row "setf-f3-b" 0 (setf (%dsa-f-b *dsa-f*) *dsa-iv*))
(dsa-row "setf-f3-c" 0 (setf (%dsa-f-c *dsa-f*) *dsa-iv*))
(dsa-row "setf-d3-a" 0 (setf (%dsa-d-a *dsa-d*) *dsa-dv*))
(dsa-row "setf-d3-b" 0 (setf (%dsa-d-b *dsa-d*) *dsa-dv*))
(dsa-row "setf-d3-c" 0 (setf (%dsa-d-c *dsa-d*) *dsa-dv*))
(dsa-row "setf-d3-literal" 0 (setf (%dsa-d-a *dsa-d*) 7d0))
(dsa-row "setf-mixed-symbol" 0 (setf (%dsa-m-sym *dsa-m*) :z))
(dsa-row "setf-mixed-string" 0 (setf (%dsa-m-str *dsa-m*) *dsa-sv*))
