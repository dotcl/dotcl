(defun %ka-check-rows ()
  (let ((base (min-allocated-bytes
               (lambda () (dotimes (i *iterations*) (setq *sink* nil))) 5))
        (bad '()))
    (dolist (row *rows* (nreverse bad))
      (destructuring-bind (id shape mech var floor-spec fn) row
        (declare (ignore floor-spec))
        (let ((floor (cdr (assoc fn *ka-floors*))))
          (when (consp (assoc fn *ka-floors*))
            (funcall fn *iterations*)
            (let ((got (/ (- (min-allocated-bytes
                              (lambda () (funcall fn *iterations*)) 5)
                            base)
                          (float *iterations*))))
              (when (> got (+ floor 0.5))
                (push (list id shape mech var got floor) bad)))))))))

(deftest-compiled-only key-optional-rest-allocation.rows
  (%ka-check-rows)
  nil)

