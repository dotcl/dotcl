;;; Calls to functions with &OPTIONAL, supplied-p variables, &KEY and &REST
;;; must not allocate an argument array or a &rest list when the typed
;;; entries cover the call shape. Allocation is asserted on emitted code, so
;;; the rows are compiled-only: the interpreter has no direct entries and no
;;; argument array to save.


;;; --- behaviour: direct entries must agree with the array entry ---

(defun %ka-opt-sp (a &optional (b 5 b-p)) (list a b b-p))
(defun %ka-opt-sp-ref (a &optional (b 5 b-p) &aux (z 0))
  (declare (ignore z)) (list a b b-p))

(defun %ka-key-aok (a &key &allow-other-keys) (list a))
(defun %ka-key-aok-ref (a &key &allow-other-keys &aux (z 0))
  (declare (ignore z)) (list a))

(defun %ka-key3 (a &key b c d) (list a b c d))
(defun %ka-key3-ref (a &key b c d &aux (z 0))
  (declare (ignore z)) (list a b c d))

(defun %ka-opt-key (a &optional (b 5 b-p) &key (c 7 c-p))
  (list a b b-p c c-p))
(defun %ka-opt-key-ref (a &optional (b 5 b-p) &key (c 7 c-p) &aux (z 0))
  (declare (ignore z)) (list a b b-p c c-p))

(defun %ka-rest-key (a &rest r &key (b 5 b-p)) (list a r b b-p))
(defun %ka-rest-key-ref (a &rest r &key (b 5 b-p) &aux (z 0))
  (declare (ignore z)) (list a r b b-p))




