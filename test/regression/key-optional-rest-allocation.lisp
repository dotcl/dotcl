      (unless (equal a b) (list '(:a nil :c) a b)))
    (let ((a (handler-case (multiple-value-list (%ka-rest-key :b nil :a nil nil))
                          (error (c) (list :error (type-of c)))))
          (b (handler-case (multiple-value-list (%ka-rest-key-ref :b nil :a nil nil))
                          (error (c) (list :error (type-of c))))))
      (unless (equal a b) (list '(:b nil :a nil nil) a b)))
    (let ((a (handler-case (multiple-value-list (%ka-rest-key :b t nil :a :b))
                          (error (c) (list :error (type-of c)))))
          (b (handler-case (multiple-value-list (%ka-rest-key-ref :b t nil :a :b))
                          (error (c) (list :error (type-of c))))))
      (unless (equal a b) (list '(:b t nil :a :b) a b)))
    (let ((a (handler-case (multiple-value-list (%ka-rest-key :b :b nil :c 1))
                          (error (c) (list :error (type-of c)))))
          (b (handler-case (multiple-value-list (%ka-rest-key-ref :b :b nil :c 1))
                          (error (c) (list :error (type-of c))))))
      (unless (equal a b) (list '(:b :b nil :c 1) a b)))))
  nil)


(deftest key-optional-rest-allocation.semantics
  (values (%ka-opt-sp 1) (%ka-opt-sp 1 2)
          (%ka-key-aok 1 :x 2) (%ka-key-aok 1 :x 2 :allow-other-keys nil)
          (%ka-key3 1 :b 1 :b 2 :c 3)
          (handler-case (%ka-key3 1 :z 2) (error () :unknown))
          (%ka-opt-key 1) (%ka-opt-key 1 2 :c 3)
          (%ka-rest-key 1 :b 2)
          (handler-case (%ka-rest-key 1 :b) (error () :odd))
          (handler-case (%ka-key-aok 1 2) (error () :odd-aok)))
  (1 5 nil) (1 2 t)
  (1) (1)
  (1 1 3 nil)
  :unknown
  (1 5 nil 7 nil) (1 2 t 3 t)
  (1 (:b 2) 2 t)
  :odd
  :odd-aok)


;;; Bytes per call for calls to user-defined functions with &OPTIONAL,
;;; &KEY and &REST. Best of five runs of 1000 calls; inputs are built
;;; outside every thunk. Every row is a compiled DEFUN. The fixed cost
;;; of the empty loop is subtracted, so a call that allocates nothing reads 0.


(defparameter *iterations* 1000)
(defparameter *runs* 5)
(defparameter *sink* nil)
