;;; Special-variable reads, writes and bindings must stay at their floor.

(defparameter *sba-iterations* 1000)
(defparameter *sba-runs* 5)
(defparameter *sba-sink* nil)
(defparameter *sba-rows* nil)

(defvar *sba-r-fix* 1000000)
(defvar *sba-r-dbl* 1.5d0)
(defvar *sba-r-str* "special")
(defvar *sba-r-cons* (list 1 2 3))
(defvar *sba-r-unbound* 0)
(makunbound '*sba-r-unbound*)
(defun *sba-r-fbound* () t)
(defvar *sba-r-closure* (lambda () *sba-r-fix*))
(let ((*sba-r-fix* *sba-r-fix*)) *sba-r-fix*)

(defvar *sba-w-a* 1)
(defvar *sba-w-b* 2)
(defvar *sba-w-fix* 1000000)
(defvar *sba-w-dbl* 1.5d0)
(defvar *sba-w-item* 'item)
(defvar *sba-w-list* nil)
(defvar *sba-w-pop* (loop repeat 20000 collect 1))
(defvar *sba-w-mk* 7)

(defvar *sba-b1* 1)
(defvar *sba-b2* 2)
(defvar *sba-b3* 3)
(defvar *sba-b4* 4)
(defvar *sba-b5* 5)
(defvar *sba-b6* 6)
(defvar *sba-b7* 7)
(defvar *sba-b8* 8)
(defvar *sba-v1* 'v1)
(defvar *sba-v2* 'v2)
(defvar *sba-v3* 'v3)
(defvar *sba-v4* 'v4)
(defvar *sba-v5* 'v5)
(defvar *sba-v6* 'v6)
(defvar *sba-v7* 'v7)
(defvar *sba-v8* 'v8)
(defvar *sba-nest* 'nest)
(defvar *sba-loop* 'loop)
(defvar *sba-mv* 'mv)
(defvar *sba-ret* 'ret)
(defvar *sba-throw* 'throw)

(defvar *sba-p1* 1)
(defvar *sba-p2* 2)
(defvar *sba-p3* 3)
(defvar *sba-p4* 4)
(defvar *sba-p5* 5)
(defvar *sba-p6* 6)
(defvar *sba-p7* 7)
(defvar *sba-p8* 8)
(defparameter *sba-syms1* '(*sba-p1*))
(defparameter *sba-syms3* '(*sba-p1* *sba-p2* *sba-p3*))
(defparameter *sba-syms8* '(*sba-p1* *sba-p2* *sba-p3* *sba-p4*
                            *sba-p5* *sba-p6* *sba-p7* *sba-p8*))
(defparameter *sba-pvals1* (list *sba-v1*))
(defparameter *sba-pvals3* (list *sba-v1* *sba-v2* *sba-v3*))
(defparameter *sba-pvals8* (list *sba-v1* *sba-v2* *sba-v3* *sba-v4*
                                *sba-v5* *sba-v6* *sba-v7* *sba-v8*))

(defvar *sba-rec* 0)
(defvar *sba-rec-val* 'rec)

(defmacro sba-def-row (name &body body)
  `(defun ,name (n)
     (declare (fixnum n))
     (dotimes (i n)
       (setq *sba-sink* (progn ,@body)))
     *sba-sink*))

(defmacro sba-add-row (label floor name &optional args)
  `(push (list ,label ,floor ',name ,args) *sba-rows*))

(sba-def-row sba-row-read-global () *sba-r-fix*)
(sba-def-row sba-row-read-closure () (funcall *sba-r-closure*))
(sba-def-row sba-row-read-sv-const () (symbol-value '*sba-r-fix*))
(defun sba-row-read-sv-arg (s n)
  (declare (fixnum n))
  (dotimes (i n)
    (setq *sba-sink* (symbol-value s)))
  *sba-sink*)
(sba-def-row sba-row-read-sv-fix () (symbol-value '*sba-r-fix*))
(sba-def-row sba-row-read-sv-double () (symbol-value '*sba-r-dbl*))
(sba-def-row sba-row-read-sv-string () (symbol-value '*sba-r-str*))
(sba-def-row sba-row-read-sv-cons () (symbol-value '*sba-r-cons*))
(sba-def-row sba-row-boundp-bound () (boundp '*sba-r-fix*))
(sba-def-row sba-row-boundp-unbound () (boundp '*sba-r-unbound*))
(sba-def-row sba-row-fboundp-bound () (fboundp '*sba-r-fbound*))
(sba-def-row sba-row-fboundp-unbound () (fboundp '*sba-r-unbound*))
(sba-add-row "read/global-special" 0 sba-row-read-global)
(sba-add-row "read/closure" 0 sba-row-read-closure)
(sba-add-row "read/symbol-value-constant" 0 sba-row-read-sv-const)
(sba-add-row "read/symbol-value-argument" 0 sba-row-read-sv-arg '(*sba-r-fix*))
(sba-add-row "read/symbol-value/fixnum" 0 sba-row-read-sv-fix)
(sba-add-row "read/symbol-value/double-float" 0 sba-row-read-sv-double)
(sba-add-row "read/symbol-value/string" 0 sba-row-read-sv-string)
(sba-add-row "read/symbol-value/cons" 0 sba-row-read-sv-cons)
(sba-add-row "read/boundp/bound" 0 sba-row-boundp-bound)
(sba-add-row "read/boundp/unbound" 0 sba-row-boundp-unbound)
(sba-add-row "read/fboundp/bound" 0 sba-row-fboundp-bound)
(sba-add-row "read/fboundp/unbound" 0 sba-row-fboundp-unbound)

(sba-def-row sba-row-setq () (setq *sba-w-a* *sba-w-b*))
(sba-def-row sba-row-setf-sv () (setf (symbol-value '*sba-w-a*) *sba-w-b*))
(sba-def-row sba-row-set () (set '*sba-w-a* *sba-w-b*))
(sba-def-row sba-row-incf-fix () (incf *sba-w-fix*))
(sba-def-row sba-row-incf-double () (incf *sba-w-dbl*))
(sba-def-row sba-row-cons-special ()
  (setq *sba-w-list* (cons *sba-w-item* *sba-w-list*)))
(sba-def-row sba-row-pop-special () (pop *sba-w-pop*))
(sba-def-row sba-row-makunbound-rebind ()
  (makunbound '*sba-w-mk*)
  (set '*sba-w-mk* *sba-w-b*))
(sba-add-row "write/setq" 0 sba-row-setq)
(sba-add-row "write/setf-symbol-value" 0 sba-row-setf-sv)
(sba-add-row "write/set" 0 sba-row-set)
(sba-add-row "write/incf/fixnum" 24 sba-row-incf-fix)
(sba-add-row "write/incf/double-float" 24 sba-row-incf-double)
(sba-add-row "write/cons-onto-special" 32 sba-row-cons-special)
(sba-add-row "write/pop-from-special" 0 sba-row-pop-special)
(sba-add-row "write/makunbound-rebind" 0 sba-row-makunbound-rebind)

(sba-def-row sba-row-let1 () (let ((*sba-b1* *sba-v1*)) *sba-b1*))
(sba-def-row sba-row-let3 ()
  (let ((*sba-b1* *sba-v1*)
        (*sba-b2* *sba-v2*)
        (*sba-b3* *sba-v3*))
    *sba-b3*))
(sba-def-row sba-row-let8 ()
  (let ((*sba-b1* *sba-v1*)
        (*sba-b2* *sba-v2*)
        (*sba-b3* *sba-v3*)
        (*sba-b4* *sba-v4*)
        (*sba-b5* *sba-v5*)
        (*sba-b6* *sba-v6*)
        (*sba-b7* *sba-v7*)
        (*sba-b8* *sba-v8*))
    *sba-b8*))
(sba-def-row sba-row-letstar1 () (let* ((*sba-b1* *sba-v1*)) *sba-b1*))
(sba-def-row sba-row-letstar3 ()
  (let* ((*sba-b1* *sba-v1*)
         (*sba-b2* *sba-v2*)
         (*sba-b3* *sba-v3*))
    *sba-b3*))
(sba-def-row sba-row-letstar8 ()
  (let* ((*sba-b1* *sba-v1*)
         (*sba-b2* *sba-v2*)
         (*sba-b3* *sba-v3*)
         (*sba-b4* *sba-v4*)
         (*sba-b5* *sba-v5*)
         (*sba-b6* *sba-v6*)
         (*sba-b7* *sba-v7*)
         (*sba-b8* *sba-v8*))
    *sba-b8*))
(sba-def-row sba-row-let-fix () (let ((*sba-b1* (+ 1000000 i))) *sba-b1*))
(sba-def-row sba-row-let-double ()
  (let ((*sba-b1* (+ *sba-r-dbl* 1.0d0))) *sba-b1*))
(sba-def-row sba-row-let-nested ()
  (let ((*sba-nest* *sba-nest*))
    (let ((*sba-nest* *sba-nest*))
      (let ((*sba-nest* *sba-nest*))
        (let ((*sba-nest* *sba-nest*))
          (let ((*sba-nest* *sba-nest*))
            (let ((*sba-nest* *sba-nest*))
              (let ((*sba-nest* *sba-nest*))
                (let ((*sba-nest* *sba-nest*))
                  (let ((*sba-nest* *sba-nest*))
                    (let ((*sba-nest* *sba-nest*))
                      *sba-nest*)))))))))))
(sba-def-row sba-row-let-in-loop ()
  (dotimes (j 1000)
    (let ((*sba-loop* *sba-loop*))
      (setq *sba-sink* *sba-loop*)))
  *sba-loop*)
(sba-def-row sba-row-let-mv ()
  (multiple-value-bind (a b)
      (let ((*sba-mv* *sba-mv*))
        (values i (1+ i)))
    (declare (ignore b))
    a))
(sba-def-row sba-row-let-return-from ()
  (block done
    (let ((*sba-ret* *sba-ret*))
      (return-from done i))))
(sba-def-row sba-row-let-throw ()
  (catch 'done
    (let ((*sba-throw* *sba-throw*))
      (throw 'done i))))
(sba-def-row sba-row-throw-plain ()
  (catch 'done
    (throw 'done i)))
(sba-add-row "binding/let/1" 0 sba-row-let1)
(sba-add-row "binding/let/3" 0 sba-row-let3)
(sba-add-row "binding/let/8" 0 sba-row-let8)
(sba-add-row "binding/let*/1" 0 sba-row-letstar1)
(sba-add-row "binding/let*/3" 0 sba-row-letstar3)
(sba-add-row "binding/let*/8" 0 sba-row-letstar8)
(sba-add-row "binding/let/fresh-fixnum" 24 sba-row-let-fix)
(sba-add-row "binding/let/fresh-double-float" 24 sba-row-let-double)
(sba-add-row "binding/let/nested-10" 0 sba-row-let-nested)
(sba-add-row "binding/let/in-loop-1000" 0 sba-row-let-in-loop)
(sba-add-row "binding/let/multiple-values" 0 sba-row-let-mv)
(sba-add-row "binding/let/return-from" 0 sba-row-let-return-from)

(sba-def-row sba-row-progv1 () (progv *sba-syms1* *sba-pvals1* *sba-p1*))
(sba-def-row sba-row-progv3 () (progv *sba-syms3* *sba-pvals3* *sba-p1*))
(sba-def-row sba-row-progv8 () (progv *sba-syms8* *sba-pvals8* *sba-p8*))
(sba-def-row sba-row-progv-fewer ()
  (progv *sba-syms3* *sba-pvals1* *sba-p1*))
(sba-def-row sba-row-progv-empty () (progv nil nil i))
(sba-add-row "progv/1" 0 sba-row-progv1)
(sba-add-row "progv/3" 0 sba-row-progv3)
(sba-add-row "progv/8" 0 sba-row-progv8)
(sba-add-row "progv/fewer-values" 0 sba-row-progv-fewer)
(sba-add-row "progv/empty" 0 sba-row-progv-empty)

(defun sba-rec-bind (n)
  (if (<= n 0)
      0
      (let ((*sba-rec* *sba-rec-val*))
        (sba-rec-bind (1- n)))))
(defun sba-rec-plain (n)
  (if (<= n 0)
      0
      (sba-rec-plain (1- n))))

;;; --- allocation measurement ---

(defun %sba-empty-loop (n) (dotimes (i n) (setq *sba-sink* nil)) *sba-sink*)

(defparameter *sba-baseline* 0)

(defun %sba-bytes-per-call (total)
  (/ (- total *sba-baseline*) (float *sba-iterations*)))

(defun %sba-measure (fn &optional args)
  (let ((all (append args (list *sba-iterations*))))
    (apply fn all)
    (%sba-bytes-per-call
     (min-allocated-bytes (lambda () (apply fn all)) *sba-runs*))))

(defun %sba-measure-recursion (fn depth)
  (funcall fn depth)
  (let ((total (min-allocated-bytes (lambda () (funcall fn depth)) *sba-runs*)))
    (/ (float (- total *sba-baseline*)) depth)))

(defun %sba-allocation-failures ()
  (setq *sba-baseline*
        (min-allocated-bytes (lambda () (%sba-empty-loop *sba-iterations*))
                             *sba-runs*))
  (let ((bad nil))
    (dolist (row (reverse *sba-rows*))
      (destructuring-bind (label floor fn args) row
        (let ((got (%sba-measure fn args)))
          (when (> got (+ floor 8))
            (push (list label got floor) bad)))))
    (let ((per-level (%sba-measure-recursion 'sba-rec-bind 1000)))
      (when (> per-level 8)
        (push (list "binding/recursion-per-level" per-level 0) bad)))
    (nreverse bad)))

;;; Compiled only: the interpreter binds through frames of its own.
(deftest-compiled-only special-binding-allocation.rows-at-floor
  (%sba-allocation-failures)
  nil)

;;; A THROW itself allocates the exception; the binding adds nothing to it.
(deftest-compiled-only special-binding-allocation.throw-cost
  (funcall (lambda (binding plain) (<= (- binding plain) 8.0))
           (%sba-measure 'sba-row-let-throw)
           (%sba-measure 'sba-row-throw-plain))
  t)

;;; --- PROGV binding and unbinding semantics ---

(defun %sba-progv-checks ()
  (let ((bad nil))
    (flet ((check (name got expected)
             (unless (equal got expected)
               (push (list name got expected) bad))))
      (check 'basic
             (progv '(*sba-p1*) (list 1) (list *sba-p1* (boundp '*sba-p2*)))
             '(1 t))
      (check 'fewer
             (progv '(*sba-p1* *sba-p2*) (list 1)
               (list *sba-p1* (boundp '*sba-p2*)))
             '(1 nil))
      (check 'empty (progv nil nil (list *sba-p1* *sba-p2*)) (list 1 2))
      (check 'duplicate
             (progv '(*sba-p1* *sba-p2* *sba-p1*) (list 1 2 3)
               (list *sba-p1* *sba-p2*))
             '(3 2))
      (check 'duplicate-restores (list *sba-p1* *sba-p2*) '(1 2))
      (check 'nested
             (progv '(*sba-p1*) (list 1)
               (list (progv '(*sba-p1*) (list 2) *sba-p1*) *sba-p1*))
             '(2 1))
      (check 'nested-restores *sba-p1* 1)
      (check 'throw
             (catch 'sba-tag
               (progv '(*sba-p1*) (list 9) (throw 'sba-tag *sba-p1*)))
             9)
      (check 'throw-restores *sba-p1* 1)
      (check 'return-from
             (block sba-block
               (progv '(*sba-p1*) (list 8) (return-from sba-block *sba-p1*)))
             8)
      (check 'return-from-restores *sba-p1* 1)
      (check 'setf
             (progv '(*sba-p1*) (list 1)
               (setf (symbol-value '*sba-p1*) 4)
               *sba-p1*)
             4)
      (check 'setf-restores *sba-p1* 1)
      (check 'vals-longer (progv '(*sba-p1*) (list 1 2 3) *sba-p1*) 1)
      (check 'constant-signals
             (handler-case (progn (progv '(nil) (list 1) 2) nil)
               (error () t))
             t)
      (check 'constant-leaves-unbound
             (handler-case (progn (progv '(*sba-p1* nil) (list 1 2) 2) nil)
               (error () (list *sba-p1* (boundp '*sba-p2*))))
             '(1 t))
      (check 'keyword-signals
             (handler-case (progn (progv '(:sba-k) (list 1) 2) nil)
               (error () t))
             t)
      (check 'not-a-symbol-signals
             (handler-case (progn (progv '(1) (list 1) 2) nil)
               (error () t))
             t)
      (check 'improper-symbols-signals
             (handler-case
                 (progn (progv (cons '*sba-p1* 5) (list 1) 2) nil)
               (error () t))
             t)
      (check 'improper-values-signals
             (handler-case
                 (progn (progv '(*sba-p1*) (cons 1 5) 2) nil)
               (error () t))
             t)
      (check 'improper-values-leaves-unbound
             (handler-case
                 (progn (progv '(*sba-p1*) (cons 1 5) 2) nil)
               (error () (list *sba-p1* (boundp '*sba-p2*))))
             '(1 t)))
    (nreverse bad)))

(deftest special-binding-allocation.progv-behavior
  (%sba-progv-checks)
  nil)
