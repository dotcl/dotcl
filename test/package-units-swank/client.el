;;; -*- lexical-binding: t -*-
;; emacs --batch -Q -l client.el, with SLIME_DIR, PORT and PROBE (probe.lisp).
(add-to-list 'load-path (getenv "SLIME_DIR"))
(add-to-list 'load-path (expand-file-name "contrib" (getenv "SLIME_DIR")))
(require 'slime)
(slime-setup '(slime-fancy))
(defvar probe (with-temp-buffer (insert-file-contents (getenv "PROBE")) (buffer-string)))
(advice-add 'y-or-n-p :around (lambda (_f prompt) (princ (format "PROMPT => %S\n" prompt)) t))
(advice-add 'sldb-setup :around
            (lambda (f thread level condition &rest rest)
              (princ (format "SLDB => %S\n" (car condition)))
              (apply f thread level condition rest)
              (with-current-buffer (sldb-get-buffer thread) (sldb-quit))))
(defun report (tag thunk)
  (condition-case err (princ (format "%s => %S\n" tag (funcall thunk)))
    (error (princ (format "%s => ERROR %S\n" tag err)))))
(defun ev (s) (car (cdr (slime-eval `(swank:eval-and-grab-output ,s)))))
(defun rev (s)
  (let ((slime-current-thread :repl-thread))
    (slime-eval `(swank-repl:listener-eval ,(format "(progn (setq cl-user::*probe-r* %s) nil)" s))))
  (ev "cl-user::*probe-r*"))
(slime-connect "127.0.0.1" (string-to-number (getenv "PORT")))
(let ((n 0))
  (while (and (< n 300) (not (and (slime-connected-p) (slime-connection-name))))
    (accept-process-output nil 0.1) (setq n (1+ n))))
(dotimes (_ 30) (accept-process-output nil 0.1))
(when (slime-connected-p)
  (report "version" (lambda () (plist-get (slime-eval '(swank:connection-info)) :version)))
  (report "completion" (lambda () (car (slime-eval '(swank:simple-completions "swank:conn" "COMMON-LISP-USER")))))
  (report "probe worker" (lambda () (ev probe)))
  (report "probe repl" (lambda () (rev probe)))
  (report "probe thread"
          (lambda () (rev (format "(let ((v :timeout)) (swank/backend:spawn (lambda () (setq v (eval (read-from-string %s))))) (loop repeat 200 while (eq v :timeout) do (sleep 0.05)) v)"
                                  (prin1-to-string probe)))))
  (report "repl" (lambda () (rev "(+ 1 2)")))
  (slime-disconnect))
(princ "DONE\n")
