;;; Compare .NET GC latency settings on an allocation-heavy Lisp workload.

(defparameter *rounds* 5)
(defparameter *cons-loops* 60000)
(defparameter *tree-size* 180000)
(defparameter *warmup-calls* 35)
(defparameter *warmup-cons-loops* 1000)
(defparameter *warmup-tree-size* 3000)

(defparameter *modes* '("default" "concurrent0" "batch" "sll"))

(defun mode-label (mode)
  (cond ((string= mode "concurrent0") "gcConcurrent=0")
        ((string= mode "batch") "Batch")
        ((string= mode "sll") "SustainedLowLatency")
        (t "default")))

(defun words (string)
  (let ((result nil) (start nil))
    (dotimes (i (length string))
      (if (member (char string i) '(#\Space #\Tab #\Return #\Newline))
          (when start (push (subseq string start i) result) (setf start nil))
          (unless start (setf start i))))
    (when start (push (subseq string start) result))
    (nreverse result)))

(defun starts-with-p (prefix string)
  (and (>= (length string) (length prefix))
       (string= prefix string :end2 (length prefix))))

(defun env-entry-p (name entry)
  (let ((n (length name)))
    (and (>= (length entry) (1+ n))
         (string= entry name :end1 n)
         (char= (char entry n) #\=))))

(defun parse-number (string)
  (multiple-value-bind (value pos) (read-from-string string)
    (declare (ignore pos))
    value))

(defun median (values)
  (let* ((sorted (sort (copy-list values) #'<))
         (n (length sorted)))
    (if (oddp n)
        (nth (floor n 2) sorted)
        (/ (+ (nth (1- (floor n 2)) sorted) (nth (floor n 2) sorted)) 2.0))))

(defun latency-value (name)
  (dotnet:enum-or "System.Runtime.GCLatencyMode" name))

(defun latency-name ()
  (dotnet:invoke (dotnet:static "System.Runtime.GCSettings" "LatencyMode") "ToString"))

(defstruct (node (:constructor make-node (key left right)))
  (key 0 :type fixnum) left right)

(declaim (inline insert))
(defun insert (tree key)
  (if (null tree)
      (make-node key nil nil)
      (let ((k (node-key tree)))
        (if (< key k)
            (make-node k (insert (node-left tree) key) (node-right tree))
            (make-node k (node-left tree) (insert (node-right tree) key))))))

(defun tree-count (tree)
  (if tree (+ 1 (tree-count (node-left tree)) (tree-count (node-right tree))) 0))

(defun tree-build (n)
  (let ((tree nil) (seed 2463534242))
    (dotimes (i n)
      (setf seed (logand #xFFFFFFFF (logxor seed (ash seed 13))))
      (setf seed (logand #xFFFFFFFF (logxor seed (ash seed -17))))
      (setf seed (logand #xFFFFFFFF (logxor seed (ash seed 5))))
      (setf tree (insert tree (logand seed #x3FFFFFFF))))
    (tree-count tree)))

(defun cons-churn (loops)
  (let ((sum 0))
    (dotimes (j loops)
      (let ((list nil))
        (dotimes (i 1000) (push i list))
        (incf sum (length list))))
    sum))

(defun workload ()
  (+ (cons-churn *cons-loops*) (tree-build *tree-size*)))

(defun warm-up ()
  (dotimes (i *warmup-calls*)
    (cons-churn *warmup-cons-loops*)
    (tree-build *warmup-tree-size*)))

(defun measure (thunk)
  (let* ((stats0 (dotcl:gc-stats))
         (t0 (get-internal-real-time))
         (value (funcall thunk))
         (t1 (get-internal-real-time))
         (stats1 (dotcl:gc-stats)))
    (values (/ (float (- t1 t0)) internal-time-units-per-second)
            (- (nth 4 stats1) (nth 4 stats0))
            (/ (float (- (nth 5 stats1) (nth 5 stats0)))
               internal-time-units-per-second)
            value)))

(defun worker (mode)
  (let ((configuration (dotnet:static "System.GC" "GetConfigurationVariables")))
    (format t "META server=~A concurrent=~A initial=~A~%"
            (if (dotnet:static "System.Runtime.GCSettings" "IsServerGC")
                "server" "workstation")
            (dotnet:invoke configuration "get_Item" "ConcurrentGC")
            (latency-name)))
  (warm-up)
  (let ((old (dotnet:static "System.Runtime.GCSettings" "LatencyMode")))
    (unwind-protect
         (progn
           (when (member mode '("batch" "sll") :test #'string=)
             (setf (dotnet:static "System.Runtime.GCSettings" "LatencyMode")
                   (latency-value (if (string= mode "batch")
                                      "Batch"
                                      "SustainedLowLatency")))
             (format t "SET ~A~%" (latency-name)))
           (multiple-value-bind (seconds allocated pause value)
               (measure #'workload)
             (format t "RESULT ~,6F ~D ~,6F ~D~%" seconds allocated pause value)))
      (setf (dotnet:static "System.Runtime.GCSettings" "LatencyMode") old)
      (format t "RESTORED ~A~%" (latency-name))))
  (finish-output))

(defun self-command ()
  (let* ((path (dotnet:static "System.Environment" "ProcessPath"))
         (args (dotnet:static "System.Environment" "GetCommandLineArgs"))
         (count (dotnet:invoke args "Length"))
         (argv (loop for i below count collect (dotnet:invoke args "GetValue" i)))
         (name (string-downcase (file-namestring (pathname path))))
         (dotnet-host (or (string= name "dotnet") (string= name "dotnet.exe"))))
    (if dotnet-host (cons path argv) (cons path (cdr argv)))))

(defun child-environment (mode)
  (let ((environment
          (remove-if (lambda (entry)
                       (or (env-entry-p "DOTCL_GC_LATENCY_MODE" entry)
                           (env-entry-p "DOTNET_gcConcurrent" entry)
                           (env-entry-p "COMPlus_gcConcurrent" entry)
                           (env-entry-p "DOTNET_gcServer" entry)
                           (env-entry-p "COMPlus_gcServer" entry)
                           (env-entry-p "DOTNET_TieredCompilation" entry)
                           (env-entry-p "COMPlus_TieredCompilation" entry)))
                     (dotcl:posix-environ))))
    (cons (format nil "DOTCL_GC_LATENCY_MODE=~A" mode)
          (cons "DOTNET_gcServer=0"
                (cons (format nil "DOTNET_gcConcurrent=~A"
                              (if (string= mode "concurrent0") 0 1))
                      environment)))))

(defun run-worker (mode)
  (let* ((command (self-command))
         (output (make-string-output-stream))
         (error-output (make-string-output-stream))
         (process (apply #'dotcl:launch-process (first command) (rest command)
                         (list :environment (child-environment mode)
                               :input nil :output output :error error-output)))
         (code (dotcl:process-wait process))
         (stdout (get-output-stream-string output))
         (stderr (get-output-stream-string error-output)))
    (unless (zerop code)
      (error "~A worker exited ~D: ~A" mode code stderr))
    (let ((lines (with-input-from-string (stream stdout)
                   (loop for line = (read-line stream nil nil)
                         while line collect line))))
      (values (find-if (lambda (line) (starts-with-p "RESULT " line)) lines)
              (find-if (lambda (line) (starts-with-p "META " line)) lines)
              stdout))))

(defun parse-result (line)
  (let ((fields (words line)))
    (values (parse-number (second fields))
            (parse-number (third fields))
            (parse-number (fourth fields)))))

(defun run-all ()
  (let ((results (make-hash-table :test #'equal))
        (metas (make-hash-table :test #'equal)))
    (loop for round from 1 to *rounds* do
      (let ((order (append (nthcdr (mod round (length *modes*)) *modes*)
                           (subseq *modes* 0 (mod round (length *modes*))))))
        (dolist (mode order)
          (format t ";; run ~D/~D ~A~%" round *rounds* (mode-label mode))
          (finish-output)
          (multiple-value-bind (result meta stdout) (run-worker mode)
            (unless result
              (error "~A worker printed no result: ~S" mode stdout))
            (unless (gethash mode metas)
              (setf (gethash mode metas) meta))
            (multiple-value-bind (seconds allocated pause) (parse-result result)
              (push (list seconds allocated pause) (gethash mode results)))))))
    (values results metas)))

(defun report (results metas)
  (format t "~&~20A~12A~12A~12A~12A~%"
          "mode" "min s" "median s" "alloc MiB" "pause s")
  (dolist (mode *modes*)
    (let* ((rows (reverse (gethash mode results)))
           (seconds (mapcar #'first rows))
           (allocated (mapcar #'second rows))
           (pause (mapcar #'third rows)))
      (format t "~20A~12,3F~12,3F~12,1F~12,3F~%"
              (mode-label mode)
              (apply #'min seconds)
              (median seconds)
              (/ (reduce #'+ allocated) (* (length rows) (expt 2 20)))
              (/ (reduce #'+ pause) (length rows)))))
  (format t "~&~%child configuration:~%")
  (dolist (mode *modes*)
    (format t "  ~A: ~A~%" (mode-label mode) (gethash mode metas))))

(let ((mode (dotcl:getenv "DOTCL_GC_LATENCY_MODE")))
  (if mode
      (worker mode)
      (multiple-value-bind (results metas) (run-all)
        (report results metas))))
