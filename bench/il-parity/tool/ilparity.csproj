<Project Sdk="Microsoft.NET.Sdk">

  <!-- No PackageReference on purpose. System.Reflection.Metadata ships with the
       runtime, and the opcode table is reflected out of System.Reflection.Emit
       rather than transcribed, so this tool builds in a checkout that has never
       reached a NuGet feed. A comparison tool that needs the network to run is
       one more thing between a measurement and the person who wants it. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>ilparity</AssemblyName>
    <RootNamespace>IlParity.Tool</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
