;;; MAKE-INSTANCE cost matrix for classes with and without :DEFAULT-INITARGS.
(defvar *di-value* 42)
(defvar *n* 1000000)
(defvar *reps* 5)

(defclass p0 () ())
(defclass c0 () () (:default-initargs :a 42))
(defclass e0 () () (:default-initargs :a *di-value*))

(defclass p2 () ((a :initarg :a :initform 0) (b :initarg :b :initform 0)))
(defclass v2 () ((a :initarg :a :initform *di-value*) (b :initarg :b :initform *di-value*)))
(defclass c2 () ((a :initarg :a :initform 0) (b :initarg :b :initform 0)) (:default-initargs :a 42))
(defclass e2 () ((a :initarg :a :initform 0) (b :initarg :b :initform 0)) (:default-initargs :a *di-value*))
(defclass cv2 () ((a :initarg :a :initform *di-value*) (b :initarg :b :initform *di-value*)) (:default-initargs :a 42))

(defclass p5 () ((a :initarg :a :initform 0) (b :initarg :b :initform 0) (c :initarg :c :initform 0) (d :initarg :d :initform 0) (e :initarg :e :initform 0)))
(defclass v5 () ((a :initarg :a :initform *di-value*) (b :initarg :b :initform *di-value*) (c :initarg :c :initform *di-value*) (d :initarg :d :initform *di-value*) (e :initarg :e :initform *di-value*)))
(defclass c5 () ((a :initarg :a :initform 0) (b :initarg :b :initform 0) (c :initarg :c :initform 0) (d :initarg :d :initform 0) (e :initarg :e :initform 0)) (:default-initargs :a 42))
(defclass e5 () ((a :initarg :a :initform 0) (b :initarg :b :initform 0) (c :initarg :c :initform 0) (d :initarg :d :initform 0) (e :initarg :e :initform 0)) (:default-initargs :a *di-value*))
(defclass cv5 () ((a :initarg :a :initform *di-value*) (b :initarg :b :initform *di-value*) (c :initarg :c :initform *di-value*) (d :initarg :d :initform *di-value*) (e :initarg :e :initform *di-value*)) (:default-initargs :a 42))

(defclass s2 () ((a :initarg :a :initform 0) (b :initarg :b :initform 0)
                 (cs :initarg :cs :initform 0 :allocation :class)))
(defclass s5 () ((a :initarg :a :initform 0) (b :initarg :b :initform 0)
                 (c :initarg :c :initform 0) (d :initarg :d :initform 0)
                 (e :initarg :e :initform 0)
                 (cs :initarg :cs :initform 0 :allocation :class)))

(defmacro def-row (name class &rest initargs)
  `(defun ,name (n)
     (declare (fixnum n))
     (dotimes (i n)
       (make-instance ',class ,@initargs))))

(def-row rp0 p0)
(def-row rc0 c0)
(def-row rc0c c0 :a 7)
(def-row re0 e0)
(def-row re0c e0 :a 7)

(def-row rp2 p2)
(def-row rp2c p2 :a 7)
(def-row rv2 v2)
(def-row rv2c v2 :a 7)
(def-row rc2 c2)
(def-row rc2c c2 :a 7)
(def-row re2 e2)
(def-row re2c e2 :a 7)
(def-row rcv2 cv2)
(def-row rcv2c cv2 :a 7)

(def-row rp5 p5)
(def-row rp5c p5 :a 7)
(def-row rv5 v5)
(def-row rv5c v5 :a 7)
(def-row rc5 c5)
(def-row rc5c c5 :a 7)
(def-row re5 e5)
(def-row re5c e5 :a 7)
(def-row rcv5 cv5)
(def-row rcv5c cv5 :a 7)

(def-row rs2 s2)
(def-row rs2c s2 :a 7)
(def-row rs5 s5)
(def-row rs5c s5 :a 7)

(defun now ()
  #+sbcl (multiple-value-bind (s us) (sb-ext:get-time-of-day)
           (+ s (/ us 1000000d0)))
  #-sbcl (/ (get-internal-real-time)
            (float internal-time-units-per-second 1d0)))

(defun bytes ()
  #+dotcl (nth 4 (dotcl:gc-stats))
  #+sbcl (sb-ext:get-bytes-consed)
  #-(or dotcl sbcl) 0)

(defun time-row (label fn n reps)
  (funcall fn (min n 100000))
  (let ((best most-positive-double-float)
        (b0 (bytes)))
    (dotimes (k reps)
      (let ((t0 (now)))
        (funcall fn n)
        (setf best (min best (- (now) t0)))))
    (format t "~&~12a ~8,2f ms ~8,1f ns/op ~6,1f B/op~%"
            label (* 1000d0 best) (/ (* best 1d9) n)
            (/ (- (bytes) b0) (float (* n reps))))))

(format t "~&~a ~a~%" (lisp-implementation-type) (lisp-implementation-version))
(time-row "p0" #'rp0 *n* *reps*)
#+dotcl (time-row "c0" #'rc0 *n* *reps*)
#+dotcl (time-row "c0 call" #'rc0c *n* *reps*)
#+dotcl (time-row "e0" #'re0 *n* *reps*)
#+dotcl (time-row "e0 call" #'re0c *n* *reps*)

(time-row "p2" #'rp2 *n* *reps*)
(time-row "p2 call" #'rp2c *n* *reps*)
(time-row "v2" #'rv2 *n* *reps*)
(time-row "v2 call" #'rv2c *n* *reps*)
(time-row "c2" #'rc2 *n* *reps*)
(time-row "c2 call" #'rc2c *n* *reps*)
(time-row "e2" #'re2 *n* *reps*)
(time-row "e2 call" #'re2c *n* *reps*)
(time-row "cv2" #'rcv2 *n* *reps*)
(time-row "cv2 call" #'rcv2c *n* *reps*)

(time-row "p5" #'rp5 *n* *reps*)
(time-row "p5 call" #'rp5c *n* *reps*)
(time-row "v5" #'rv5 *n* *reps*)
(time-row "v5 call" #'rv5c *n* *reps*)
(time-row "c5" #'rc5 *n* *reps*)
(time-row "c5 call" #'rc5c *n* *reps*)
(time-row "e5" #'re5 *n* *reps*)
(time-row "e5 call" #'re5c *n* *reps*)
(time-row "cv5" #'rcv5 *n* *reps*)
(time-row "cv5 call" #'rcv5c *n* *reps*)

#+dotcl (time-row "s2" #'rs2 *n* *reps*)
#+dotcl (time-row "s2 call" #'rs2c *n* *reps*)
#+dotcl (time-row "s5" #'rs5 *n* *reps*)
#+dotcl (time-row "s5 call" #'rs5c *n* *reps*)
