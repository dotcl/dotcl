;;;; Per-test timing driver for the ironclad rt suite, on dotcl or SBCL.
;;;;
;;;; Environment:
;;;;   IC_DIR    directory tree holding ironclad, rt and their dependencies
;;;;   IC_REPS   timed repetitions of each test (default 1); the minimum is printed
;;;;   IC_CATS   comma-separated categories to run (default: all)
;;;;   IC_ONLY   comma-separated test names to run (default: all)
;;;;
;;;; Prints one line per test:  TIME <category> <test> <seconds> <ok|FAIL> <MB consed>

(require "asdf")
(defvar *ic* (uiop:getenv "IC_DIR"))
(defun env-list (name)
  (let ((s (uiop:getenv name)))
    (and s (> (length s) 0)
         (mapcar #'string-upcase (uiop:split-string s :separator ",")))))
(defvar *only* (env-list "IC_ONLY"))
(defvar *cats* (env-list "IC_CATS"))
(defvar *reps* (parse-integer (or (uiop:getenv "IC_REPS") "1")))
(asdf:initialize-source-registry
 `(:source-registry (:tree ,(uiop:ensure-directory-pathname *ic*)) :ignore-inherited-configuration))
(asdf:load-system "rt")
(defvar *test-file* (make-hash-table :test 'equal))
(let ((old (fdefinition (find-symbol "ADD-ENTRY" "RTEST"))))
  (setf (fdefinition (find-symbol "ADD-ENTRY" "RTEST"))
        (lambda (entry)
          (setf (gethash (string (funcall (find-symbol "NAME" "RTEST") entry)) *test-file*)
                (and *load-truename* (pathname-name *load-truename*)))
          (funcall old entry))))
(asdf:load-system "ironclad/tests")
(defun category (file)
  (cond ((null file) "?")
        ((member file '("ciphers" "modes") :test #'string=) "cipher")
        ((string= file "digests") "digest")
        ((string= file "macs") "mac")
        ((member file '("pkcs5" "argon2d" "argon2i" "argon2id" "bcrypt" "scrypt" "hmac-kdf")
                 :test #'string=) "kdf")
        ((string= file "aead") "aead")
        ((string= file "prng-tests") "prng")
        ((string= file "public-key") "pubkey")
        (t file)))
(defvar *names* (mapcar (lambda (e) (funcall (find-symbol "NAME" "RTEST") e))
                        (cdr (symbol-value (find-symbol "*ENTRIES*" "RTEST")))))
(defun bytes () #+dotcl (nth 4 (dotcl:gc-stats)) #+sbcl (sb-ext:get-bytes-consed))
(dolist (name *names*)
  (let ((cat (category (gethash (string name) *test-file*))))
    (when (and (or (null *only*) (member (string name) *only* :test #'string=))
               (or (null *cats*) (member (string-upcase cat) *cats* :test #'string=)))
      (let ((best nil) ok (b0 (bytes)))
        (dotimes (i *reps*)
          (let ((t0 (get-internal-real-time)))
            (setf ok (let ((*standard-output* (make-broadcast-stream)))
                       (funcall (find-symbol "DO-TEST" "RTEST") name)))
            (let ((dt (/ (- (get-internal-real-time) t0) internal-time-units-per-second)))
              (setf best (if best (min best dt) dt)))))
        (format t "~&TIME ~a ~a ~,3f ~a ~,1f~%" cat name best (if ok "ok" "FAIL")
                (/ (- (bytes) b0) 1048576d0 *reps*))
        (finish-output)))))
#+dotcl (dotcl:quit 0)
#+sbcl (sb-ext:exit :code 0)
