(load "bench/perf/pcommon.lisp")
(setf *bench-group* "1-closure")
;; closures that call the next closure, as cl-ppcre's matchers do: 1 to 4 hops and the end function
(defun end-fn (pos) (declare (fixnum pos)) pos)
(declaim (notinline end-fn))
(defun mk-id () (lambda (pos) pos))
(defun mk-a (next) (declare (function next)) (lambda (pos) (funcall next pos)))
(defvar *id* (mk-id))
(defvar *c1* (mk-a *id*)) (defvar *c2* (mk-a *c1*)) (defvar *c3* (mk-a *c2*)) (defvar *c4* (mk-a *c3*))
(defvar *sink* 0)
(defun via-fn (m) (declare (function m)) (let ((n 0)) (declare (fixnum n)) (dotimes (i 1000) (when (funcall m 5) (incf n))) n))
(defun empty () (let ((n 0)) (declare (fixnum n)) (dotimes (i 1000) (incf n)) n))
(bench "empty loop x1000" 50000 (setq *sink* (empty)))
(bench "funcall end function x1000" 50000 (setq *sink* (via-fn #'end-fn)))
(bench "closure (0 hops + end) x1000" 50000 (setq *sink* (via-fn *id*)))
(bench "closure chain 1 hop x1000" 50000 (setq *sink* (via-fn *c1*)))
(bench "closure chain 2 hops x1000" 50000 (setq *sink* (via-fn *c2*)))
(bench "closure chain 3 hops x1000" 50000 (setq *sink* (via-fn *c3*)))
(bench "closure chain 4 hops x1000" 50000 (setq *sink* (via-fn *c4*)))
