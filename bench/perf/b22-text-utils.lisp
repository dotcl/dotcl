(load "bench/perf/pcommon.lisp")
(setf *bench-group* "22-text-utils")
;; cl-base64, md5, split-sequence, str: the typical call of each on 100 KB-1 MB inputs.
;; Libraries to install on the runner: cl-base64 md5 split-sequence str cl-csv
(load-ql-system :cl-base64)
(load-ql-system :md5)
(load-ql-system :split-sequence)
(load-ql-system :str)
(load-ql-system :cl-csv)
(defvar *sink* nil)
(defvar *oct* (let ((a (make-array 262144 :element-type '(unsigned-byte 8)))) (dotimes (i (length a) a) (setf (aref a i) (mod (* i 31) 251)))))
(defvar *b64* (cl-base64:usb8-array-to-base64-string *oct*))
(defvar *text* (with-output-to-string (s) (dotimes (i 20000) (format s "word~D,item ~D;" i (mod i 97)))))
(defvar *csv* (with-output-to-string (s) (dotimes (i 5000) (format s "~D,\"name ~D\",~D.5,x~%" i i i))))
(bench "cl-base64 encode 256 KB" 10 (setq *sink* (cl-base64:usb8-array-to-base64-string *oct*)))
(bench "cl-base64 decode 256 KB" 10 (setq *sink* (cl-base64:base64-string-to-usb8-array *b64*)))
(bench "md5sum-sequence 256 KB" 10 (setq *sink* (md5:md5sum-sequence *oct*)))
(bench "split-sequence on #\; 300 KB" 20 (setq *sink* (split-sequence:split-sequence #\; *text*)))
(bench "str:split on , 300 KB" 20 (setq *sink* (str:split "," *text*)))
(bench "str:join of 30000 strings" 20 (setq *sink* (str:join "," (str:split ";" *text*))))
(bench "str:replace-all 300 KB" 10 (setq *sink* (str:replace-all "item" "ITEM" *text*)))
(bench "str:trim / str:starts-with-p / str:contains-p x1000" 20
  (dotimes (i 1000) (setq *sink* (list (str:trim "   hello world   ") (str:starts-with-p "hello" "hello world") (str:contains? "wor" "hello world")))))
(bench "cl-csv read 5000 rows" 10 (setq *sink* (cl-csv:read-csv *csv*)))
