(load "bench/perf/pcommon.lisp")
(setf *bench-group* "8-flatten")
;; alexandria:flatten and the shapes inside it: a LABELS closure walking a tree, the same walk as a global
;; function, and the walk without collecting.
(load-ql-system :alexandria)
(defun mk-tree (depth)
  (if (zerop depth) (list 1 2 3) (list 1 (mk-tree (1- depth)) 2 3)))
(defvar *tree* (mk-tree 200))
(defvar *sink* nil)
(defun walk-labels (tree)
  (let ((n 0))
    (declare (fixnum n))
    (labels ((traverse (subtree)
               (when subtree
                 (if (consp subtree)
                     (progn (traverse (car subtree)) (traverse (cdr subtree)))
                     (incf n)))))
      (traverse tree))
    n))
(defun walk-global (subtree n)
  (declare (fixnum n))
  (cond ((null subtree) n)
        ((consp subtree) (walk-global (cdr subtree) (walk-global (car subtree) n)))
        (t (1+ n))))
(defun collect-labels (tree)
  (let (list)
    (labels ((traverse (subtree)
               (when subtree
                 (if (consp subtree)
                     (progn (traverse (car subtree)) (traverse (cdr subtree)))
                     (push subtree list)))))
      (traverse tree))
    (nreverse list)))
(bench "alexandria:flatten, 200 nested" 20000 (setq *sink* (funcall (intern "FLATTEN" "ALEXANDRIA") *tree*)))
(bench "labels collect + nreverse" 20000 (setq *sink* (collect-labels *tree*)))
(bench "labels walk, no collect" 20000 (setq *sink* (walk-labels *tree*)))
(bench "global walk, no collect" 20000 (setq *sink* (walk-global *tree* 0)))
