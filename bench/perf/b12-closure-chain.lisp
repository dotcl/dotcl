(load "bench/perf/pcommon.lisp")
(setf *bench-group* "12-closure-chain")
;; 8-closure chains, a non-tail and a tail form, each hop a closure that calls the next (the shape of cl-ppcre's matchers).
;; Per-hop cost = (chain of 8 - chain of 0) / 8 per 1000 calls. For perf, closure-chain-loop.lisp has the same shapes in a long loop.
(defvar *str* (make-string 100 :initial-element #\a))
(defvar *end* 100)
(declaim (type simple-string *str*) (type fixnum *end*))
(defun mk-end () (lambda (pos) (declare (fixnum pos)) pos))
(defun mk-tail (next) (declare (function next)) (lambda (pos) (funcall next pos)))
(defun mk-fix (next) (declare (function next)) (lambda (pos) (declare (fixnum pos)) (funcall next (1+ pos))))
(defun mk-nontail (next) (declare (function next))
  (lambda (pos) (declare (fixnum pos)) (let ((r (funcall next pos))) (if r (1+ (the fixnum r)) nil))))
(defun mk-ch (next) (declare (function next))
  (lambda (pos) (declare (fixnum pos)) (and (< pos *end*) (char= (schar *str* pos) #\a) (funcall next (1+ pos)))))
(defun mk-ch-lex (next str end) (declare (function next) (simple-string str) (fixnum end))
  (lambda (pos) (declare (fixnum pos)) (and (< pos end) (char= (schar str pos) #\a) (funcall next (1+ pos)))))
(defun chain (mk n &rest extra) (let ((f (mk-end))) (dotimes (i n f) (setq f (apply mk f extra)))))
(defvar *c0* (mk-end))
(defvar *tail8* (chain #'mk-tail 8)) (defvar *fix8* (chain #'mk-fix 8)) (defvar *nontail8* (chain #'mk-nontail 8))
(defvar *ch8* (chain #'mk-ch 8)) (defvar *chlex8* (chain #'mk-ch-lex 8 *str* *end*))
(defvar *sink* 0)
(defun run (m) (declare (function m)) (let ((n 0)) (declare (fixnum n)) (dotimes (i 1000) (let ((r (funcall m (mod i 90)))) (when r (incf n (the fixnum r))))) n))
(bench "chain 0 hops (end only) x1000" 20000 (setq *sink* (run *c0*)))
(bench "chain 8 hops untyped tail x1000" 20000 (setq *sink* (run *tail8*)))
(bench "chain 8 hops fixnum (1+ pos) x1000" 20000 (setq *sink* (run *fix8*)))
(bench "chain 8 hops non-tail result (if r (1+ r)) x1000" 20000 (setq *sink* (run *nontail8*)))
(bench "chain 8 hops cl-ppcre shape, special end/str x1000" 20000 (setq *sink* (run *ch8*)))
(bench "chain 8 hops cl-ppcre shape, lexical end/str x1000" 20000 (setq *sink* (run *chlex8*)))
