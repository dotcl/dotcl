(load "bench/perf/pcommon.lisp")
(setf *bench-group* "2-fset")
(load-ql-system :fset)
(defpackage :b2 (:use :cl))
(in-package :b2)
(defvar *sink* nil)
(defvar *set* (fset:convert 'fset:set (loop for i below 20000 collect (* 2 i))))
(defvar *map* (let ((m (fset:empty-map))) (dotimes (i 20000 m) (setq m (fset:with m (* 2 i) i)))))
(defvar *keys* (coerce (loop for i below 1000 collect (* 2 (mod (* i 7919) 20000))) 'simple-vector))
(defun with-new (s) (let ((r s)) (dotimes (i 100 r) (setq r (fset:with s (+ 100001 (* 2 i)))))))
(defun less-old (s) (let ((r s)) (dotimes (i 100 r) (setq r (fset:less s (svref *keys* i))))))
(defun contains (s) (let ((n 0)) (declare (fixnum n)) (dotimes (i 1000 n) (when (fset:contains? s (svref *keys* i)) (incf n)))))
(defun mwith-new (m) (let ((r m)) (dotimes (i 100 r) (setq r (fset:with m (+ 100001 (* 2 i)) i)))))
(defun mless-old (m) (let ((r m)) (dotimes (i 100 r) (setq r (fset:less m (svref *keys* i))))))
(defun mlookup (m) (let ((n 0)) (dotimes (i 1000 n) (when (fset:lookup m (svref *keys* i)) (incf n)))))
(defun build-set () (fset:convert 'fset:set (loop for i below 2000 collect i)))
(cl-user::bench "set with new element (20000 set) x100" 5000 (setq *sink* (with-new *set*)))
(cl-user::bench "set less existing element x100" 5000 (setq *sink* (less-old *set*)))
(cl-user::bench "set contains? x1000" 5000 (setq *sink* (contains *set*)))
(cl-user::bench "map with new key (20000 map) x100" 5000 (setq *sink* (mwith-new *map*)))
(cl-user::bench "map less existing key x100" 5000 (setq *sink* (mless-old *map*)))
(cl-user::bench "map lookup x1000" 5000 (setq *sink* (mlookup *map*)))
(cl-user::bench "convert 2000-element list to set" 100 (setq *sink* (build-set)))
