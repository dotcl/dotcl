(load "bench/perf/pcommon.lisp")
(setf *bench-group* "24-alexandria")
;; alexandria / serapeum: the frequently used utilities, each on a few thousand elements.
;; Libraries to install on the runner: alexandria serapeum
(load-ql-system :alexandria)
(load-ql-system :serapeum)
(defvar *sink* nil)
(defvar *list* (loop for i below 5000 collect i))
(defvar *vec* (coerce *list* 'vector))
(defvar *ht* (let ((h (make-hash-table))) (dotimes (i 5000 h) (setf (gethash i h) (* i i)))))
(defvar *plist* (loop for i below 1000 append (list (intern (format nil "K~D" i) :keyword) i)))
(defvar *nested* (loop for i below 300 collect (list i (list i i) (list (list i)))))
(bench "alexandria:iota 5000" 200 (setq *sink* (alexandria:iota 5000)))
(bench "alexandria:flatten nested 300" 200 (setq *sink* (alexandria:flatten *nested*)))
(bench "alexandria:hash-table-keys/values 5000" 100 (setq *sink* (list (alexandria:hash-table-keys *ht*) (alexandria:hash-table-values *ht*))))
(bench "alexandria:hash-table-alist + alist-hash-table 5000" 50 (setq *sink* (alexandria:alist-hash-table (alexandria:hash-table-alist *ht*))))
(bench "alexandria:plist-alist / alist-plist 1000" 200 (setq *sink* (alexandria:alist-plist (alexandria:plist-alist *plist*))))
(bench "alexandria:mappend 5000" 100 (setq *sink* (alexandria:mappend (lambda (x) (list x x)) *list*)))
(bench "alexandria:shuffle copy 5000 vector" 50 (setq *sink* (alexandria:shuffle (copy-seq *vec*))))
(bench "alexandria:rotate / subseq* / last-elt x500" 100 (dotimes (i 500) (setq *sink* (list (alexandria:rotate (list 1 2 3 4 5) 2) (alexandria:last-elt *vec*)))))
(bench "alexandria:ensure-gethash x1000" 100 (let ((h (make-hash-table))) (dotimes (i 1000) (alexandria:ensure-gethash (mod i 100) h i)) (setq *sink* h)))
(bench "alexandria:with-input-from-file-ish: read-file-into-string" 20
  (setq *sink* (alexandria:read-file-into-string "bench/perf/pcommon.lisp")))
(bench "serapeum:partition 5000" 100 (setq *sink* (multiple-value-list (serapeum:partition #'evenp *list*))))
(bench "serapeum:assort 5000 mod 7" 50 (setq *sink* (serapeum:assort *list* :key (lambda (x) (mod x 7)))))
(bench "serapeum:frequencies 5000" 50 (setq *sink* (serapeum:frequencies (mapcar (lambda (x) (mod x 13)) *list*))))
(bench "serapeum:string-join / split-sequence" 50 (setq *sink* (serapeum:string-join (serapeum:split-sequence #\, "a,b,c,d,e,f,g,h,i,j") "-")))
(bench "serapeum:mapply / take / drop 5000" 100 (setq *sink* (list (serapeum:take 100 *list*) (serapeum:drop 100 *list*))))
(bench "serapeum:dict + href x200" 100
  (let ((d (serapeum:dict))) (dotimes (i 200) (setf (serapeum:href d i) i)) (setq *sink* (serapeum:href d 100))))
