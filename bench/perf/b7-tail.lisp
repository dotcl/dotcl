(load "bench/perf/pcommon.lisp")
(setf *bench-group* "7-tail")
;; calls in tail position: a self tail call in labels, mutual tail calls, a closure that tail-calls a closure, and the
;; shape of a cl-ppcre matcher (test, then tail-call the next matcher with pos+1)
(defvar *sink* 0)
(defun labels-self () (labels ((lp (n acc) (declare (fixnum n acc)) (if (zerop n) acc (lp (1- n) (logand (+ acc n) 1023))))) (lp 1000 0)))
(defun labels-mutual () (labels ((ev (n) (declare (fixnum n)) (if (zerop n) t (od (1- n)))) (od (n) (declare (fixnum n)) (if (zerop n) nil (ev (1- n))))) (ev 1000)))
(defun closure-self () (let ((f nil)) (setq f (lambda (k) (declare (fixnum k)) (if (zerop k) :done (funcall (the function f) (1- k))))) (funcall (the function f) 1000)))
(defun mk-test (next) (declare (function next))
  (lambda (pos) (declare (fixnum pos)) (and (< pos 1000000) (funcall next (1+ pos)))))
(defun mk-end () (lambda (pos) (declare (fixnum pos)) pos))
(defvar *m1* (mk-test (mk-end))) (defvar *m3* (mk-test (mk-test (mk-test (mk-end))))) (defvar *m8* (let ((m (mk-end))) (dotimes (i 8 m) (setq m (mk-test m)))))
(defun run-m (m) (declare (function m)) (let ((n 0)) (declare (fixnum n)) (dotimes (i 1000) (incf n (the fixnum (funcall m i)))) n))
(bench "labels self tail call, 1000 iterations" 50000 (setq *sink* (labels-self)))
(bench "labels mutual tail calls, 1000" 50000 (setq *sink* (labels-mutual)))
(bench "closure self tail call via funcall, 1000" 50000 (setq *sink* (closure-self)))
(bench "matcher chain: 1 test closure x1000" 50000 (setq *sink* (run-m *m1*)))
(bench "matcher chain: 3 test closures x1000" 50000 (setq *sink* (run-m *m3*)))
(bench "matcher chain: 8 test closures x1000" 50000 (setq *sink* (run-m *m8*)))
