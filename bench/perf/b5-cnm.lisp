(load "bench/perf/pcommon.lisp")
(setf *bench-group* "5-cnm")
;; Methods of a subclass over a method of its superclass, and the shapes of MAKE-INSTANCE.
;; A: the subclass method returns a constant; B: it reads NEXT-METHOD-P only; C: it calls
;; (CALL-NEXT-METHOD); D: (+ 1 (CALL-NEXT-METHOD)); E: only the superclass method runs.
(defvar *sink* 0)
(defclass pt () ())
(defclass pt3 (pt) ())
(defgeneric h0 (p) (:method ((p pt)) 1))
(defmethod h0 ((p pt3)) 2)
(defgeneric h1 (p) (:method ((p pt)) 1))
(defmethod h1 ((p pt3)) (if (next-method-p) 2 3))
(defgeneric h2 (p) (:method ((p pt)) 1))
(defmethod h2 ((p pt3)) (call-next-method))
(defgeneric h3 (p) (:method ((p pt)) 1))
(defmethod h3 ((p pt3)) (+ 1 (call-next-method)))
(defgeneric hp (p) (:method ((p pt)) 1))
(defun plain (p) (declare (ignore p)) 1)
(declaim (notinline plain))
(defvar *p1* (make-instance 'pt))
(defvar *p3* (make-instance 'pt3))
(defclass mi-plain () ((x :initarg :x :initform 0)))
(defclass mi-after () ((x :initarg :x :initform 0)))
(defmethod initialize-instance :after ((o mi-after) &key &allow-other-keys) nil)
(defclass mi-before () ((x :initarg :x :initform 0)))
(defmethod initialize-instance :before ((o mi-before) &key &allow-other-keys) nil)
(defclass mi-around () ((x :initarg :x :initform 0)))
(defmethod initialize-instance :around ((o mi-around) &key &allow-other-keys) (call-next-method))
(defclass mi-around-apply () ((x :initarg :x :initform 0)))
(defmethod initialize-instance :around ((o mi-around-apply) &rest initargs) (apply #'call-next-method o initargs))
(defclass mi-si-around () ((x :initarg :x :initform 0)))
(defmethod shared-initialize :around ((o mi-si-around) slot-names &rest initargs)
  (apply #'call-next-method o slot-names initargs))
(defmacro callloop (name fn obj)
  `(bench ,name 50000
     (setq *sink* (let ((f ,fn) (o ,obj) (s 0)) (declare (function f) (fixnum s))
                    (dotimes (i 1000) (setq s (logand (+ s (the fixnum (funcall f o))) 1023))) s))))
(callloop "baseline: funcall an ordinary function x1000" #'plain *p3*)
(callloop "A: constant x1000" #'h0 *p3*)
(callloop "B: next-method-p x1000" #'h1 *p3*)
(callloop "C: (call-next-method) x1000" #'h2 *p3*)
(callloop "D: (+ 1 (call-next-method)) x1000" #'h3 *p3*)
(callloop "E: the superclass method alone x1000" #'hp *p1*)
(bench "make-instance plain (1 initarg)" 500000 (setq *sink* (make-instance 'mi-plain :x 1)))
(bench "make-instance with :after" 500000 (setq *sink* (make-instance 'mi-after :x 1)))
(bench "make-instance with :before" 200000 (setq *sink* (make-instance 'mi-before :x 1)))
(bench "make-instance with :around" 100000 (setq *sink* (make-instance 'mi-around :x 1)))
(bench "make-instance with :around, apply" 100000 (setq *sink* (make-instance 'mi-around-apply :x 1)))
(bench "make-instance with shared-initialize :around" 100000 (setq *sink* (make-instance 'mi-si-around :x 1)))
