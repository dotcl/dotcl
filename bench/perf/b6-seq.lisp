(load "bench/perf/pcommon.lisp")
(setf *bench-group* "6-seq")
(defvar *sink* nil)
(defvar *v* (coerce (loop for i below 1000 collect (mod (* i 7919) 1000)) 'simple-vector))
(defvar *s* (make-string 1000 :initial-element #\a))
(bench "subseq vector 100..900" 100000 (setq *sink* (subseq *v* 100 900)))
(bench "subseq vector 0..10" 2000000 (setq *sink* (subseq *v* 0 10)))
(bench "copy-seq vector 1000" 100000 (setq *sink* (copy-seq *v*)))
(bench "subseq string 100..900" 200000 (setq *sink* (subseq *s* 100 900)))
(bench "subseq string 0..5" 2000000 (setq *sink* (subseq *s* 0 5)))
(bench "reverse vector 1000" 100000 (setq *sink* (reverse *v*)))
(bench "concatenate 'vector 2x1000" 50000 (setq *sink* (concatenate 'vector *v* *v*)))
