(load "bench/perf/pcommon.lisp")
(setf *bench-group* "4-ppcre")
(load-ql-system :cl-ppcre)
(defvar *sink* nil)
(defvar *text60k*
  (let ((s (with-output-to-string (o)
             (dotimes (i 2000) (format o "line ~D: the quick brown fox ~D jumps over the lazy dog, foo~D@example.com ~%" i (* i 7) i)))))
    (subseq s 0 60000)))
(format t "text length ~D~%" (length *text60k*))
(cl-user::bench "scan-count \\d+ (60000 chars)" 200 (setq *sink* (let ((n 0)) (cl-ppcre:do-matches (s e "\\d+" *text60k*) (incf n)) n)))
(cl-user::bench "regex-replace-all \\d+ -> # (60000 chars)" 200 (setq *sink* (cl-ppcre:regex-replace-all "\\d+" *text60k* "#")))
(cl-user::bench "regex-replace-all (\\w+)@example -> <\\1>" 100 (setq *sink* (cl-ppcre:regex-replace-all "(\\w+)@example" *text60k* "<\\1>")))
(cl-user::bench "split \\s+ (60000 chars)" 100 (setq *sink* (cl-ppcre:split "\\s+" *text60k*)))
(cl-user::bench "scan quick|lazy|fox (60000 chars)" 200 (setq *sink* (let ((n 0)) (cl-ppcre:do-matches (s e "quick|lazy|fox" *text60k*) (incf n)) n)))
