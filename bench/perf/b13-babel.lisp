(load "bench/perf/pcommon.lisp")
(setf *bench-group* "13-babel")
;; babel and flexi-streams: utf-8 string <-> octets on a 1 MB text (the shape of the report this
;; comes from: about 10 percent of the characters are not ASCII).
;; Libraries to install on the runner: babel flexi-streams  (perf.yml: libs=babel,flexi-streams)
(load-ql-system :babel)
(load-ql-system :flexi-streams)
(defun mk-text (n)
  (let ((s (make-string n)) (pat "The quick brown fox jumps over the lazy dog; "))
    (dotimes (i n s)
      (setf (char s i)
            (cond ((zerop (mod i 10)) (code-char (+ 233 (mod (floor i 10) 5))))
                  ((zerop (mod i 97)) (code-char (+ 12354 (mod i 40))))
                  (t (char pat (mod i (length pat)))))))))
(defvar *text* (mk-text 1000000))
(defvar *octets* (babel:string-to-octets *text* :encoding :utf-8))
(defvar *sink* nil)
(bench "babel string-to-octets utf-8, 1M chars" 20 (setq *sink* (babel:string-to-octets *text* :encoding :utf-8)))
(bench "babel octets-to-string utf-8, 1M chars" 20 (setq *sink* (babel:octets-to-string *octets* :encoding :utf-8)))
(bench "flexi string-to-octets utf-8, 1M chars" 20 (setq *sink* (flexi-streams:string-to-octets *text* :external-format :utf-8)))
(bench "flexi octets-to-string utf-8, 1M chars" 20 (setq *sink* (flexi-streams:octets-to-string *octets* :external-format :utf-8)))
