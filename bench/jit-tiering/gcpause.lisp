(defvar *keep* (make-array 8 :initial-element nil))
(dotimes (i 8)
  (setf (aref *keep* i) (loop repeat 1000000 collect (cons i i))))
(defun ms (a b) (/ (* 1000d0 (- b a)) internal-time-units-per-second))
(let ((t0 (get-internal-real-time)))
  (dotcl:gc)
  (format t "~&FULLGC ~,1F~%" (ms t0 (get-internal-real-time))))
(let ((worst 0d0) (end (+ (get-internal-real-time) (* 4 internal-time-units-per-second))))
  (loop while (< (get-internal-real-time) end)
        do (let ((t0 (get-internal-real-time)))
             (let ((l (loop repeat 20000 collect (make-array 8))))
               (setf (aref *keep* 0) (if (cdr l) (cons l nil) nil)))
             (setf worst (max worst (ms t0 (get-internal-real-time))))))
  (format t "~&MAXSTEP ~,1F~%" worst))
