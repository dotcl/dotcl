;;; cl-docstrings.lisp: docstrings for the COMMON-LISP package
;;;
;;; DOCUMENTATION answers these for the external symbols of COMMON-LISP that
;;; name a function, macro or special operator (doc-type FUNCTION) and for those
;;; that name a variable or constant (doc-type VARIABLE). A docstring set by the
;;; user, or one a definition carries itself, takes precedence.
;;;
;;; The text is written for dotcl: short summaries of what each operator does,
;;; in terms of its lambda list. It is not taken from the ANSI standard or the
;;; HyperSpec.
;;;
;;; This file is data only, and it is the one place the text lives. It sets
;;; *CL-BUILTIN-DOCSTRINGS* (declared in cil-stdlib.lisp); a core built without
;;; this file carries no built-in docstrings and DOCUMENTATION answers NIL for
;;; these symbols, with nothing else changing.
;;;
;;; The table is the literal inside a function of no arguments, so loading the
;;; core only defines that function; the list is built when DOCUMENTATION first
;;; asks for it. Everything in it is a string, so the cross compile keeps it as
;;; one constant rather than code that interns each name.
;;;
;;; Format: (KIND (SYMBOL-NAME DOCSTRING) ...) for KIND "function" and
;;; "variable". The text is plain ASCII with no double quote or backslash.
;;; test/regression/cl-builtin-documentation.lisp checks that every fbound and
;;; every bound external CL symbol has an entry.

(setq *cl-builtin-docstrings* (lambda ()
 '(("function"
   ("*" "Return the product of its arguments, or 1 if called with no arguments.")
   ("+" "Return the sum of its arguments, or 0 if called with no arguments.")
   ("-" "Subtract the remaining arguments from the first, or negate NUMBER if only one argument is given.")
   ("/" "Divide the first argument by the rest in sequence, or return the reciprocal of NUMBER if only one argument is given.")
   ("/=" "Return true if no two of its NUMBER arguments are equal in value.")
   ("1+" "Return NUMBER plus 1.")
   ("1-" "Return NUMBER minus 1.")
   ("<" "Return true if its NUMBER arguments are in strictly increasing order.")
   ("<=" "Return true if its NUMBER arguments are in nondecreasing order.")
   ("=" "Return true if all its NUMBER arguments have the same value.")
   (">" "Return true if its NUMBER arguments are in strictly decreasing order.")
   (">=" "Return true if its NUMBER arguments are in nonincreasing order.")
   ("ABORT" "Invoke the ABORT restart, transferring control out of the current computation. Signals CONTROL-ERROR if no such restart is active.")
   ("ABS" "Return the absolute value of NUMBER.")
   ("ACONS" "Construct a new association list by consing the pair (KEY . DATUM) onto ALIST.")
   ("ACOS" "Return the arc cosine of NUMBER.")
   ("ACOSH" "Return the hyperbolic arc cosine of NUMBER.")
   ("ADD-METHOD" "Add METHOD to GENERIC-FUNCTION, replacing any existing method with the same qualifiers and specializers. Generic function.")
   ("ADJOIN" "Return a list with ITEM prepended to LIST unless an element matching ITEM under :TEST (default EQL) is already present.")
   ("ADJUST-ARRAY" "Change the dimensions, fill pointer, or other properties of ARRAY, possibly returning a new array. May modify ARRAY when it is actually adjustable.")
   ("ADJUSTABLE-ARRAY-P" "Return true if ARRAY was created as an adjustable array.")
   ("ALLOCATE-INSTANCE" "Allocate storage for a new instance of CLASS without initializing its slots. Generic function used by MAKE-INSTANCE.")
   ("ALPHA-CHAR-P" "Return true if CHARACTER is an alphabetic letter.")
   ("ALPHANUMERICP" "Return true if CHARACTER is alphabetic or a digit.")
   ("AND" "Evaluate FORMS left to right, stopping and returning NIL as soon as one evaluates to NIL; otherwise return the value of the last form.")
   ("APPEND" "Return a new list made by concatenating its list arguments; the last argument is not copied and may be any object.")
   ("APPLY" "Call FUNCTION with the given arguments followed by the elements of the final list argument.")
   ("APROPOS" "Print the names of symbols whose print name contains STRING, optionally restricted to PACKAGE.")
   ("APROPOS-LIST" "Return a list of symbols whose print name contains STRING, optionally restricted to PACKAGE.")
   ("AREF" "Return the element of ARRAY at the position given by SUBSCRIPTS. SETF-able.")
   ("ARITHMETIC-ERROR-OPERANDS" "Return the list of operands involved in an ARITHMETIC-ERROR condition.")
   ("ARITHMETIC-ERROR-OPERATION" "Return the operation that signaled an ARITHMETIC-ERROR condition.")
   ("ARRAY-DIMENSION" "Return the size of ARRAY along axis AXIS-NUMBER.")
   ("ARRAY-DIMENSIONS" "Return a list of the dimensions of ARRAY.")
   ("ARRAY-DISPLACEMENT" "Return the array that ARRAY is displaced to, and the offset into it, or NIL and 0 if ARRAY is not displaced.")
   ("ARRAY-ELEMENT-TYPE" "Return the upgraded array element type used to store elements of ARRAY.")
   ("ARRAY-HAS-FILL-POINTER-P" "Return true if ARRAY has a fill pointer.")
   ("ARRAY-IN-BOUNDS-P" "Return true if SUBSCRIPTS are all valid indices into ARRAY.")
   ("ARRAY-RANK" "Return the number of dimensions of ARRAY.")
   ("ARRAY-ROW-MAJOR-INDEX" "Return the row-major index corresponding to SUBSCRIPTS within ARRAY.")
   ("ARRAY-TOTAL-SIZE" "Return the total number of elements in ARRAY, the product of its dimensions.")
   ("ARRAYP" "Return true if OBJECT is an array.")
   ("ASH" "Shift the bits of INTEGER left by COUNT positions, or right if COUNT is negative, as if by multiplying or dividing by a power of two.")
   ("ASIN" "Return the arc sine of NUMBER.")
   ("ASINH" "Return the hyperbolic arc sine of NUMBER.")
   ("ASSERT" "Signal a correctable error unless TEST-FORM evaluates to true, optionally offering to set PLACES and reevaluate. Macro.")
   ("ASSOC" "Search ALIST for the first pair whose CAR matches ITEM under :TEST (or :TEST-NOT), and return that pair.")
   ("ASSOC-IF" "Search ALIST for the first pair whose CAR satisfies PREDICATE, and return that pair.")
   ("ASSOC-IF-NOT" "Search ALIST for the first pair whose CAR fails to satisfy PREDICATE, and return that pair.")
   ("ATAN" "Return the arc tangent of NUMBER, or of NUMBER1/NUMBER2 using their signs to pick the correct quadrant when NUMBER2 is given.")
   ("ATANH" "Return the hyperbolic arc tangent of NUMBER.")
   ("ATOM" "Return true if OBJECT is not a CONS.")
   ("BIT" "Return the bit of BIT-ARRAY at the position given by SUBSCRIPTS. SETF-able.")
   ("BIT-AND" "Return the bitwise AND of BIT-ARRAY1 and BIT-ARRAY2, element by element. May store into OPT-ARG when it names a destination array.")
   ("BIT-ANDC1" "Return the bitwise AND of the complement of BIT-ARRAY1 with BIT-ARRAY2. May store into OPT-ARG when it names a destination array.")
   ("BIT-ANDC2" "Return the bitwise AND of BIT-ARRAY1 with the complement of BIT-ARRAY2. May store into OPT-ARG when it names a destination array.")
   ("BIT-EQV" "Return the bitwise exclusive-nor of BIT-ARRAY1 and BIT-ARRAY2. May store into OPT-ARG when it names a destination array.")
   ("BIT-IOR" "Return the bitwise inclusive OR of BIT-ARRAY1 and BIT-ARRAY2. May store into OPT-ARG when it names a destination array.")
   ("BIT-NAND" "Return the bitwise NAND (negated AND) of BIT-ARRAY1 and BIT-ARRAY2. May store into OPT-ARG when it names a destination array.")
   ("BIT-NOR" "Return the bitwise NOR (negated inclusive OR) of BIT-ARRAY1 and BIT-ARRAY2. May store into OPT-ARG when it names a destination array.")
   ("BIT-NOT" "Return the bitwise complement of BIT-ARRAY. May store into OPT-ARG when it names a destination array.")
   ("BIT-ORC1" "Return the bitwise inclusive OR of the complement of BIT-ARRAY1 with BIT-ARRAY2. May store into OPT-ARG when it names a destination array.")
   ("BIT-ORC2" "Return the bitwise inclusive OR of BIT-ARRAY1 with the complement of BIT-ARRAY2. May store into OPT-ARG when it names a destination array.")
   ("BIT-VECTOR-P" "Return true if OBJECT is a bit vector.")
   ("BIT-XOR" "Return the bitwise exclusive OR of BIT-ARRAY1 and BIT-ARRAY2. May store into OPT-ARG when it names a destination array.")
   ("BLOCK" "Establish a named exit point around BODY; a matching RETURN-FROM transfers control out with a value. Special operator.")
   ("BOOLE" "Combine INTEGER1 and INTEGER2 bit by bit according to the boolean operation named by OP, such as BOOLE-AND or BOOLE-IOR.")
   ("BOTH-CASE-P" "Return true if CHARACTER has both upper and lower case forms.")
   ("BOUNDP" "Return true if SYMBOL currently has a value as a dynamic variable.")
   ("BREAK" "Print a message and enter the debugger, from which execution can be continued.")
   ("BROADCAST-STREAM-STREAMS" "Return the list of streams that BROADCAST-STREAM sends its output to.")
   ("BUTLAST" "Return a copy of LIST with the last N elements (default 1) removed.")
   ("BYTE" "Construct a byte specifier covering SIZE bits starting at POSITION, for use with LDB, DPB, and related functions.")
   ("BYTE-POSITION" "Return the bit position stored in byte specifier BYTESPEC.")
   ("BYTE-SIZE" "Return the bit width stored in byte specifier BYTESPEC.")
   ("CAAAAR" "Return (CAR (CAAAR OBJECT)), i.e. apply CAR four times.")
   ("CAAADR" "Return (CAR (CAADR OBJECT)).")
   ("CAAAR" "Return (CAR (CAAR OBJECT)), i.e. apply CAR three times.")
   ("CAADAR" "Return (CAR (CADAR OBJECT)).")
   ("CAADDR" "Return (CAR (CADDR OBJECT)).")
   ("CAADR" "Return (CAR (CADR OBJECT)).")
   ("CAAR" "Return (CAR (CAR OBJECT)).")
   ("CADAAR" "Return (CAR (CDAAR OBJECT)).")
   ("CADADR" "Return (CAR (CDADR OBJECT)).")
   ("CADAR" "Return (CAR (CDAR OBJECT)).")
   ("CADDAR" "Return (CAR (CDDAR OBJECT)).")
   ("CADDDR" "Return (CAR (CDDDR OBJECT)).")
   ("CADDR" "Return (CAR (CDDR OBJECT)), the third element of a list.")
   ("CADR" "Return (CAR (CDR OBJECT)), the second element of a list.")
   ("CALL-NEXT-METHOD" "Call the next applicable method in the method combination, with the same or given arguments, from within a method body.")
   ("CAR" "Return the first element of CONS, or NIL if CONS is NIL. SETF-able.")
   ("CASE" "Evaluate KEYFORM and execute the clause whose keys are EQL to its value, or the T/OTHERWISE clause if none match. Macro.")
   ("CATCH" "Establish a catch tag equal to TAG and evaluate BODY; a matching THROW transfers control here with its value. Special operator.")
