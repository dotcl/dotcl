   ("CHAR=" "Return true if all CHARACTER arguments are the same character, comparing case exactly.")
   ("CHAR>" "Return true if the CHARACTER arguments are in strictly decreasing order, comparing case exactly.")
   ("CHAR>=" "Return true if the CHARACTER arguments are in nonincreasing order, comparing case exactly.")
   ("CHARACTER" "Coerce CHARACTER-DESIGNATOR (a character, a one-character string, or a symbol with a one-character name) to a character.")
