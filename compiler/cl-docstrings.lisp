   ("CDAAAR" "Return (CDR (CAAAR OBJECT)).")
   ("CDAADR" "Return (CDR (CAADR OBJECT)).")
   ("CDAAR" "Return (CDR (CAAR OBJECT)).")
   ("CDADAR" "Return (CDR (CADAR OBJECT)).")
   ("CDADDR" "Return (CDR (CADDR OBJECT)).")
   ("CDADR" "Return (CDR (CADR OBJECT)).")
   ("CDAR" "Return (CDR (CAR OBJECT)).")
   ("CDDAAR" "Return (CDR (CDAAR OBJECT)).")
   ("CDDADR" "Return (CDR (CDADR OBJECT)).")
   ("CDDAR" "Return (CDR (CDAR OBJECT)).")
   ("CDDDAR" "Return (CDR (CDDAR OBJECT)).")
   ("CDDDDR" "Return (CDR (CDDDR OBJECT)), i.e. apply CDR four times.")
   ("CDDDR" "Return (CDR (CDDR OBJECT)).")
   ("CDDR" "Return (CDR (CDR OBJECT)).")
   ("CDR" "Return the rest of CONS after its first element, or NIL if CONS is NIL. SETF-able.")
   ("CEILING" "Return the quotient of NUMBER (divided by DIVISOR, default 1) rounded toward positive infinity, as the first value, and the remainder as the second.")
   ("CELL-ERROR-NAME" "Return the name of the cell involved in a CELL-ERROR condition, such as an unbound variable or undefined function.")
   ("CERROR" "Signal a correctable error built from DATUM and ARGUMENTS, printing CONTINUE-FORMAT-CONTROL as the associated restart report, and return NIL if continued.")
   ("CHANGE-CLASS" "Change the class of INSTANCE to NEW-CLASS in place, converting its slots. Generic function.")
   ("CHAR" "Return the character at INDEX in STRING. SETF-able.")
