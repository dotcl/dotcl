   ("COMPILER-MACRO-FUNCTION" "Return the compiler macro function associated with FUNCTION-NAME, or NIL if it has none. SETF-able.")
   ("COMPLEMENT" "Return a new function that calls FUNCTION on its arguments and returns the logical negation of the result.")
   ("COMPLEX" "Construct a complex number with the given REALPART and IMAGPART (default 0), simplifying to a real number when IMAGPART is zero and both parts are rational.")
   ("COMPLEXP" "Return true if OBJECT is a complex number.")
   ("COMPUTE-APPLICABLE-METHODS" "Return the list of methods of GENERIC-FUNCTION applicable to ARGUMENTS, in the order the method combination would use them. Generic function.")
   ("COMPUTE-RESTARTS" "Return the list of restarts currently active, optionally filtered to those applicable to CONDITION.")
   ("CONCATENATE" "Build a new sequence of type RESULT-TYPE containing the elements of all the given SEQUENCES in order.")
   ("CONCATENATED-STREAM-STREAMS" "Return the list of streams that CONCATENATED-STREAM reads from in order.")
   ("COND" "Evaluate each CLAUSE's test form in order; for the first true test, evaluate and return the value of its remaining forms. Macro.")
   ("CONJUGATE" "Return the complex conjugate of NUMBER.")
   ("CONS" "Construct a new cons cell whose CAR is OBJECT-1 and whose CDR is OBJECT-2.")
   ("CONSP" "Return true if OBJECT is a cons.")
   ("CONSTANTLY" "Return a new function that ignores its arguments and always returns VALUE.")
   ("CONSTANTP" "Return true if FORM can be determined to always evaluate to the same constant value.")
   ("CONTINUE" "Invoke the CONTINUE restart if one is active, causing computation to proceed past the point where it was signaled.")
   ("COPY-ALIST" "Return a copy of association list ALIST, copying both the list structure and each dotted pair.")
   ("COPY-LIST" "Return a copy of the list structure of LIST; the elements themselves are not copied.")
   ("COPY-PPRINT-DISPATCH" "Return a copy of pprint dispatch table TABLE (or the current one if TABLE is NIL), which may be modified independently.")
