asdf/
quicklisp-client/

## State (regenerated by make bench-state). ansi-state.json is deliberately NOT
## listed: it is tracked and it ships, and an ignore rule would make the mirror
## drop it silently on `git add -A`.
bench-state.json

## Logs
*.log

## temp Scripts
*.sh
# …but committed tooling scripts are kept.
!scripts/ilverify-check.sh
!scripts/fasl-shape-check.sh
!scripts/build-quicklisp.sh
!scripts/contrib-resolve.sh
!ci/d-number.sh
!ci/mirror-scrub-workflows.sh
!bench/make-state.sh
!samples/**/*.sh
!test/*/check.sh

## qlot (dependency management)
qlfile
qlfile.lock
.qlot/

## Local secrets (e.g. NUGET_API_KEY)
.env

## Coordinator logs
**/coordinator.log

## Scratch/temp files
scratch.txt
*.dat
\#*

## ANSI test artifacts (generated at project root)
*.txt
*.fasl
# Ahead-of-time siblings (<name>.fasl.r2r-<rid>, dotcl.core.r2r-<rid>). The
# marker sits after the whole filename so that *.fasl globs do not match one,
# which also means this rule has to name them itself.
*.r2r-*
*.ufsl
*.tmp
test/regression/.tmp-*/
*.sil
# ...except the legacy .sil fixtures: they are checked in precisely because they
# are output, emitted by a released dotcl and never regenerated.
!test/regression/legacy-sil/*.sil
/*.lsp
compile-file-*
COMPILE-FILE-*
load-test-file*
modules[0-9]*
sandbox/

# Non-source artifacts under docs/ (talk media, editor backups)
docs/**/*.mp4
docs/**/*~
out/
runtime/contrib/
contrib/asdf/
contrib/quicklisp/

## Contrib build outputs (regenerated by `make contrib-*`)
contrib/*/bin/
contrib/*/obj/
contrib/*/lib/

## Sample project build outputs
samples/*/bin/
samples/*/obj/

## Source Generator (build artifacts)
runtime.docgen/bin/
runtime.docgen/obj/

