;;; dotcl-jsonrpc.lisp: JSON and the Content-Length framing that the Debug
;;; Adapter Protocol and the Language Server Protocol share.

(defpackage :dotcl-jsonrpc
  (:use :cl)
  (:export #:json-encode #:json-decode #:jget #:read-message #:write-message))

(in-package :dotcl-jsonrpc)

;;; JSON. An object is (:obj "key" value ...), an array a vector, true T,
;;; false :FALSE, null NIL.

(defun %json-write (x out)
  (cond ((null x) (write-string "null" out))
        ((eq x t) (write-string "true" out))
        ((eq x :false) (write-string "false" out))
        ((integerp x) (format out "~D" x))
        ((realp x) (format out "~F" (float x 1d0)))
        ((stringp x) (%json-write-string x out))
        ((symbolp x) (%json-write-string (symbol-name x) out))
        ((and (consp x) (eq (car x) :obj))
         (write-char #\{ out)
         (loop for (k v) on (cdr x) by #'cddr
               for first = t then nil
               unless first do (write-char #\, out)
               do (%json-write-string k out)
                  (write-char #\: out)
                  (%json-write v out))
         (write-char #\} out))
        ((or (vectorp x) (listp x))
         (write-char #\[ out)
         (let ((first t))
           (map nil (lambda (e)
                      (unless first (write-char #\, out))
                      (setf first nil)
                      (%json-write e out))
                x))
         (write-char #\] out))
        (t (%json-write-string (prin1-to-string x) out))))

(defun %json-write-string (s out)
  (write-char #\" out)
  (loop for c across s
        for code = (char-code c)
        do (case c
             (#\" (write-string "\\\"" out))
             (#\\ (write-string "\\\\" out))
             (#\Newline (write-string "\\n" out))
             (#\Return (write-string "\\r" out))
             (#\Tab (write-string "\\t" out))
             (t (if (< code 32)
                    (format out "\\u~4,'0X" code)
                    (write-char c out)))))
  (write-char #\" out))

(defun json-encode (x)
  (with-output-to-string (out) (%json-write x out)))

(defun json-decode (string)
  (let ((pos 0) (len (length string)))
    (labels ((peek () (and (< pos len) (char string pos)))
             (next () (prog1 (char string pos) (incf pos)))
             (ws () (loop while (and (< pos len)
                                     (member (char string pos)
                                             '(#\Space #\Tab #\Newline #\Return)))
                          do (incf pos)))
             (expect (word value)
               (if (and (<= (+ pos (length word)) len)
                        (string= word string :start2 pos :end2 (+ pos (length word))))
                   (progn (incf pos (length word)) value)
                   (error "JSON: unexpected text at ~D" pos)))
             (str ()
               (next)
               (with-output-to-string (out)
                 (loop for c = (next)
                       until (char= c #\")
                       do (if (char= c #\\)
                              (let ((e (next)))
                                (case e
                                  (#\n (write-char #\Newline out))
                                  (#\r (write-char #\Return out))
                                  (#\t (write-char #\Tab out))
                                  (#\b (write-char #\Backspace out))
                                  (#\f (write-char #\Page out))
                                  (#\u (write-char
                                        (code-char (parse-integer string :start pos
                                                                         :end (+ pos 4)
                                                                         :radix 16))
                                        out)
                                   (incf pos 4))
                                  (t (write-char e out))))
                              (write-char c out)))))
             (num ()
               (let ((start pos))
                 (loop while (and (< pos len)
                                  (find (char string pos) "+-0123456789.eE"))
                       do (incf pos))
                 (let ((text (subseq string start pos)))
                   (if (find-if (lambda (c) (find c ".eE")) text)
                       (let ((*read-default-float-format* 'double-float)
                             (*read-eval* nil))
                         (read-from-string text))
                       (parse-integer text)))))
             (val ()
               (ws)
               (let ((c (peek)))
                 (case c
                   (#\{ (next)
                    (let ((pairs '()))
                      (ws)
                      (if (eql (peek) #\})
                          (next)
                          (loop (ws)
                                (let ((k (str)))
                                  (ws) (next)
                                  (let ((v (val)))
                                    (push k pairs) (push v pairs)))
                                (ws)
                                (when (char= (next) #\}) (return))))
                      (cons :obj (nreverse pairs))))
                   (#\[ (next)
                    (let ((items '()))
                      (ws)
                      (if (eql (peek) #\])
                          (next)
                          (loop (push (val) items)
                                (ws)
                                (when (char= (next) #\]) (return))))
                      (coerce (nreverse items) 'vector)))
                   (#\" (str))
                   (#\t (expect "true" t))
                   (#\f (expect "false" :false))
                   (#\n (expect "null" nil))
                   (t (num))))))
      (val))))

(defun jget (obj key &optional default)
  (loop for (k v) on (cdr obj) by #'cddr
        when (string= k key) do (return v)
        finally (return default)))

;;; Framing: a Content-Length header, a blank line, then that many bytes of
;;; UTF-8 JSON.

(defun read-message (stream)
  "The next message on the binary STREAM, decoded, or NIL at end of input."
  (let ((length nil))
    (loop
      (let ((line (with-output-to-string (out)
                    (loop for b = (read-byte stream nil nil)
                          do (cond ((null b) (return-from read-message nil))
                                   ((= b 10) (return))
                                   ((/= b 13) (write-char (code-char b) out)))))))
        (when (zerop (length line)) (return))
        (let ((colon (position #\: line)))
          (when (and colon (string-equal "Content-Length" (subseq line 0 colon)))
            (setf length (parse-integer line :start (1+ colon)))))))
    (unless length (error "a message without Content-Length"))
    (let ((bytes (make-array length :element-type '(unsigned-byte 8))))
      (when (< (read-sequence bytes stream) length)
        (return-from read-message nil))
      (json-decode (dotcl:octets-to-string bytes :external-format :utf-8)))))

(defun write-message (stream message)
  (let* ((body (dotcl:string-to-octets (json-encode message) :external-format :utf-8))
         (header (dotcl:string-to-octets
                  (format nil "Content-Length: ~D~C~C~C~C"
                          (length body) #\Return #\Newline #\Return #\Newline)
                  :external-format :utf-8)))
    (write-sequence header stream)
    (write-sequence body stream)
    (finish-output stream)))

(provide "dotcl-jsonrpc")
